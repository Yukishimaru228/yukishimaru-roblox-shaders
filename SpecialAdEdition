    SkinState.SaveCurrentSkin=function(name)
        local clean=SkinTrim(name)
        if clean=="" then return false,"Введите название." end
        SkinSyncItemStateFromUI()
        local entry=AvatarCurrent(clean)
        SkinStatus("Сохраняю снимок аватара...", Color3.fromRGB(200,200,210))
        local snapshotOk=SkinAttachSnapshot(entry)
        if not snapshotOk then
            SkinStatus("Не удалось получить снимок аватара — скин сохранён без него (будет загружаться по нику).", Color3.fromRGB(255,190,150))
        end
        local replacedIndex=nil
        local oldAutoName=SkinState.AutoLoadSkinName or ""

        for index,old in ipairs(SkinState.SavedSkins or {}) do
            if tostring(old.Name):lower()==clean:lower() then
                replacedIndex=index
                break
            end
        end

        if replacedIndex then
            local oldEntry=SkinState.SavedSkins[replacedIndex]
            entry.__File=oldEntry.__File or AvatarEntryFile(entry)
            SkinState.SavedSkins[replacedIndex]=entry
        else
            SkinState.SavedSkins[#SkinState.SavedSkins+1]=entry
        end

        if oldAutoName~="" and string.lower(SkinTrim(oldAutoName))==string.lower(clean) then
            SkinState.AutoLoadSkinName=clean
        end

        local entryOk=AvatarSaveEntry(entry)
        local indexOk=entryOk and AvatarSaveIndex()
        local legacyOk=indexOk and AvatarWriteJSON(SkinState.SavedSkinsFile,{
            Version=7,
            Skins=SkinState.SavedSkins or {},
            AutoLoadSkinName=SkinState.AutoLoadSkinName or "",
            RecentUsernames=SkinState.RecentUsernames or {},
        })
        AvatarRefresh()
        if not (entryOk and indexOk and legacyOk) then
            return false,"Не удалось записать JSON сохранённого скина в executor."
        end
        return true
    end

    SkinState.ApplySavedSkin=function(entry)
        if type(entry)~="table" then return false end
        local username=SkinTrim(entry.Username or "")
        local requestedUserId=tonumber(entry.UserId) or nil

        -- Older saves could contain the local player's UserId beside a typed
        -- but unapplied target username. If the two fields disagree, trust the
        -- username and resolve it again instead of silently applying the wrong avatar.
        if not entry.Snapshot and requestedUserId and username~="" then
            local okStoredName, storedName = pcall(function()
                return Players:GetNameFromUserIdAsync(requestedUserId)
            end)
            if okStoredName and type(storedName)=="string"
                and string.lower(SkinTrim(storedName)) ~= string.lower(username)
            then
                requestedUserId=nil
            end
        end

        SkinState.TargetUsername=username
        SkinState.TargetUserId=requestedUserId
        if type(entry.Snapshot)=="table" then
            -- Frozen appearance: never re-download the nickname's current avatar.
            SkinState.ActiveSnapshot=entry.Snapshot
            requestedUserId=requestedUserId or tonumber(entry.Snapshot.UserId) or tonumber(LocalPlayer.UserId)
            SkinState.TargetUserId=requestedUserId
        else
            SkinState.ActiveSnapshot=nil
        end
        SkinState.Headless=entry.Headless==true
        SkinState.Korblox=entry.Korblox==true
        SkinState.DeleteHair=entry.DeleteHair==true
        SkinState.DeleteArmsFP=entry.DeleteArmsFP==true
        SkinState.DeleteAccessories=entry.DeleteAccessories==true
        SkinState.DeleteAllAccessories=entry.DeleteAllAccessories==true
        SkinState.SkinColorName=tostring(entry.SkinColorName or "Default")
        SkinState.ActiveItemIds={}
        for index=1,30 do
            local id=tostring(entry.ItemIds and entry.ItemIds[index] or "")
            SkinState.ItemIds[index]=id
            if id~="" then SkinState.ActiveItemIds[index]=id end
            if SkinState.ItemInputs[index] then SkinState.ItemInputs[index].Text=id end
        end
        -- V21: the nickname is NOT written back into the input field.
        SkinState.RefreshModifierButton(SkinState.HeadlessButton,SkinState.Headless,"Headless")
        SkinState.RefreshModifierButton(SkinState.KorbloxButton,SkinState.Korblox,"Korblox")
        SkinState.RefreshModifierButton(SkinState.DeleteHairButton,SkinState.DeleteHair,"Delete hair")
        SkinState.RefreshModifierButton(SkinState.DeleteArmsFPButton,SkinState.DeleteArmsFP,"Delete arms in First Person")
        SkinState.RefreshModifierButton(SkinState.DeleteAccessoriesButton,SkinState.DeleteAccessories,"Delete accessories")
        SkinState.RefreshModifierButton(SkinState.DeleteAllAccessoriesButton,SkinState.DeleteAllAccessories,"Delete all accessories")
        if SkinState.SkinColorButton then SkinState.SkinColorButton.Text=SkinState.SkinColorName end
        SkinSyncItemStateFromUI()

        SkinState.ApplyToken+=1
        local token=SkinState.ApplyToken
        SkinClearEvadeDirect()
        task.spawn(function()
            local userId=requestedUserId
            if not userId and username~="" then
                local okUser,resolved=pcall(function() return Players:GetUserIdFromNameAsync(username) end)
                if okUser then userId=tonumber(resolved) end
            end
            if token~=SkinState.ApplyToken then return end
            if not userId then
                SkinStatus("Сохранённый скин: не найден UserId для "..username,Color3.fromRGB(255,170,170))
                return
            end
            SkinState.TargetUserId=userId

            local okBuild,err=false,"Персонаж ещё не готов."
            for attempt=1,4 do
                if token~=SkinState.ApplyToken then return end
                local liveCharacter=LocalPlayer.Character
                local ready=liveCharacter
                    and liveCharacter:FindFirstChildOfClass("Humanoid")
                    and liveCharacter:FindFirstChild("HumanoidRootPart")
                if ready then
                    okBuild,err=SkinBuildProxy(userId,token)
                    if okBuild then break end
                    if not tostring(err):find("Персонаж ещё не готов",1,true)
                        and not tostring(err):find("Не найден визуальный humanoid/root риг",1,true)
                    then
                        break
                    end
                end
                task.wait(0.45)
            end

            if token~=SkinState.ApplyToken then return end
            if okBuild then
                if username=="" then
                    local okName,resolvedName=pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
                    if okName and type(resolvedName)=="string" then username=resolvedName end
                end
                SkinState.TargetUsername=username

                -- Saved skins can be selected while the game is still finishing its
                -- own avatar/accessory setup. Re-apply the exact same local visual mask
                -- used by Skin Changer after the proxy is active, so late original
                -- cosmetics do not appear over the saved appearance. Game equipment
                -- is still filtered by SkinShouldHideVisualObject/SkinIsGameEquipmentObject.
                task.spawn(function()
                    for _, delayTime in ipairs({0.05, 0.18, 0.42, 0.8, 1.25, 1.6, 2.2, 3.0}) do
                        task.wait(delayTime)
                        if token ~= SkinState.ApplyToken then return end
                        if not SkinState.ProxyCharacter or not SkinState.ProxyCharacter.Parent then return end
                        pcall(function()
                            SkinReapplyActiveSkinMask(token)
                        end)
                    end
                end)

                if type(entry.Snapshot)~="table" then
                    -- Old save without a snapshot: freeze what was just built.
                    local last=SkinState.LastDescriptionSnapshot
                    if last and tonumber(last.UserId)==tonumber(userId) then
                        entry.Snapshot=last
                        pcall(function() AvatarSaveEntry(entry); AvatarSave() end)
                    end
                end
                SkinStatus("Сохранённый скин применён: "..tostring(entry.Name or "Скин"),Color3.fromRGB(180,230,190))
            else
