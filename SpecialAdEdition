        ----------------------------------------------------------------
        -- DRIVING PHYSICS (runs before every physics step)
        ----------------------------------------------------------------
        local function carStep(dt)
            local car = Car
            if not car then
                return
            end
            local root = car.Root
            if not root or not root.Parent then
                return
            end
            dt = math.min(dt, 0.05)
            local cfg = car.Cfg
            local flying = cfg.flying == true

            -- Keep the driver seated, ghosted and unable to jump out
            if car.Occupied then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    exitCar()
                else
                    hum.Sit = true
                    hum.Jump = false
                    for _, part in ipairs(car.CharParts) do
                        if part.Parent then
                            part.CanCollide = false
                        end
                    end
                end
            end

            local throttle, steer = 0, 0
            local hold, down = false, false
            if car.Occupied then
                throttle, steer = readInput()
                hold = car.Hold
                down = car.Down
                    or ((not UserInputService:GetFocusedTextBox())
                        and (UserInputService:IsKeyDown(Enum.KeyCode.C) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)))
            end

            local pos = root.Position
            local vel = root.AssemblyLinearVelocity

            -- Ground probe
            local rayLen = flying and 400 or (car.RootToBottom + 1.6)
            local hit = Workspace:Raycast(pos, Vector3.new(0, -rayLen, 0), car.Ray)
            local grounded = (not flying) and hit ~= nil
            local canDrive = grounded or flying

            local fwdOld = Vector3.new(-math.sin(car.Yaw), 0, -math.cos(car.Yaw))
            local flat = Vector3.new(vel.X, 0, vel.Z)
            local fOld = flat:Dot(fwdOld)

            local drifting = canDrive and hold and (not flying) and math.abs(fOld) > 18

            -- Steering
            local speedAbs = math.abs(fOld)
            local authority = math.clamp(speedAbs / 16, 0, 1)
            if flying then
                authority = math.max(authority, 0.5)
            end
            local damp = 1 - math.clamp(speedAbs / cfg.maxSpeed, 0, 1) * 0.45
            local turnMul = drifting and (cfg.driftTurn or 1.5) or 1
            local dirSign = fOld >= 0 and 1 or -1
            local airFactor = canDrive and 1 or 0.25
            car.Yaw -= steer * cfg.turn * authority * damp * turnMul * dirSign * dt * airFactor

            local fwd = Vector3.new(-math.sin(car.Yaw), 0, -math.cos(car.Yaw))
            local right = Vector3.new(-fwd.Z, 0, fwd.X)
            local fSpeed = flat:Dot(fwd)
            local sSpeed = flat:Dot(right)

            if canDrive then
                local maxS = cfg.maxSpeed

                if throttle > 0.05 then
                    local a
                    if fSpeed < 0 then
                        a = cfg.brake
                    else
                        a = cfg.accel * (1 - math.clamp(fSpeed / maxS, 0, 1) ^ 2)
                    end
                    fSpeed += a * throttle * dt
                elseif throttle < -0.05 then
                    local a
                    if fSpeed > 0 then
                        a = cfg.brake
                    else
                        a = cfg.accel * 0.6 * (1 - math.clamp(-fSpeed / (maxS * 0.35), 0, 1) ^ 2)
                    end
                    fSpeed -= a * math.abs(throttle) * dt
                else
                    local drag = cfg.drag * dt
                    if math.abs(fSpeed) <= drag then
                        fSpeed = 0
                    else
                        fSpeed -= math.sign(fSpeed) * drag
                    end
                end

                if hold and not flying then
                    if speedAbs <= 18 then
                        fSpeed *= math.exp(-3 * dt)
                    else
                        fSpeed *= (1 - 0.22 * dt)
                    end
                end

                local grip = drifting and cfg.driftGrip or cfg.grip
                if not car.Occupied then
                    grip = cfg.grip + 2
                    fSpeed *= math.exp(-1.5 * dt)
                end
                sSpeed *= math.exp(-grip * dt)

                local newFlat = fwd * fSpeed + right * sSpeed
                local vy = vel.Y

                if flying then
                    local climb = 0
                    if car.Occupied then
                        if hold then
                            climb += 1
                        end
                        if down then
                            climb -= 1
                        end
                    end
                    local targetVy = climb * cfg.climb
                    vy = vel.Y + (targetVy - vel.Y) * math.clamp(dt * 3.5, 0, 1)
                    if hit then
                        local minY = hit.Position.Y + car.RootToBottom + 1.5
                        if pos.Y < minY and vy < (minY - pos.Y) * 6 then
                            vy = (minY - pos.Y) * 6
                        end
                    end
                elseif grounded then
                    local n = hit.Normal
                    if n.Y > 0.5 then
                        local err = (hit.Position.Y + car.RootToBottom + 0.05) - pos.Y
                        local slopeVy = -(n.X * newFlat.X + n.Z * newFlat.Z) / n.Y
                        vy = slopeVy + math.clamp(err * 10, -25, 25)
                    end
                end

                root.AssemblyLinearVelocity = Vector3.new(newFlat.X, vy, newFlat.Z)
            end

            -- Orientation: follow the ground, lean a little in turns
            local targetUp = Vector3.yAxis
            if grounded and hit.Normal.Y > 0.6 then
                targetUp = hit.Normal
            end
            car.Up = car.Up:Lerp(targetUp, math.clamp(dt * (grounded and 9 or 2), 0, 1))
            if car.Up.Magnitude < 0.1 then
                car.Up = Vector3.yAxis
            end
            car.Up = car.Up.Unit
            local up = car.Up
            local rv = fwd:Cross(up)
            if rv.Magnitude < 1e-3 then
                rv = right
            end
            rv = rv.Unit
            local fv = up:Cross(rv)

            local speed = math.sqrt(fSpeed * fSpeed + sSpeed * sSpeed)
            local speedFrac = math.clamp(speed / cfg.maxSpeed, 0, 1)
            local roll = steer * speedFrac * 0.08 * (drifting and 1.6 or 1)
            car.Align.CFrame = CFrame.fromMatrix(Vector3.zero, rv, up, -fv) * CFrame.Angles(0, 0, roll)
            car.Speed = speed

            -- Smoke: while rolling, much thicker while sliding
            if #car.Emitters > 0 then
                local driftAmt = math.clamp((math.abs(sSpeed) - 5) / 18, 0, 1)
                if drifting then
                    driftAmt = math.max(driftAmt, 0.5)
                end
                local k = 0
                if grounded and speed > 5 then
                    k = math.clamp(speedFrac * 0.55 + driftAmt * 1.35, 0.15, 2)
                end
                for _, item in ipairs(car.Emitters) do
                    if k > 0 then
                        item.E.Rate = item.Base * k
                        if not item.E.Enabled then
                            item.E.Enabled = true
                        end
                    elseif item.E.Enabled then
                        item.E.Enabled = false
                    end
                end
            end

            -- HUD
            if car.Occupied and Hud and Hud.Speed then
                Hud.Speed.Text = tostring(math.floor(speed * 1.2))
            end

            -- Safety net against falling out of the world
            car.SafeT += dt
            if (grounded or flying) and car.SafeT > 1 then
                car.SafeT = 0
                car.LastSafe = pos
            end
            if pos.Y < Workspace.FallenPartsDestroyHeight + 40 then
                root.AssemblyLinearVelocity = Vector3.zero
                local safe = car.LastSafe + Vector3.new(0, 4, 0)
                car.Model:PivotTo(CFrame.lookAt(safe, safe + fwd))
            end
        end

