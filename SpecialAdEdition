        -- Visible-part bounding box of a model, expressed in `frame` space.
        local function measure(model, frame, visibleOnly)
            local minV = Vector3.new(math.huge, math.huge, math.huge)
            local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
            local any = false
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") and ((not visibleOnly) or p.Transparency < 0.95) then
                    any = true
                    local half = p.Size * 0.5
                    for ix = -1, 1, 2 do
                        for iy = -1, 1, 2 do
                            for iz = -1, 1, 2 do
                                local world = p.CFrame:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz))
                                local localPoint = frame:PointToObjectSpace(world)
                                minV = minV:Min(localPoint)
                                maxV = maxV:Max(localPoint)
                            end
                        end
                    end
                end
            end
            if not any then
                if visibleOnly then
                    return measure(model, frame, false)
                end
                return Vector3.new(-3, -1.5, -7), Vector3.new(3, 1.5, 7)
            end
            return minV, maxV
        end

        -- Removes everything that could fight our own driving code.
        local function sanitize(model)
            local list = model:GetDescendants()
            local seat = nil
            for _, d in ipairs(list) do
                if d:IsA("VehicleSeat") then
                    seat = d
                    break
                end
            end
            if not seat then
                for _, d in ipairs(list) do
                    if d:IsA("Seat") then
                        seat = d
                        break
                    end
                end
            end

            for _, d in ipairs(list) do
                if d:IsA("LuaSourceContainer")
                    or d:IsA("BodyMover")
                    or d:IsA("Constraint")
                    or d:IsA("JointInstance")
                    or d:IsA("WeldConstraint")
                    or d:IsA("NoCollisionConstraint")
                    or d:IsA("Sound") then
                    pcall(function()
                        d:Destroy()
                    end)
                elseif d:IsA("BasePart") then
                    d.Anchored = false
                    d.CanCollide = false
                    d.CanTouch = false
                    d.CanQuery = false
                    d.Massless = true
                    if d:IsA("Seat") or d:IsA("VehicleSeat") then
                        d.Disabled = true
                    end
                end
            end

            if seat then
                seat:SetAttribute("YukiSeat", true)
            end
            return seat
        end

        local function getTemplate(cfg)
            local existing = Templates[cfg.id]
            if existing then
                return existing
            end
            if Loading[cfg.id] then
                while Loading[cfg.id] and Alive do
                    task.wait(0.1)
                end
                return Templates[cfg.id]
            end

            Loading[cfg.id] = true
            local okT, result = pcall(function()
                local objs = loadAsset(cfg.id)
                if not objs then
                    return nil
                end

                local model
                if #objs == 1 and objs[1]:IsA("Model") then
                    model = objs[1]
                else
                    model = Instance.new("Model")
                    for _, o in ipairs(objs) do
                        o.Parent = model
                    end
                end

                local seat = sanitize(model)

                local fwd
                if seat then
                    fwd = seat.CFrame.LookVector
                else
                    fwd = model:GetPivot().LookVector
                end
                fwd = Vector3.new(fwd.X, 0, fwd.Z)
                if fwd.Magnitude < 0.1 then
                    fwd = Vector3.new(0, 0, -1)
                end
                fwd = fwd.Unit

                -- Normalise the size so every car feels similar to drive
                local pivotPos = model:GetPivot().Position
                local frame = CFrame.lookAt(pivotPos, pivotPos + fwd)
                local mn, mx = measure(model, frame, true)
                local sz = mx - mn
                local longest = math.max(sz.X, sz.Z)
                if longest > 0.5 then
                    local scale = math.clamp(cfg.length / longest, 0.05, 20)
                    pcall(function()
                        model:ScaleTo(scale)
                    end)
                end

                return {Model = model, Forward = fwd}
            end)
            Loading[cfg.id] = nil

            if okT and result then
                Templates[cfg.id] = result
            elseif not okT then
                warn("[Yuki Cars] Load error: " .. tostring(result))
            end
            return Templates[cfg.id]
        end

