local function ApplyMenuTheme(themeName)
    local theme = MENU_THEMES[themeName]
    if not theme then
        return
    end

    selectedMenuTheme = themeName
    for key, value in pairs(theme.palette) do
        C[key] = value
    end

    local backgroundRoles = { "bgTop", "bgBottom", "panel", "card", "cardHover", "inner", "accent", "accentDim", "off" }
    local textRoles = { "text", "sub", "accent", "off" }
    local strokeRoles = { "line", "accent", "accentDim", "sub" }

    for _, record in ipairs(themeBaseline) do
        local object = record.object
        if object and object.Parent then
            pcall(function()
                if record.BackgroundColor3 and object:IsA("GuiObject")
                    and object ~= windowWallpaper and object ~= wallpaperTint
                    and not object:GetAttribute("KeepThemeColor") then
                    object.BackgroundColor3 = remapNeutralColor(record.BackgroundColor3, theme.palette, backgroundRoles)
                end
                if record.TextColor3 and (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
                    object.TextColor3 = remapNeutralColor(record.TextColor3, theme.palette, textRoles)
                end
                if record.StrokeColor and object:IsA("UIStroke") then
                    object.Color = remapNeutralColor(record.StrokeColor, theme.palette, strokeRoles)
                end
                if record.GradientColor and object:IsA("UIGradient") then
                    local mapped = {}
                    for _, point in ipairs(record.GradientColor.Keypoints) do
                        table.insert(mapped, ColorSequenceKeypoint.new(
                            point.Time,
                            remapNeutralColor(point.Value, theme.palette, backgroundRoles)
                        ))
                    end
                    object.Color = ColorSequence.new(mapped)
                end
            end)
        end
    end

    windowBackground.BackgroundColor3 = theme.palette.bgBottom
    local backgroundGradient = windowBackground:FindFirstChildOfClass("UIGradient")
    if backgroundGradient then
