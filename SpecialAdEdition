local function colorDistance(a, b)
    local dr = a.R - b.R
    local dg = a.G - b.G
    local db = a.B - b.B
    return dr * dr + dg * dg + db * db
end

local function closestThemeRole(color, themePalette, roles)
    local bestRole, bestDistance = nil, math.huge
    for _, role in ipairs(roles) do
        local baseColor = MENU_THEME_BASE[role]
        if baseColor then
            local distance = colorDistance(color, baseColor)
            if distance < bestDistance then
                bestDistance = distance
                bestRole = role
            end
        end
    end
    return bestRole and themePalette[bestRole] or color
end

local function remapNeutralColor(color, themePalette, roles)
    local _, saturation = color:ToHSV()
    -- Не перекрашиваем цветные статусы, индикаторы эффектов и пользовательские иконки.
    if saturation > 0.22 then
        return color
    end
    return closestThemeRole(color, themePalette, roles)
end

