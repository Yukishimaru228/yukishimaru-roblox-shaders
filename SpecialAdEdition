    local function updateSizeFromX(x)
        local width = math.max(CursorState.SizeTrack.AbsoluteSize.X, 1)
        local normalized = math.clamp(
            (x - CursorState.SizeTrack.AbsolutePosition.X) / width,
            0,
            1
        )
        local value =
            CursorState.SizeMin
            + normalized * (CursorState.SizeMax - CursorState.SizeMin)

        setCursorSize(value)
    end

