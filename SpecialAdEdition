    label.Parent =
        row

    local valueLabel =
        Instance.new("TextLabel")

    valueLabel.AnchorPoint =
        Vector2.new(
            1,
            0
        )

    valueLabel.Position =
        UDim2.new(
            1,
            -13,
            0,
