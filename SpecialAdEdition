        local function petFollow()
            if Pet.Conn then
                Pet.Conn:Disconnect()
            end

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.IgnoreWater = true

            Pet.Conn = RunService.Heartbeat:Connect(function(dt)
                local model = Pet.Model
                local humanoid = Pet.Humanoid
                local modelRoot = Pet.Root
                if not model or not model.Parent or not humanoid
                    or humanoid.Health <= 0 or not modelRoot or not modelRoot.Parent then
                    return
                end

                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local playerHumanoid = char:FindFirstChildOfClass("Humanoid")
                if not hrp or not playerHumanoid then return end

                -- Match the player's live speed every Heartbeat. This deliberately
                -- follows game-side speed buffs/debuffs instead of a fixed constant.
                local livePlayerSpeed = math.max(0, playerHumanoid.WalkSpeed)
                humanoid.WalkSpeed = livePlayerSpeed
                local velocity = hrp.AssemblyLinearVelocity
                local flatVel = Vector3.new(velocity.X, 0, velocity.Z)

                if flatVel.Magnitude > 2 then
                    local targetLookDir = flatVel.Unit
                    if not Pet.Look then
                        Pet.Look = targetLookDir
                    else
                        local blended = Pet.Look:Lerp(targetLookDir, math.clamp(dt * 4, 0, 1))
                        if blended.Magnitude > 0.01 then Pet.Look = blended.Unit end
                    end
                end

                if not Pet.Look then
                    local look = hrp.CFrame.LookVector
                    local flatLook = Vector3.new(look.X, 0, look.Z)
                    Pet.Look = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
                end

                local targetPos = hrp.Position - (Pet.Look * FOLLOW_DISTANCE)
                local distanceToPlayer = (modelRoot.Position - hrp.Position).Magnitude

                -- Sustained player airtime: switch to a smooth physical flight controller.
                local playerState = playerHumanoid:GetState()
                local playerAirborne = playerHumanoid.FloorMaterial == Enum.Material.Air
                    or playerState == Enum.HumanoidStateType.Flying
                    or playerState == Enum.HumanoidStateType.Freefall

                -- Recovery teleport is grounded-only; never use it to follow a flying player.
                if distanceToPlayer > 100 and not playerAirborne then
                    model:PivotTo(CFrame.new(targetPos))
                    if Pet.FlightVelocity then Pet.FlightVelocity.Enabled = false end
                    Pet.Flying = false
                    Pet.AirTime = 0
                    return
                end
                if playerAirborne then
                    Pet.AirTime += dt
                else
                    Pet.AirTime = 0
                end

                local shouldFly = Pet.AirTime >= 0.7
                if shouldFly and Pet.FlightVelocity then
                    if not Pet.Flying then
                        Pet.Flying = true
                        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                    end

                    Pet.FlightVelocity.Enabled = true
                    modelRoot.CanCollide = false
                    local airTarget = targetPos + Vector3.new(0, 0.8, 0)
                    local delta = airTarget - modelRoot.Position
                    local desiredVelocity = velocity * 0.55 + delta * 2.0
                    if desiredVelocity.Magnitude > 38 then
                        desiredVelocity = desiredVelocity.Unit * 38
                    end
                    Pet.FlightVelocity.VectorVelocity = desiredVelocity
                else
                    if Pet.Flying then
                        Pet.Flying = false
                        if Pet.FlightVelocity then
                            Pet.FlightVelocity.Enabled = false
                            Pet.FlightVelocity.VectorVelocity = Vector3.zero
                        end
                        modelRoot.CanCollide = true
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end

                    -- Detect a climbable ledge in front of the pet. Jump only when
                    -- the wall has a reachable top and there is headroom above it.
                    Pet.JumpCooldown = math.max(0, Pet.JumpCooldown - dt)
                    local moveDelta = targetPos - modelRoot.Position
                    local moveFlat = Vector3.new(moveDelta.X, 0, moveDelta.Z)
                    if moveFlat.Magnitude > 0.5 and Pet.JumpCooldown <= 0
                        and humanoid.FloorMaterial ~= Enum.Material.Air then
                        rayParams.FilterDescendantsInstances = {model, char}
                        local direction = moveFlat.Unit
                        local chestOrigin = modelRoot.Position + Vector3.new(0, 0.65, 0)
                        local wallHit = Workspace:Raycast(chestOrigin, direction * 2.4, rayParams)

                        if wallHit and wallHit.Instance and wallHit.Instance.CanCollide
                            and math.abs(wallHit.Normal.Y) < 0.45 then
                            local headOrigin = modelRoot.Position + Vector3.new(0, 2.4, 0)
                            local headHit = Workspace:Raycast(headOrigin, direction * 2.4, rayParams)
                            local topOrigin = wallHit.Position + direction * 0.8 + Vector3.new(0, 4.8, 0)
                            local topHit = Workspace:Raycast(topOrigin, Vector3.new(0, -6.2, 0), rayParams)

                            if not headHit and topHit and topHit.Normal.Y > 0.55 then
                                local ledgeHeight = topHit.Position.Y - modelRoot.Position.Y
                                if ledgeHeight >= 0.35 and ledgeHeight <= 4.2 then
                                    humanoid.Jump = true
                                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                                    Pet.JumpCooldown = 0.85
                                end
                            end
                        end
                    end

                    humanoid:MoveTo(targetPos)
                end

                -- Run/idle animation state follows actual pet movement in both modes.
                local modelVelocity = modelRoot.AssemblyLinearVelocity
                local modelSpeed = modelVelocity.Magnitude
                if Pet.Run and Pet.Idle then
                    if not Pet.Moving and modelSpeed > 3 then
                        Pet.Moving = true
                        if Pet.Idle.IsPlaying then Pet.Idle:Stop(0.15) end
                        Pet.Run:Play(0.15, 1, 1)
                    elseif Pet.Moving and modelSpeed < 0.5 then
                        Pet.Moving = false
                        if Pet.Run.IsPlaying then Pet.Run:Stop(0.15) end
                        Pet.Idle:Play(0.15, 1, 1)
                    end
                    if Pet.Moving and Pet.Run.IsPlaying and modelSpeed > 0.5 then
                        Pet.Run:AdjustSpeed(math.clamp(modelSpeed / 16, 0.8, 2.2))
                    end
                end
            end)
        end

        local function petSpawn(data)
            Pet.Token += 1
            local token = Pet.Token
            petClear()
            Pet.Selected = data
            setPetStatus("Loading " .. data.name .. "...")

            task.spawn(function()
                local newModel = nil
                local okLoad, errLoad = pcall(function()
                    local bundleDetails = AssetService:GetBundleDetailsAsync(data.id)
                    local outfitId = nil
                    for _, item in pairs(bundleDetails.Items) do
                        if item.Type == "UserOutfit" and not string.match(item.Name, "Head") then
                            outfitId = item.Id
                            break
                        end
                    end
                    if not outfitId then
                        error("Outfit not found")
                    end
                    local description = Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
                    newModel = Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
                end)

                -- A newer click (or Dismiss / Exit) happened while loading
                if token ~= Pet.Token or not Alive then
                    if newModel then
                        pcall(function()
                            newModel:Destroy()
                        end)
                    end
                    return
                end

                if not okLoad or not newModel then
                    warn("[Yuki Pets] Load error: " .. tostring(errLoad))
                    setPetStatus("Could not load " .. data.name)
                    return
                end

                newModel.Name = "FollowerBody"
                newModel.Parent = Workspace
                pcall(function()
                    newModel:ScaleTo(SCALE_SIZE)
                end)

                local humanoid = newModel:FindFirstChildOfClass("Humanoid")
                if not humanoid then
                    newModel:Destroy()
                    setPetStatus("Could not load " .. data.name)
                    return
                end

                humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                humanoid.UseJumpPower = true
                humanoid.JumpPower = 44
                humanoid.AutoRotate = true
                -- Initial value; petFollow continuously synchronizes it to the
                -- current player Humanoid.WalkSpeed while the pet is active.
                local ownerCharacter = LocalPlayer.Character
                local ownerHumanoid = ownerCharacter and ownerCharacter:FindFirstChildOfClass("Humanoid")
                humanoid.WalkSpeed = ownerHumanoid and ownerHumanoid.WalkSpeed or WALK_SPEED

                local petRoot = newModel:FindFirstChild("HumanoidRootPart") or newModel.PrimaryPart
                for _, part in ipairs(newModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        -- The root collides so walls stop the pet; decorative limbs stay non-collidable.
                        part.CanCollide = (part == petRoot)
                        part.CanTouch = false
                        part.CanQuery = (part == petRoot)
                        part.Massless = (part ~= petRoot)
                    end
                end

                if not petRoot then
                    newModel:Destroy()
                    setPetStatus("Could not load " .. data.name .. " (no root part)")
                    return
                end

                local flightAttachment = Instance.new("Attachment")
                flightAttachment.Name = "YukiPetFlightAttachment"
                flightAttachment.Parent = petRoot

                local flightVelocity = Instance.new("LinearVelocity")
                flightVelocity.Name = "YukiPetFlightVelocity"
                flightVelocity.Attachment0 = flightAttachment
                flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
                flightVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
                flightVelocity.VectorVelocity = Vector3.zero
                flightVelocity.MaxForce = math.max(10000, petRoot.AssemblyMass * Workspace.Gravity * 8)
                flightVelocity.Enabled = false
                flightVelocity.Parent = petRoot

                local oldAnimate = newModel:FindFirstChild("Animate")
                if oldAnimate then
                    oldAnimate:Destroy()
                end

                local animator = humanoid:FindFirstChildOfClass("Animator")
                if not animator then
                    animator = Instance.new("Animator")
                    animator.Parent = humanoid
                end

                local runAnim = Instance.new("Animation")
                runAnim.AnimationId = ANIM_RUN
                local runTrack = animator:LoadAnimation(runAnim)
                runTrack.Looped = true
                runTrack.Priority = Enum.AnimationPriority.Movement

                local idleAnim = Instance.new("Animation")
                idleAnim.AnimationId = ANIM_IDLE
                local idleTrack = animator:LoadAnimation(idleAnim)
                idleTrack.Looped = true
                idleTrack.Priority = Enum.AnimationPriority.Idle

                Pet.Model = newModel
                Pet.Humanoid = humanoid
                Pet.Root = petRoot
                Pet.FlightAttachment = flightAttachment
                Pet.FlightVelocity = flightVelocity
                Pet.Flying = false
                Pet.AirTime = 0
                Pet.JumpCooldown = 0
                Pet.Run = runTrack
                Pet.Idle = idleTrack
                Pet.Moving = false
                Pet.Look = nil
                idleTrack:Play(0.2, 1, 1)

                petFollow()
                setPetStatus("Current pet: " .. data.name)
            end)
        end

