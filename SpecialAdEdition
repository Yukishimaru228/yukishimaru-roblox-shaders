            dot.BackgroundTransparency = 0.3
            dot.BorderSizePixel = 0
            dot.ZIndex = 9
            dot.Parent = BubbleLayer
            AddCorner(dot, 99)
            local a = RNG:NextNumber(0, math.pi * 2)
            local dist = RNG:NextNumber(120, 340)
            Tween(dot, {
                Position = UDim2.fromOffset(cx + math.cos(a) * dist, cy + math.sin(a) * dist * 0.7),
                BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 2),
            }, RNG:NextNumber(0.6, 1.1), Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            task.delay(1.2, function() dot:Destroy() end)
        end
    end

    -- nav buttons pop in one after another whenever the window appears
    local function navPop()
        local i = 0
        for _, btn in pairs(NavButtons) do
            local sc = btn:FindFirstChild("YukiFxScale")
            if sc then
                i += 1
                sc.Scale = 0
                task.delay(0.05 * i, function()
                    Tween(sc, {Scale = 1}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end)
            end
        end
    end
    Connect(Main:GetPropertyChangedSignal("Visible"), function()
        if Main.Visible then task.delay(0.1, navPop) end
    end)

    -- drag spring: smooth follow + tilt by speed + "picked up" scale
    local tilt, lastDragging = 0, false
    Connect(RunService.RenderStepped, function(dt)
        if not Alive then return end
        if Dragging ~= lastDragging then
            lastDragging = Dragging
            if _G.YukiMainScale and not Collapsed then
                Tween(_G.YukiMainScale, {Scale = Dragging and 1.02 or 1}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
        end
        local target = _G.YukiDragTarget
        if target and Main.Visible then
            local cur = Main.Position
            local k = 1 - math.exp(-16 * dt)
            local nx = cur.X.Offset + (target.X.Offset - cur.X.Offset) * k
            local ny = cur.Y.Offset + (target.Y.Offset - cur.Y.Offset) * k
            Main.Position = UDim2.new(target.X.Scale, nx, target.Y.Scale, ny)
            local vel = (nx - cur.X.Offset) / math.max(dt, 1 / 240)
            tilt = tilt + (math.clamp(vel * 0.0045, -6, 6) - tilt) * (1 - math.exp(-10 * dt))
            Main.Rotation = tilt
            if not Dragging and math.abs(target.X.Offset - nx) < 0.3 and math.abs(target.Y.Offset - ny) < 0.3 then
                Main.Position = target
                _G.YukiDragTarget = nil
            end
        elseif tilt ~= 0 then
            tilt = tilt * (1 - math.exp(-12 * dt))
            if math.abs(tilt) < 0.02 then
                tilt = 0
            end
            Main.Rotation = tilt
        end
    end)

    -- the header logo breathes and sways gently
    Connect(RunService.RenderStepped, function()
        if not Alive or not Main.Visible then return end
        local t = os.clock()
        HeaderImage.Position = UDim2.fromOffset(0, 49 + math.sin(t * 1.3) * 2.2)
        HeaderImage.Rotation = math.sin(t * 0.8) * 2.5
    end)
end

