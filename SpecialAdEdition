    Cars = _G.YukiPetsCars and _G.YukiPetsCars.CarsPage or nil
}

if CursorsPage then
    Pages.Cursors = CursorsPage
end

function _Yuki_FlipDir(a, b)
    local order = {Home = 1, Presets = 2, Settings = 3, Effects = 4, Avatar = 5, Skinchanger = 6, Pets = 7, Cars = 8, Cursors = 9}
    local ia, ib = order[a] or 0, order[b] or 0
    return ib >= ia and 1 or -1
end

local function SwitchPage(
    pageName
)
    local page =
        Pages[pageName]

    if not page then
        return
    end

    local previousPage = Pages[CurrentPage]
    local changed = CurrentPage ~= pageName
    local flipDir = _Yuki_FlipDir(CurrentPage, pageName)
    CurrentPage = pageName
    pcall(function()
        if _G.YukiPetsCars and _G.YukiPetsCars.RevealNav then
            _G.YukiPetsCars.RevealNav(pageName)
        end
    end)

    -- Active navigation pill: white/gray selected state, dark inactive state.
    for name, navButton in pairs(NavButtons) do
        if Pages[name] then
            local active = name == pageName
            Tween(
                navButton,
                {
                    BackgroundColor3 = active and Color3.fromRGB(58, 58, 64) or Color3.fromRGB(28, 28, 32),
                    BackgroundTransparency = active and 0.03 or 0.08
                },
                0.24,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.Out
            )
            local navStroke = navButton:FindFirstChildOfClass("UIStroke")
            if navStroke then
                Tween(
                    navStroke,
                    {
                        Transparency = active and 0.18 or 0.70,
                        Thickness = active and 1.35 or 1
                    },
                    0.24,
                    Enum.EasingStyle.Quint,
                    Enum.EasingDirection.Out
                )
            end
            local holder = navButton:FindFirstChild("IconHolder")
            if holder and holder:IsA("Frame") then
                Tween(
                    holder,
                    {
                        BackgroundColor3 = active and Color3.fromRGB(86, 86, 94) or Color3.fromRGB(44, 44, 49),
                        BackgroundTransparency = active and 0 or 0.04
                    },
                    0.24,
                    Enum.EasingStyle.Quint,
                    Enum.EasingDirection.Out
                )
            end
        end
    end

    if not changed then
        return
    end

    if previousPage and previousPage ~= page and previousPage.Visible then
        previousPage.Position = UDim2.fromOffset(0, 0)
        Tween(
            previousPage,
            {
                Position = UDim2.fromOffset(-34 * flipDir, 0)
            },
            0.16,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.In
        )
    end

    -- One UIScale per page gives a subtle, premium depth effect without blur.
    local pageScale = page:FindFirstChild("YukiPageScale")
    if not pageScale then
        pageScale = Instance.new("UIScale")
        pageScale.Name = "YukiPageScale"
        pageScale.Scale = 1
        pageScale.Parent = page
    end

    page.Visible = true
    page.Position = UDim2.fromOffset(46 * flipDir, 0)
    pageScale.Scale = 0.955
    pcall(_Yuki_PageFlipFx, flipDir)

    task.delay(0.08, function()
        if not Alive or CurrentPage ~= pageName then
            return
        end
        for name, pageObject in pairs(Pages) do
            if pageObject ~= page and pageObject.Visible then
                pageObject.Visible = false
                pageObject.Position = UDim2.fromOffset(0, 0)
            end
        end
    end)

    Tween(
        page,
        {
            Position = UDim2.fromOffset(0, 0)
        },
        0.52,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )
    Tween(
        pageScale,
        {
            Scale = 1
        },
        0.42,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    )
end

