        local stroke = button:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Transparency = enabled and 0.22 or 0.91
            stroke.Thickness = enabled and 1.15 or 1
        end

        local track = button:FindFirstChild("YukiToggleTrack")
        local knob = track and track:FindFirstChild("YukiToggleKnob")
        if track and knob then
            Tween(track, {
                BackgroundColor3 = enabled and CONFIG.Purple or Color3.fromRGB(255,255,255),
                BackgroundTransparency = 0.02
            }, 0.18, Enum.EasingStyle.Sine)
            Tween(knob, {
                Position = enabled and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2)
            }, 0.22, Enum.EasingStyle.Back)
        end
    end

