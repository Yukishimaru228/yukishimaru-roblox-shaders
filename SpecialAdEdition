    local dotPos = {{-6, -6}, {6, -6}, {-6, 6}, {6, 6}}
    for i = 1, 4 do
        local d = nt(Instance.new("Frame"))
        d.AnchorPoint = Vector2.new(0.5, 0.5)
        d.Position = UDim2.new(0.5, dotPos[i][1], 0.5, dotPos[i][2])
        d.Size = UDim2.fromOffset(9, 9)
        d.BackgroundColor3 = dotColors[i]
        d.BorderSizePixel = 0
        d.ZIndex = 42
        d.Parent = themeButton
        AddCorner(d, 99)
