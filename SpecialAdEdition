    function SkinGetBodyPartTargetName(info, loaded)
        local assetTypeId = info and tonumber(info.AssetTypeId) or nil
        local mapped = assetTypeId and BODY_ASSET_PROPERTY_MAP[assetTypeId] or nil
        if mapped then return mapped end
        local names = {Head=true,Torso=true,["Left Arm"]=true,["Right Arm"]=true,["Left Leg"]=true,["Right Leg"]=true,UpperTorso=true,LowerTorso=true,LeftUpperArm=true,LeftLowerArm=true,LeftHand=true,RightUpperArm=true,RightLowerArm=true,RightHand=true,LeftUpperLeg=true,LeftLowerLeg=true,LeftFoot=true,RightUpperLeg=true,RightLowerLeg=true,RightFoot=true}
        if loaded then
            for _, object in ipairs(loaded:GetDescendants()) do
                if object:IsA("BasePart") and names[object.Name] then return object.Name end
            end
        end
        return nil
    end

    function SkinAttachRawAccessory(proxy, humanoid, accessory, assetTypeId)
        if not accessory or not accessory:IsA("Accessory") then return false end
        local ok = pcall(function()
            local inferred = assetTypeId and SkinGetAccessoryTypeForAsset(assetTypeId) or Enum.AccessoryType.Unknown
            if inferred ~= Enum.AccessoryType.Unknown then
                pcall(function() accessory.AccessoryType = inferred end)
            end
            accessory.Name = "YukiItemAccessory_"..tostring(#SkinState.ItemLoadedObjects + 1)
            accessory.Parent = proxy
            humanoid:AddAccessory(accessory)

            -- Verify that an AccessoryWeld was produced. Roblox's normal
            -- attachment path is preferred; a direct weld is only used when
            -- the imported asset has an attachment but AddAccessory could not
            -- build its weld in this game's custom proxy.
            local handle = accessory:FindFirstChild("Handle")
            if handle then
                local hasWeld = handle:FindFirstChild("AccessoryWeld") or handle:FindFirstChildWhichIsA("WeldConstraint")
                if not hasWeld then
                    local sourceAttachment = nil
                    local targetAttachment = nil

                    for _, child in ipairs(handle:GetDescendants()) do
                        if child:IsA("Attachment") then
                            sourceAttachment = child
                            break
                        end
                    end

                    if sourceAttachment then
                        for _, object in ipairs(proxy:GetDescendants()) do
                            if object:IsA("Attachment")
                                and object.Name == sourceAttachment.Name
                                and object.Parent ~= handle
                                and not object:IsDescendantOf(accessory)
                                and object.Parent
                                and object.Parent:IsA("BasePart")
                            then
                                targetAttachment = object
                                break
                            end
                        end
                    end

                    if sourceAttachment and targetAttachment then
                        -- Align the accessory's attachment with the avatar's
                        -- matching attachment, then lock the handle to that
                        -- body part. This is only a fallback for assets for
                        -- which Humanoid:AddAccessory produced no weld.
                        local targetWorld = targetAttachment.Parent.CFrame * targetAttachment.CFrame
                        handle.CFrame = targetWorld * sourceAttachment.CFrame:Inverse()

                        local weld = Instance.new("WeldConstraint")
                        weld.Name = "YukiRawAccessoryWeld"
                        weld.Part0 = handle
                        weld.Part1 = targetAttachment.Parent
                        weld.Parent = handle
                    end
                end
            end
        end)
        if ok then table.insert(SkinState.ItemLoadedObjects, accessory) end
        return ok
    end

    function SkinCreateBodyOverlay(proxy, info, loaded)
        local targetName = SkinGetBodyPartTargetName(info, loaded)
        if not targetName then return false end
        local target = proxy:FindFirstChild(targetName, true)
        if not target or not target:IsA("BasePart") then return false end
        local sourcePart = loaded:IsA("BasePart") and loaded or loaded:FindFirstChildWhichIsA("BasePart", true)
        if not sourcePart then return false end
        local overlay = sourcePart:Clone()
        overlay.Name = "YukiItemOverlay"
        overlay.Anchored = true
        overlay.CanCollide = false
        overlay.CanTouch = false
        overlay.CanQuery = false
        overlay.Massless = true
        overlay.CastShadow = false
        overlay.CFrame = target.CFrame
        overlay.Parent = proxy
        target.Transparency = 1
        target.LocalTransparencyModifier = 1
        table.insert(SkinState.ItemOverlays, {Overlay=overlay, Target=target})
        table.insert(SkinState.ItemLoadedObjects, overlay)
        return true
    end

    function SkinApplyRawCustomItems(proxy, humanoid, fallbackIds)
        local loadedCount, failCount = 0, 0
        for _, assetId in ipairs(fallbackIds or {}) do
            local okObjects, objects = false, nil
            for attempt = 1, 2 do
                okObjects, objects = pcall(function() return game:GetObjects("rbxassetid://"..tostring(assetId)) end)
                if okObjects and type(objects) == "table" and #objects > 0 then break end
                if attempt < 2 then task.wait(0.12) end
            end
            if not okObjects or type(objects) ~= "table" or #objects == 0 then
                failCount += 1
                continue
            end
            local info = SkinGetItemInfo(assetId)
            for _, raw in ipairs(objects) do
                if raw and raw.Parent == nil then
                    local used = false
                    if raw:IsA("Accessory") then
                        used = SkinAttachRawAccessory(proxy, humanoid, raw, info and info.AssetTypeId)
                    else
                        local nestedAccessory = raw:FindFirstChildWhichIsA("Accessory", true)
                        if nestedAccessory then used = SkinAttachRawAccessory(proxy, humanoid, nestedAccessory, info and info.AssetTypeId) end
                    end
                    if not used and (raw:IsA("BasePart") or raw:IsA("Model")) then
                        used = SkinCreateBodyOverlay(proxy, info, raw)
                    end
                    if not used then
                        local cls = {
                            raw:IsA("Shirt") and raw or raw:FindFirstChildWhichIsA("Shirt", true),
                            raw:IsA("Pants") and raw or raw:FindFirstChildWhichIsA("Pants", true),
                            raw:IsA("BodyColors") and raw or raw:FindFirstChildWhichIsA("BodyColors", true),
                            raw:IsA("CharacterMesh") and raw or raw:FindFirstChildWhichIsA("CharacterMesh", true),
                        }
                        for _, obj in ipairs(cls) do
                            if obj then obj.Parent = proxy; table.insert(SkinState.ItemLoadedObjects, obj); used = true; break end
                        end
                    end
                    if used then loadedCount += 1 else SkinSafeDestroy(raw) end
                end
            end
        end
        return loadedCount, failCount
    end

