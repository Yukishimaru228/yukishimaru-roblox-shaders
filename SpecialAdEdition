    --========================================================
    -- AVATAR SAVE / LOAD / MIGRATION
    --========================================================

    function AvatarCanIO()
        return type(writefile)=="function" and type(readfile)=="function" and type(isfile)=="function"
    end

    -- Shared string normalizer. It must be declared before startup persistence runs.
    function SkinTrim(value)
        return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
    end

    function AvatarNormalize(raw, fallbackName)
        if type(raw)~="table" then return nil end
        local username=raw.Username or raw.TargetUsername or raw.SkinchangerUsername or raw.Player or raw.UserName
        local userId=raw.UserId or raw.TargetUserId or raw.PlayerUserId
        local source=raw.ItemIds or raw.Items or raw.AssetIds or raw.AssetIDs or raw.Codes or raw.ItemCodes or raw.Accessories
        local ids={}
        if type(source)=="table" then
            for _,value in pairs(source) do
                local n=tonumber(tostring(value):match("%d+"))
                if n and n>0 then ids[#ids+1]=tostring(math.floor(n)) end
            end
        elseif type(source)=="string" then
            for value in source:gmatch("%d+") do ids[#ids+1]=tostring(math.floor(tonumber(value))) end
        elseif type(source)=="number" then ids[#ids+1]=tostring(math.floor(source)) end
        local avatarFields=username~=nil or userId~=nil or #ids>0 or raw.Headless~=nil or raw.Korblox~=nil or raw.DeleteHair~=nil or raw.DeleteAccessories~=nil or raw.DeleteAllAccessories~=nil or raw.SkinColorName~=nil or raw.SkinColor~=nil
        if not avatarFields then return nil end
        local name=tostring(raw.Name or raw.DisplayName or raw.PresetName or fallbackName or "Скин")
        return {
            Name=name~="" and name or "Скин",
            Username=tostring(username or ""),
            UserId=tonumber(userId) or nil,
            ItemIds=ids,
            Headless=raw.Headless==true,
            Korblox=raw.Korblox==true,
            DeleteHair=raw.DeleteHair==true,
            DeleteArmsFP=raw.DeleteArmsFP==true,
            DeleteAccessories=raw.DeleteAccessories==true,
            DeleteAllAccessories=raw.DeleteAllAccessories==true,
            SkinColorName=tostring(raw.SkinColorName or raw.SkinColor or "Default"),
            Snapshot=type(raw.Snapshot)=="table" and raw.Snapshot or nil,
        }
    end

    function AvatarCollect(raw,out,seen,fallbackName)
        if type(raw)~="table" then return end
        seen=seen or {}
        if seen[raw] then return end
        seen[raw]=true
        local direct=AvatarNormalize(raw,fallbackName)
        if direct then out[#out+1]=direct return end
        for key,value in pairs(raw) do
            if type(value)=="table" then AvatarCollect(value,out,seen,(type(key)=="string" and key~="") and key or fallbackName) end
        end
    end

    function AvatarRead(fileName)
        if not AvatarCanIO() or not isfile(fileName) then return nil end
        local ok,text=pcall(readfile,fileName)
        if not ok or type(text)~="string" or text=="" then return nil end
        local ok2,data=pcall(function() return HttpService:JSONDecode(text) end)
        return ok2 and data or nil
    end

    function AvatarEnsureFolder()
        if type(makefolder) ~= "function" then return false end
        local folder=tostring(SkinState.SavedSkinsFolder or "YukiShader_AvatarSaves")
        pcall(function() makefolder(folder) end)
        return true
    end

    function AvatarSafeFilename(name)
        local clean=SkinTrim(name):gsub("[^%w%-%._]+","_")
        clean=clean:gsub("_+","_"):gsub("^[_%.]+",""):gsub("[_%.]+$","")
        if clean=="" then clean="skin" end
        return clean:sub(1,80)
    end

    function AvatarEntryFile(entry)
        if type(entry)~="table" then return nil end
        local base=tostring(entry.Name or "Скин")
        local username=SkinTrim(entry.Username or "")
        if username~="" then base=base.."_"..username end
        return "YukiShaderAvatar_"..AvatarSafeFilename(base)..".json"
    end

    function AvatarEntryFolderFile(entry)
        if type(entry)~="table" then return nil end
        local rootFile=AvatarEntryFile(entry)
        if not rootFile then return nil end
        return tostring(SkinState.SavedSkinsFolder or "YukiShader_AvatarSaves").."/"..rootFile
    end

    function AvatarWriteJSON(fileName,payload)
        if not AvatarCanIO() or type(writefile)~="function" then return false end
        local okEncode,encoded=pcall(function() return HttpService:JSONEncode(payload) end)
        if not okEncode or type(encoded)~="string" then return false end
        local okWrite=pcall(function() writefile(fileName,encoded) end)
        if not okWrite then return false end
        local okVerify,same=pcall(function()
            return isfile(fileName) and tostring(readfile(fileName))==encoded
        end)
        return okVerify and same==true
    end

    function AvatarReadJSON(fileName)
        if not AvatarCanIO() or not isfile(fileName) then return nil end
        local ok,raw=pcall(readfile,fileName)
        if not ok or type(raw)~="string" or raw=="" then return nil end
        local ok2,data=pcall(function() return HttpService:JSONDecode(raw) end)
        return ok2 and data or nil
    end

    function AvatarSaveEntry(entry)
        if type(entry)~="table" or not AvatarEnsureFolder() then return false end
        local fileName=entry.__File or AvatarEntryFile(entry)
        local folderFile=AvatarEntryFolderFile(entry)
        local payload={
            Version=8,
            Name=tostring(entry.Name or "Скин"),
            Username=tostring(entry.Username or ""),
            UserId=tonumber(entry.UserId) or nil,
            Snapshot=entry.Snapshot,
            ItemIds=entry.ItemIds or {},
            Headless=entry.Headless==true,
            Korblox=entry.Korblox==true,
            DeleteHair=entry.DeleteHair==true,
            DeleteArmsFP=entry.DeleteArmsFP==true,
            DeleteAccessories=entry.DeleteAccessories==true,
            DeleteAllAccessories=entry.DeleteAllAccessories==true,
            SkinColorName=tostring(entry.SkinColorName or "Default"),
        }
        local rootOk=AvatarWriteJSON(fileName,payload)
        local folderOk=true
        if folderFile and folderFile~=fileName then
            folderOk=AvatarWriteJSON(folderFile,payload)
        end
        if rootOk and folderOk then
            entry.__File=fileName
            return true
        end
        return false
    end

    function AvatarSaveIndex()
        if not AvatarCanIO() then return false end
        local metas={}
        for _,entry in ipairs(SkinState.SavedSkins or {}) do
            metas[#metas+1]={
                Name=tostring(entry.Name or "Скин"),
                Username=tostring(entry.Username or ""),
                UserId=tonumber(entry.UserId) or nil,
                File=entry.__File or AvatarEntryFile(entry),
                FolderFile=AvatarEntryFolderFile(entry),
            }
        end
        return AvatarWriteJSON(SkinState.SavedSkinsIndexFile,{
            Version=7,
            Folder=SkinState.SavedSkinsFolder,
            AutoLoadSkinName=SkinState.AutoLoadSkinName or "",
            Skins=metas,
            RecentUsernames=SkinState.RecentUsernames or {},
        })
    end

    function AvatarSaveAll()
        if not AvatarCanIO() then return false end
        AvatarEnsureFolder()
        local ok=true
        for _,entry in ipairs(SkinState.SavedSkins or {}) do
            if not AvatarSaveEntry(entry) then ok=false end
        end
        if not AvatarSaveIndex() then ok=false end
        if not AvatarWriteJSON(SkinState.SavedSkinsFile,{
            Version=7,
            Skins=SkinState.SavedSkins or {},
            AutoLoadSkinName=SkinState.AutoLoadSkinName or "",
            RecentUsernames=SkinState.RecentUsernames or {},
        }) then ok=false end
        return ok
    end

    function AvatarSave()
        return AvatarSaveAll()
    end

    function AvatarFiles()
        local names={
            "YukiShaderAvatarSkinsV3.json","YukiShaderAvatarSkins.json","YukiShaderSavedSkins.json","YukiShaderSavedAvatars.json","YukiShaderAvatarPresets.json","YukiShaderSavedAvatarsV2.json","YukiShaderAvatarSaves.json","YukiShader_SavedSkins.json","YukiShader_Skins.json",
            "YukiAvatarSkins.json","YukiAvatarPresets.json","YukiSavedSkins.json","YukiSkinPresets.json","YukiShaderSkins.json","YukiShaderCustomPresets.json","YukiShaderPresets.json","YukiAvatarSave.json","YukiSkinSaves.json",
            SkinState.SavedSkinsIndexFile,
        }
        local lf=type(listfiles)=="function" and listfiles or nil
        if lf then
            local ok,files=pcall(lf)
            if ok and type(files)=="table" then
                for _,path in ipairs(files) do
                    local pth=tostring(path); local l=pth:lower()
                    if (l:find("yuki",1,true) or l:find("avatar",1,true) or l:find("skin",1,true)) and l:match("%.json$") then
                        local n=pth:match("([^/\\]+)$")
                        if n then names[#names+1]=n end
                    end
                end
            end
        end
        return names
    end

    function AvatarMerge(imported)
        local seen={}
        for _,e in ipairs(SkinState.SavedSkins or {}) do seen[(tostring(e.Name).."|"..tostring(e.Username).."|"..table.concat(e.ItemIds or {},",")):lower()]=true end
        for _,e in ipairs(imported or {}) do
            local k=(tostring(e.Name).."|"..tostring(e.Username).."|"..table.concat(e.ItemIds or {},",")):lower()
            if not seen[k] then SkinState.SavedSkins[#SkinState.SavedSkins+1]=e; seen[k]=true end
        end
    end

    -- Keep the normalizer declared before AvatarLoad() is ever executed.
    -- The previous order left this local nil during the first load pass.
    function RecentNormalizeList(list)
        local out, seen = {}, {}
        if type(list) ~= "table" then return out end
        for _, value in ipairs(list) do
            local name = SkinTrim(value)
            if name ~= "" then
                local key = string.lower(name)
                if not seen[key] then
                    seen[key] = true
                    table.insert(out, name)
                    if #out >= (SkinState.RecentUsernamesMax or 15) then break end
                end
            end
        end
        return out
    end

    function AvatarLoad()
        SkinState.SavedSkins={}
        SkinState.AutoLoadSkinName=""
        SkinState.RecentUsernames={}
        local imported,loadedFiles={},{}

        local indexData=AvatarReadJSON(SkinState.SavedSkinsIndexFile)
        if type(indexData)=="table" then
            SkinState.AutoLoadSkinName=SkinTrim(indexData.AutoLoadSkinName or "")
            if type(indexData.RecentUsernames)=="table" then
                SkinState.RecentUsernames=RecentNormalizeList(indexData.RecentUsernames)
            end
            if type(indexData.Skins)=="table" then
                for _,meta in ipairs(indexData.Skins) do
                    if type(meta)=="table" and (type(meta.File)=="string" or type(meta.FolderFile)=="string") then
                        local fileName=type(meta.File)=="string" and meta.File or meta.FolderFile
                        local raw=AvatarReadJSON(fileName)
                        if type(raw)=="table" then
                            raw.Name=raw.Name or meta.Name
                            raw.Username=raw.Username or meta.Username
                            raw.UserId=raw.UserId or meta.UserId
                            local normalized=AvatarNormalize(raw,meta.Name or "Скин")
                            if normalized then
                                normalized.__File=fileName
                                imported[#imported+1]=normalized
                                loadedFiles[fileName]=true
                            end
                        end
                    end
                end
            end
        end

        if type(listfiles)=="function" then
            local ok,files=pcall(listfiles)
            if ok and type(files)=="table" then
                local prefix=tostring(SkinState.SavedSkinsFolder or "YukiShader_AvatarSaves").."/"
                for _,path in ipairs(files) do
                    local pth=tostring(path)
                    local isRootSaved=pth:sub(1,#"YukiShaderAvatar_")=="YukiShaderAvatar_" and pth:lower():match("%.json$")
                    local isFolderSaved=pth:sub(1,#prefix)==prefix and pth:lower():match("%.json$")
                    if (isRootSaved or isFolderSaved) and not loadedFiles[pth] and pth~=SkinState.SavedSkinsIndexFile then
                        local raw=AvatarReadJSON(pth)
                        if type(raw)=="table" then
                            local normalized=AvatarNormalize(raw,pth:gsub("%.json$",""):gsub("^.*[/\\]", ""))
                            if normalized then
                                normalized.__File=pth
                                imported[#imported+1]=normalized
                            end
                        end
                    end
                end
            end
        end

        local legacy=AvatarRead(SkinState.SavedSkinsFile)
        if type(legacy)=="table" then
            if SkinState.AutoLoadSkinName=="" then
                SkinState.AutoLoadSkinName=SkinTrim(legacy.AutoLoadSkinName or legacy.AutoLoad or "")
            end
            if type(legacy.RecentUsernames)=="table" and #SkinState.RecentUsernames==0 then
                SkinState.RecentUsernames=RecentNormalizeList(legacy.RecentUsernames)
            end
            AvatarCollect(legacy.Skins or legacy,imported,{},"Скин")
        end

        AvatarMerge(imported)
        for _,entry in ipairs(SkinState.SavedSkins or {}) do AvatarSaveEntry(entry) end
        AvatarSaveIndex()
    end

    function RecentSave()
        if not AvatarCanIO() then return false end
        local payload = {
            Version = 3,
            Usernames = RecentNormalizeList(SkinState.RecentUsernames or {}),
        }
        local ok = pcall(function()
            writefile(SkinState.RecentUsernamesFile, HttpService:JSONEncode(payload))
        end)
        if not ok then return false end
        local verifyOk, verify = pcall(function()
            if not isfile(SkinState.RecentUsernamesFile) then return false end
            local saved = readfile(SkinState.RecentUsernamesFile)
            return type(saved) == "string" and saved ~= ""
        end)
        return verifyOk and verify == true
    end

    function RecentLoad()
        SkinState.RecentUsernames = {}
        if not AvatarCanIO() or not isfile(SkinState.RecentUsernamesFile) then return end
        local data = AvatarRead(SkinState.RecentUsernamesFile)
        if type(data) == "table" then
            SkinState.RecentUsernames = RecentNormalizeList(
                data.Usernames or data.Names or data
            )
        end
    end

    function RecentRemember(username)
        local name = SkinTrim(username)
        if name == "" then return false end
        local key = string.lower(name)
        local out = {name}
        for _, old in ipairs(SkinState.RecentUsernames or {}) do
            local oldName = SkinTrim(old)
            if oldName ~= "" and string.lower(oldName) ~= key then
                table.insert(out, oldName)
            end
            if #out >= (SkinState.RecentUsernamesMax or 15) then break end
        end
        SkinState.RecentUsernames = out
        local recentOk = RecentSave()
        local avatarOk = AvatarSave()
        if SkinState.RefreshRecentUsers then SkinState.RefreshRecentUsers() end
        return recentOk and avatarOk
    end

    function RecentRemove(username)
        local key = string.lower(SkinTrim(username))
        local out = {}
        for _, old in ipairs(SkinState.RecentUsernames or {}) do
            if string.lower(SkinTrim(old)) ~= key then table.insert(out, old) end
        end
        SkinState.RecentUsernames = RecentNormalizeList(out)
        RecentSave()
        AvatarSave()
        if SkinState.RefreshRecentUsers then SkinState.RefreshRecentUsers() end
    end

    function FindSavedSkinByName(name)
        local key = string.lower(SkinTrim(name))
        if key == "" then return nil end
        for _, entry in ipairs(SkinState.SavedSkins or {}) do
            if string.lower(SkinTrim(entry.Name)) == key then return entry end
        end
        return nil
    end

    function SetAutoLoadSkin(name)
        local clean = SkinTrim(name)
        if clean == "" then
            SkinState.AutoLoadSkinName = ""
        else
            local entry = FindSavedSkinByName(clean)
            if not entry then
                SkinStatus("Не удалось включить автозагрузку: сохранённый скин не найден.", Color3.fromRGB(255,170,170))
                return false
            end
            SkinState.AutoLoadSkinName = tostring(entry.Name)
        end

        local persisted = AvatarSave()
        if SkinState.RefreshSavedSkins then SkinState.RefreshSavedSkins() end
        if SkinState.AutoLoadSkinName == "" then
            SkinStatus(persisted and "Автозагрузка отключена." or "Автозагрузка отключена до перезапуска; не удалось записать файл.", persisted and Color3.fromRGB(180,230,190) or Color3.fromRGB(255,190,150))
        else
            SkinStatus(persisted and ("Автозагрузка включена: "..SkinState.AutoLoadSkinName) or ("Автозагрузка включена в этой сессии, но файл не записан: "..SkinState.AutoLoadSkinName), persisted and Color3.fromRGB(180,230,190) or Color3.fromRGB(255,190,150))
        end
        return persisted
    end

    -- Snapshot the current avatar without depending on SkinCollectItemIds(),
    -- which is declared later in the file. The visible code boxes are canonical.
    function AvatarCurrent(name)
        SkinSyncItemStateFromUI()
        local ids={}
        for index=1,30 do
            local value=SkinTrim(SkinState.ItemIds[index] or "")
            if value~="" then
                local n=tonumber(value:match("%d+"))
                if n and n>0 then ids[#ids+1]=tostring(math.floor(n)) end
            end
        end

        local targetId = tonumber(SkinState.TargetUserId)
        local targetName = SkinTrim(SkinState.TargetUsername)
        local typedName = SkinTrim(SkinState.Input and SkinState.Input.Text or "")
        local savedUsername
        local savedUserId

        if targetId then
            -- The active target has already been resolved and applied.
            savedUserId = targetId
            savedUsername = targetName ~= "" and targetName or typedName
        elseif typedName ~= "" and string.lower(typedName) ~= string.lower(LocalPlayer.Name) then
            -- A not-yet-applied username must be resolved on load; do not pair
            -- it with LocalPlayer.UserId, which would silently load the wrong avatar.
            savedUsername = typedName
            savedUserId = nil
        else
            savedUsername = targetName ~= "" and targetName or LocalPlayer.Name
            savedUserId = tonumber(LocalPlayer.UserId)
        end

        if savedUsername == "" then savedUsername = LocalPlayer.Name end
        return {
            Name=name,
            Username=savedUsername,
            UserId=savedUserId,
            ItemIds=ids,
            Headless=SkinState.Headless==true,
            Korblox=SkinState.Korblox==true,
            DeleteHair=SkinState.DeleteHair==true,
            DeleteArmsFP=SkinState.DeleteArmsFP==true,
            DeleteAccessories=SkinState.DeleteAccessories==true,
            DeleteAllAccessories=SkinState.DeleteAllAccessories==true,
            SkinColorName=tostring(SkinState.SkinColorName or "Default"),
        }
    end

