    function SkinIsHeadAccessory(accessory, head)
        if not accessory or not accessory:IsA("Accessory") then
            return false
        end

        local okType, accessoryType = pcall(function()
            return accessory.AccessoryType
        end)

        if okType then
            if accessoryType == Enum.AccessoryType.Hat
                or accessoryType == Enum.AccessoryType.Face then
                return true
            elseif accessoryType == Enum.AccessoryType.Hair then
                return false
            end
        end

        local handle = accessory:FindFirstChild("Handle")
        if not handle then
            return false
        end

        for _, object in ipairs(handle:GetChildren()) do
            if object:IsA("Weld") or object:IsA("WeldConstraint") then
                local part1 = nil
                pcall(function() part1 = object.Part1 end)
                if part1 == head then
                    return true
                end
            elseif object:IsA("Attachment") and head then
                if head:FindFirstChild(object.Name) then
                    return true
                end
            end
        end

        return false
    end

