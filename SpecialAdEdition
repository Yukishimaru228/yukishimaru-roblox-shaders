--============================================================

local function Unload()

    if not Alive then
        return
    end

    Alive =
        false

    pcall(function()
        local skinState = _G.YukiSkinchanger
        if skinState and skinState.RestoreOriginal then
            pcall(function()
                skinState.RestoreOriginal()
            end)
        end
        if skinState and skinState.CharacterConnection then
            skinState.CharacterConnection:Disconnect()
            skinState.CharacterConnection = nil
        end
        _Yuki_CursorResetSystem()
        if CursorState.OverlayConnection then
            pcall(function()
                CursorState.OverlayConnection:Disconnect()
            end)
            CursorState.OverlayConnection = nil
        end
        if CursorState.OverlayGui then
            pcall(function()
                CursorState.OverlayGui:Destroy()
            end)
            CursorState.OverlayGui = nil
            CursorState.OverlayImage = nil
        end
    end)
    CursorState.CurrentName = "Default"
    CursorState.CurrentId = nil
    do
        local skinState = _G.YukiSkinchanger
        if skinState then
            skinState.ApplyToken += 1
            skinState.TargetDescription = nil
            skinState.TargetUsername = ""
            skinState.TargetUserId = nil
        end
    end

    pcall(function()
        if _G.YukiPetsCars and _G.YukiPetsCars.Cleanup then
            _G.YukiPetsCars.Cleanup()
        end
    end)
    SetMenuBlur(false)
    DisconnectAll()

    -- Never leave preset-modified Lighting / Fog / Sky / Clouds behind
    -- after the engine is unloaded.
    _Yuki_RestoreKilledAtmosphere()
    _Yuki_RestoreOriginalWorld()

    _Yuki_DestroyShaderEffects()
    _Yuki_DestroyVignette()
    _Yuki_StopMotionBlur()

    if Camera then
        pcall(function()
            Camera.FieldOfView = 70
        end)
    end

    Tween(
        Main,
        {
            Size =
                UDim2.fromOffset(
                    5,
                    5
                ),

            BackgroundTransparency =
                1
        },
        0.30,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )

    task.delay(
        0.32,
        function()
            SafeDestroy(
                ScreenGui
            )
        end
    )
end

