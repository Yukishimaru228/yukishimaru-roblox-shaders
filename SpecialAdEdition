    function SkinRememberHidden(object)
        if SkinState.HiddenObjects[object] then return end
        local data = {}
        if object:IsA("BasePart") then
            data.Kind = "BasePart"
            data.Transparency = object.Transparency
            data.LocalTransparencyModifier = object.LocalTransparencyModifier
            SkinState.HiddenObjects[object] = data
        elseif object:IsA("Decal") or object:IsA("Texture") then
            data.Kind = "Image"
            data.Transparency = object.Transparency
            SkinState.HiddenObjects[object] = data
        elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
            data.Kind = "Enabled"
            data.Enabled = object.Enabled
            SkinState.HiddenObjects[object] = data
        elseif object:IsA("BillboardGui") or object:IsA("SurfaceGui") then
            data.Kind = "Enabled"
            data.Enabled = object.Enabled
            SkinState.HiddenObjects[object] = data
        elseif object:IsA("WrapLayer") then
            data.Kind = "Enabled"
            data.Enabled = object.Enabled
            SkinState.HiddenObjects[object] = data
        end
    end

    -- Game-specific equipment may be parented below the rendered rig. Keep
    -- Tools, recognizable weapon/back accessories and gear Models visible.
    -- Do NOT preserve every direct-child Model: some games split the
    -- avatar body into nested Models, and leaving those visible causes two
    -- overlapping avatars after the proxy skin is applied.
    -- V21: token-based name matching. Plain substring matching treated normal
    -- avatar accessories such as "Rainbow..." (contains "bow") or "Gunmetal..."
    -- as gameplay weapons, so they stayed visible on top of the skin.
    function SkinNameMatchesHints(rawName, hints)
        local text = tostring(rawName or "")
        local spaced = (text:gsub("(%l)(%u)", "%1 %2"))
        spaced = (spaced:gsub("(%u)(%u%l)", "%1 %2"))
        spaced = string.lower((spaced:gsub("[^%a]+", " ")))
        local words = {}
        for word in spaced:gmatch("%a+") do
            words[word] = true
            if #word > 3 and word:sub(-1) == "s" then
                words[word:sub(1, -2)] = true
            end
        end
        local joined = string.lower((text:gsub("[^%a]", "")))
        words[joined] = true
        for _, hint in ipairs(hints) do
            if words[hint] then
                return true
            end
        end
        return false
    end

    -- Roblox catalog accessories always carry these helper values/layers.
    -- Real gameplay props made by developers normally do not.
    function SkinInstanceHasCatalogMarker(instance)
        if not instance then return false end
        local ok, found = pcall(function()
            return instance:FindFirstChild("AvatarPartScaleType", true)
                or instance:FindFirstChild("OriginalSize", true)
                or instance:FindFirstChildWhichIsA("WrapLayer", true)
        end)
        return ok and found ~= nil
    end

    local function SkinNameSuggestsGameEquipment(value)
        local name = tostring(value or "")
        local hints = {
            "weapon", "weapons", "sword", "greatsword", "backsword", "katana",
            "knife", "dagger", "blade", "backblade", "backweapon", "scabbard",
            "backpack", "tool", "gear", "equipment", "equipped", "melee",
            "scythe", "axe", "hammer", "spear", "trident", "staff", "wand",
            "shield", "quiver", "crossbow", "rifle", "pistol", "gun", "bow",
            "launcher", "holster", "grenade", "rocket", "cannon", "musket",
            "dualblade", "battleaxe", "saber", "sabre", "rapier"
        }
        return SkinNameMatchesHints(name, hints)
    end

    local function SkinModelLooksLikeGameEquipment(model)
        if not model or not model:IsA("Model") then return false end

        -- Never classify an ancestor as equipment when it contains avatar body
        -- parts. A few games put the rig, hair, accessories and back weapon into
        -- one or more nested Models; treating such a container as a weapon leaves
        -- the player's normal hair/accessories visible over the saved skin.
        local hasHandle = false
        local hasAvatarBodyPart = false
        local bodyNames = {
            Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
            ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true,
            LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
            RightUpperArm=true, RightLowerArm=true, RightHand=true,
            LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
            RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
            LeftClavicle=true, RightClavicle=true,
        }

        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") then
                if string.lower(child.Name) == "handle" then
                    hasHandle = true
                end
                if bodyNames[child.Name] then
                    hasAvatarBodyPart = true
                end
            end
        end

        -- Body containers always lose; even if they contain a Tool, back
        -- attachment or a nested child named "Sword", don't keep the container.
        if hasAvatarBodyPart then
            return false
        end

        -- Only the candidate model's own name or a model shaped like a simple
        -- handle-based prop may qualify. Do not classify a model because some
        -- arbitrary descendant happens to be called "weapon" or "gear".
        if SkinNameSuggestsGameEquipment(model.Name) then
            return true
        end
        -- A nested Model with a "Handle" is only a gameplay prop when it is not
        -- a catalog avatar accessory in disguise.
        return hasHandle and not SkinInstanceHasCatalogMarker(model)
    end

    -- A number of games attach their equipped weapon directly as an Accessory
    -- (for example, a sword/sheath on the player's back) instead of using a Tool
    -- or a separate Model. Hide regular avatar cosmetics, but retain Accessories
    -- whose own name or internal part names clearly identify a gameplay weapon.
    local function SkinAccessoryNameSuggestsGameplayItem(value)
        local name = tostring(value or "")
        local hints = {
            "weapon", "sword", "greatsword", "backsword", "katana", "knife",
            "dagger", "blade", "backblade", "backweapon", "scabbard", "scythe",
            "axe", "hammer", "spear", "trident", "staff", "wand", "shield",
            "quiver", "crossbow", "rifle", "pistol", "gun", "bow", "launcher",
            "holster", "grenade", "rocket", "cannon", "musket", "dualblade",
            "battleaxe", "saber", "sabre", "rapier"
        }
        return SkinNameMatchesHints(name, hints)
    end

    local function SkinAccessoryLooksLikeGameEquipment(accessory, rootModel)
        if not accessory or not accessory:IsA("Accessory") then
            return false
        end

        -- Catalog avatar accessories are cosmetics: never keep them by name.
        if not SkinInstanceHasCatalogMarker(accessory) then
            if SkinAccessoryNameSuggestsGameplayItem(accessory.Name) then
                return true
            end

            for _, descendant in ipairs(accessory:GetDescendants()) do
                -- Look for nodes such as SwordMesh, WeaponHandle, BackBlade or
                -- Scabbard. Generic names like Handle/Mesh alone don't qualify.
                if SkinAccessoryNameSuggestsGameplayItem(descendant.Name) then
                    return true
                end
            end
        end

        -- Some games keep their equipped items inside an explicit inventory or
        -- equipment container and give the Accessory itself a generic name.
        local current = accessory.Parent
        while current and current ~= rootModel do
            local lowerName = string.lower(tostring(current.Name or ""))
            if lowerName:find("equipped", 1, true)
                or lowerName:find("equipment", 1, true)
                or lowerName:find("weapons", 1, true)
                or lowerName:find("inventory", 1, true)
                or lowerName:find("backitems", 1, true)
                or lowerName:find("back_items", 1, true)
            then
                return true
            end
            if current:IsA("Tool") then
                return true
            end
            current = current.Parent
        end

        return false
    end

    function SkinIsGameEquipmentObject(object, rootModel)
        if not object or not rootModel then return false end
        local current = object
        while current and current ~= rootModel do
            if current:IsA("Tool") then
                return true
            end

            if current:IsA("Accessory") then
                return SkinAccessoryLooksLikeGameEquipment(current, rootModel)
            end

            if current:IsA("Model") and current ~= rootModel
                and not current:FindFirstChildOfClass("Humanoid")
                and SkinModelLooksLikeGameEquipment(current) then
                return true
            end
            current = current.Parent
        end
        return false
    end

    -- V22: hide ONLY avatar visuals (body parts, face, catalog accessories).
    -- Everything the game attached to the character (effects, particles,
    -- trails, beams, lights, custom models/props, game accessories) stays.
    SkinState.AvatarPartNames = {
        Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
        ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true,
        LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
        RightUpperArm=true, RightLowerArm=true, RightHand=true,
        LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
        RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
    }
    SkinState.MarkerCache = setmetatable({}, {__mode = "k"})

    -- An Accessory counts as avatar cosmetic when it is a catalog item (has the
    -- Roblox helper values) or when it is a small plain item without effects.
    -- Big/complex game props (creatures, auras with emitters) are kept.
    function SkinAccessoryIsAvatarCosmetic(accessory)
        if accessory:IsA("Hat") then return true end
        if SkinInstanceHasCatalogMarker(accessory) then return true end
        local parts = 0
        for _, d in ipairs(accessory:GetDescendants()) do
            if d:IsA("BasePart") then
                parts += 1
                if parts > 4 then return false end
            elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                or d:IsA("Light") or d:IsA("Highlight") or d:IsA("Fire")
                or d:IsA("Smoke") or d:IsA("Sparkles") or d:IsA("Model") then
                return false
            end
        end
        return true
    end

    function SkinModelHasBodyParts(model)
        return model:FindFirstChild("Head") ~= nil
            or model:FindFirstChild("Torso") ~= nil
            or model:FindFirstChild("UpperTorso") ~= nil
            or model:FindFirstChildOfClass("Humanoid") ~= nil
    end

    function SkinShouldHideVisualObject(object, rootModel)
        if not object or not rootModel then return false end
        if SkinState.ProxyCharacter and (object == SkinState.ProxyCharacter or object:IsDescendantOf(SkinState.ProxyCharacter)) then
            return false
        end
        if SkinIsGameEquipmentObject(object, rootModel) then
            return false
        end

        -- Inside an accessory: decided once per accessory.
        local accessory = object
        while accessory and accessory ~= rootModel and not (accessory:IsA("Accessory") or accessory:IsA("Hat")) do
            accessory = accessory.Parent
        end
        if accessory and accessory ~= rootModel then
            local cached = SkinState.MarkerCache[accessory]
            if cached == nil then
                cached = SkinAccessoryIsAvatarCosmetic(accessory)
                SkinState.MarkerCache[accessory] = cached
            end
            return cached
        end

        if object:IsA("BasePart") then
            if SkinState.AvatarPartNames[object.Name] or object.Name == "HumanoidRootPart" then
                return true
            end
            -- R15 body parts carry Roblox helper values even with odd names.
            if SkinInstanceHasCatalogMarker(object) then
                return true
            end
            -- Body split into nested Models (some games do this).
            local model = object:FindFirstAncestorWhichIsA("Model")
            if model and model ~= rootModel and SkinModelHasBodyParts(model) then
                return true
            end
            return false
        end
        if object:IsA("Decal") or object:IsA("Texture") then
            local parent = object.Parent
            return parent ~= nil and string.lower(object.Name) == "face"
        end
        if object:IsA("WrapLayer") then
            local parent = object.Parent
            return parent ~= nil and (SkinState.AvatarPartNames[parent.Name] == true or SkinInstanceHasCatalogMarker(parent))
        end
        -- ParticleEmitter / Trail / Beam / Lights / Billboards etc. => game effects: keep.
        return false
    end

    function SkinHideCharacter(character, hide)
        if not character then return end

        if hide then
            if SkinState.HiddenCharacter ~= character then
                SkinState.HiddenCharacter = character
                SkinState.HiddenModels = {}
                SkinState.HiddenObjects = {}
            end
        else
            -- Restoration is centralized so we can also restore extra local visual rigs.
            for object, data in pairs(SkinState.HiddenObjects or {}) do
                if object and object.Parent then
                    pcall(function()
                        if data.Kind == "BasePart" then
                            object.Transparency = data.Transparency
                            object.LocalTransparencyModifier = data.LocalTransparencyModifier
                        elseif data.Kind == "Image" then
                            object.Transparency = data.Transparency
                        elseif data.Kind == "Enabled" then
                            object.Enabled = data.Enabled
                        end
                    end)
                end
            end
            SkinState.HiddenCharacter = nil
            SkinState.HiddenModels = {}
            SkinState.HiddenObjects = {}
            return
        end

        for _, object in ipairs(character:GetDescendants()) do
            if SkinShouldHideVisualObject(object, character) then
                SkinRememberHidden(object)
                local data = SkinState.HiddenObjects[object]
                if data then
                    if data.Kind == "BasePart" then
                        object.Transparency = 1
                        object.LocalTransparencyModifier = 1
                    elseif data.Kind == "Image" then
                        object.Transparency = 1
                    elseif data.Kind == "Enabled" then
                        object.Enabled = false
                    end
                end
            end
        end
    end

    function SkinHideModelVisuals(model)
        if not model or not model:IsA("Model") or model == SkinState.ProxyCharacter then
            return
        end

        SkinState.HiddenModels[model] = true
        for _, object in ipairs(model:GetDescendants()) do
            if SkinShouldHideVisualObject(object, model) then
                SkinRememberHidden(object)
                local data = SkinState.HiddenObjects[object]
                if data then
                    if data.Kind == "BasePart" then
                        object.Transparency = 1
                        object.LocalTransparencyModifier = 1
                    elseif data.Kind == "Image" then
                        object.Transparency = 1
                    elseif data.Kind == "Enabled" then
                        object.Enabled = false
                    end
                end
            end
        end
    end

    function SkinModelBelongsToLocalPlayer(model)
        if not model or not model:IsA("Model") or model == SkinState.ProxyCharacter then
            return false
        end

        local character = LocalPlayer.Character
        if model == character then
            return true
        end

        local root = character and character:FindFirstChild("HumanoidRootPart")
        local anchor = model:FindFirstChild("HumanoidRootPart", true)
        if root and anchor then
            if (anchor.Position - root.Position).Magnitude > 18 then
                return false
            end
        end

        if model.Name == LocalPlayer.Name or model.Name == LocalPlayer.DisplayName then
            return true
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and Players:GetPlayerFromCharacter(model) == LocalPlayer then
            return true
        end

        return false
    end

    function SkinHideCandidateModel(model)
        if SkinModelBelongsToLocalPlayer(model) then
            SkinHideModelVisuals(model)
        end
    end

    function SkinScanExtraLocalVisuals()
        -- One-time scan when the skin is applied. The old version performed a
        -- full Workspace:GetDescendants() scan every RenderStepped, which was
        -- the main source of the heavy FPS drop in large games.
        for _, object in ipairs(Workspace:GetDescendants()) do
            if object:IsA("Model") then
                SkinHideCandidateModel(object)
            end
        end

        local cameraModel = Workspace.CurrentCamera
        if cameraModel then
            for _, object in ipairs(cameraModel:GetDescendants()) do
                if object:IsA("Model") then
                    SkinHideCandidateModel(object)
                end
            end
        end
    end

    function SkinReassertHiddenObjects()
        for object, data in pairs(SkinState.HiddenObjects or {}) do
            if object and object.Parent then
                pcall(function()
                    if data.Kind == "BasePart" then
                        object.Transparency = 1
                        object.LocalTransparencyModifier = 1
                    elseif data.Kind == "Image" then
                        object.Transparency = 1
                    elseif data.Kind == "Enabled" then
                        object.Enabled = false
                    end
                end)
            end
        end
    end

    -- Re-run the original-avatar mask without rebuilding or touching the proxy.
    -- This is intentionally shared with the saved-skin apply path because games
    -- may add their avatar cosmetics a few frames after ApplySavedSkin succeeds.
    function SkinReapplyActiveSkinMask(expectedToken)
        if expectedToken and expectedToken ~= SkinState.ApplyToken then return false end
        local proxy = SkinState.ProxyCharacter
        if not proxy or not proxy.Parent then return false end

        local character = LocalPlayer.Character
        if character and character.Parent then
            SkinHideCharacter(character, true)
        end

        local sourceVisual = SkinState.SourceCharacter
        if sourceVisual and sourceVisual.Parent and sourceVisual ~= character then
            SkinHideModelVisuals(sourceVisual)
        end

        SkinReassertHiddenObjects()
        return true
    end

    function SkinStartVisualWatchers(character, sourceVisual)
        if SkinState.ExtraVisualConnection then
            SkinState.ExtraVisualConnection:Disconnect()
            SkinState.ExtraVisualConnection = nil
        end
        if SkinState.CameraVisualConnection then
            SkinState.CameraVisualConnection:Disconnect()
            SkinState.CameraVisualConnection = nil
        end
        if SkinState.CharacterVisualConnection then
            SkinState.CharacterVisualConnection:Disconnect()
            SkinState.CharacterVisualConnection = nil
        end
        if SkinState.CameraChangedConnection then
            SkinState.CameraChangedConnection:Disconnect()
            SkinState.CameraChangedConnection = nil
        end
        if SkinState.SourceVisualConnection then
            SkinState.SourceVisualConnection:Disconnect()
            SkinState.SourceVisualConnection = nil
        end

        SkinState.CharacterVisualConnection = character.DescendantAdded:Connect(function(object)
            if SkinState.ProxyCharacter == nil
                or object:IsDescendantOf(SkinState.ProxyCharacter)
                or not SkinShouldHideVisualObject(object, character)
            then
                return
            end
            SkinRememberHidden(object)
            local data = SkinState.HiddenObjects[object]
            if data then
                if data.Kind == "BasePart" then
                    object.Transparency = 1
                    object.LocalTransparencyModifier = 1
                elseif data.Kind == "Image" then
                    object.Transparency = 1
                elseif data.Kind == "Enabled" then
                    object.Enabled = false
                end
            end
        end)

        -- Evade's real rendered avatar lives under Workspace.Rigs.<player>.
        -- Accessories can be inserted into that rig without the whole model
        -- being recreated, so watch the visual rig itself instead of relying
        -- only on Workspace.DescendantAdded (which sees the new Accessory, not
        -- a new Model). This is the important part from the Rigs diagnostics.
        if sourceVisual and sourceVisual ~= character and sourceVisual.Parent then
            SkinState.SourceVisualConnection = sourceVisual.DescendantAdded:Connect(function(object)
                if (SkinState.ProxyCharacter and object:IsDescendantOf(SkinState.ProxyCharacter))
                    or not SkinShouldHideVisualObject(object, sourceVisual)
                then
                    return
                end
                task.defer(function()
                    if Alive and SkinState.ProxyCharacter and object.Parent
                        and SkinShouldHideVisualObject(object, sourceVisual)
                    then
                        SkinRememberHidden(object)
                        local data = SkinState.HiddenObjects[object]
                        if data then
                            if data.Kind == "BasePart" then
                                object.Transparency = 1
                                object.LocalTransparencyModifier = 1
                            elseif data.Kind == "Image" then
                                object.Transparency = 1
                            elseif data.Kind == "Enabled" then
                                object.Enabled = false
                            end
                        end
                    end
                end)
            end)
        end

        SkinState.ExtraVisualConnection = Workspace.DescendantAdded:Connect(function(object)
            if not object:IsA("Model") then
                return
            end
            task.defer(function()
                if Alive and object.Parent and object ~= SkinState.ProxyCharacter then
                    SkinHideCandidateModel(object)
                end
            end)
        end)

        local currentCamera = Workspace.CurrentCamera
        if currentCamera then
            SkinState.CameraVisualConnection = currentCamera.DescendantAdded:Connect(function(object)
                if not object:IsA("Model") then
                    return
                end
                task.defer(function()
                    if Alive and object.Parent and object ~= SkinState.ProxyCharacter then
                        SkinHideCandidateModel(object)
                    end
                end)
            end)
        end

        SkinState.CameraChangedConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            if SkinState.CameraVisualConnection then
                SkinState.CameraVisualConnection:Disconnect()
                SkinState.CameraVisualConnection = nil
            end
            local camera = Workspace.CurrentCamera
            if camera and SkinState.TargetUserId then
                for _, object in ipairs(camera:GetDescendants()) do
                    if object:IsA("Model") then
                        SkinHideCandidateModel(object)
                    end
                end
                SkinState.CameraVisualConnection = camera.DescendantAdded:Connect(function(object)
                    if not object:IsA("Model") then
                        return
                    end
                    task.defer(function()
                        if Alive and object.Parent and object ~= SkinState.ProxyCharacter then
                            SkinHideCandidateModel(object)
                        end
                    end)
                end)
            end
        end)
    end

    function SkinStopTracks()
        for _, track in pairs(SkinState.ProxyTracks or {}) do
            pcall(function()
                track:Stop(0)
                track:Destroy()
            end)
        end
        SkinState.ProxyTracks = {}
    end

    local EVADE_PLACE_ID = 9872472334
    local EVADE_KORBLOX_OFFSET = 0.7

    function SkinGetEvadeRig()
        local rigs = Workspace:FindFirstChild("Rigs")
        if not rigs then
            return nil
        end
        return rigs:FindFirstChild(LocalPlayer.Name)
    end

    function SkinLooksLikeEvade()
        if game.PlaceId == EVADE_PLACE_ID then
            return true
        end

        local rig = SkinGetEvadeRig()
        if not rig then
            return false
        end

        return rig:FindFirstChild("Joints") ~= nil
            and rig:FindFirstChildOfClass("Humanoid") ~= nil
            and rig:FindFirstChild("Right Leg") ~= nil
            and rig:FindFirstChild("Head") ~= nil
    end

    function SkinGetRoot(model)
        if not model then
            return nil
        end

        -- Evade's diagnostic shows that the rendered rig has NO
        -- HumanoidRootPart of its own. Its real animation/movement chain is
        -- rooted through Workspace.Rigs.<player>.TorsoRot, whose Motor6D.Part0
        -- points at the external CarryModel.HumanoidRootPart. Prefer that
        -- intermediate root when it exists so Skinchanger follows the same
        -- visual reference frame that the game is actually animating.
        return model:FindFirstChild("HumanoidRootPart", true)
            or model:FindFirstChild("TorsoRot", true)
            or model:FindFirstChild("Torso", true)
            or model:FindFirstChild("UpperTorso", true)
            or model:FindFirstChild("LowerTorso", true)
    end

    function SkinIsLikelyVisualRig(model, character, preferName)
        if not model or not model:IsA("Model") then
            return false, -math.huge
        end
        if model == character or model == SkinState.ProxyCharacter then
            return false, -math.huge
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = SkinGetRoot(model)
        if not hum or not root then
            return false, -math.huge
        end

        local rootCF = SkinGetRoot(character)
        local distance = rootCF and (root.Position - rootCF.Position).Magnitude or math.huge
        local namedLocal = model.Name == LocalPlayer.Name or model.Name == LocalPlayer.DisplayName
        local boundLocal = Players:GetPlayerFromCharacter(model) == LocalPlayer

        -- Do not ever select another player's nearby body as our animation source.
        -- A generic visual model has to be ours by name/binding or virtually overlap
        -- the real character.
        if not namedLocal and not boundLocal and distance > 4 then
            return false, -math.huge
        end
        if distance > 90 then
            return false, -math.huge
        end

        local bodyNames = {
            Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
            ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true,
            LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
            RightUpperArm=true, RightLowerArm=true, RightHand=true,
            LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
            RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
        }

        local bodyCount = 0
        local motorCount = 0
        local animatorCount = 0
        for _, object in ipairs(model:GetDescendants()) do
            if object:IsA("BasePart") and bodyNames[object.Name] then
                bodyCount += 1
            elseif object:IsA("Motor6D") then
                motorCount += 1
            elseif object:IsA("Animator") or object:IsA("AnimationController") then
                animatorCount += 1
            end
        end

        if bodyCount < 3 or motorCount < 2 then
            return false, -math.huge
        end

        local score = bodyCount * 3 + motorCount * 4 + animatorCount * 6
        if namedLocal then
            score += preferName and 140 or 100
        elseif boundLocal then
            score += 120
        elseif distance <= 1.5 then
            score += 25
        end
        score -= math.min(distance, 90) * 0.5
        return true, score
    end

    function SkinDetectSourceCharacter(character)
        SkinState.IsEvade = SkinLooksLikeEvade()

        -- 1) Known Evade visual rig: Workspace.Rigs.<LocalPlayer>.
        local evadeRig = SkinGetEvadeRig()
        if evadeRig then
            local hum = evadeRig:FindFirstChildOfClass("Humanoid")
            local root = SkinGetRoot(evadeRig)
            local joints = evadeRig:FindFirstChild("Joints")
            if hum and joints and (root or evadeRig:FindFirstChild("Torso", true) or evadeRig:FindFirstChild("UpperTorso", true)) then
                SkinState.SourceKind = "Workspace.Rigs"
                return evadeRig
            end
        end

        -- 2) Generic visual-avatar containers discovered by our diagnostics.
        local containers = {
            {Name="Rigs", Label="Workspace.Rigs"},
            {Name="Players", Label="Workspace.Players"},
        }

        local bestModel, bestScore, bestKind = nil, -math.huge, nil
        for _, info in ipairs(containers) do
            local container = Workspace:FindFirstChild(info.Name)
            if container then
                for _, child in ipairs(container:GetChildren()) do
                    local ok, score = SkinIsLikelyVisualRig(child, character, true)
                    if ok and score > bestScore then
                        bestModel = child
                        bestScore = score
                        bestKind = info.Label
                    end
                end

                if not bestModel then
                    for _, object in ipairs(container:GetDescendants()) do
                        if object:IsA("Model") then
                            local ok, score = SkinIsLikelyVisualRig(object, character, false)
                            if ok and score > bestScore then
                                bestModel = object
                                bestScore = score
                                bestKind = info.Label .. "/*"
                            end
                        end
                    end
                end
            end
        end

        if bestModel then
            SkinState.SourceKind = bestKind or "Workspace"
            return bestModel
        end

        -- 3) Small direct-child fallback for games that parent a visual shell
        -- directly under Workspace.
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") then
                local ok, score = SkinIsLikelyVisualRig(child, character, false)
                if ok and score > bestScore then
                    bestModel = child
                    bestScore = score
                    bestKind = "Workspace.Model"
                end
            end
        end

        if bestModel then
            SkinState.SourceKind = bestKind
            return bestModel
        end

        SkinState.SourceKind = "Character"
        return character
    end

    function SkinResolveSourceCharacter(character, waitForSource)
        local tries = waitForSource and 25 or 1
        for _ = 1, tries do
            local source = SkinDetectSourceCharacter(character)
            if source
                and SkinGetRoot(source)
                and source:FindFirstChildOfClass("Humanoid")
                and #source:GetDescendants() > 0
            then
                return source
            end
            if not waitForSource then
                break
            end
            task.wait(0.2)
        end
        return character
    end

    function SkinRememberEvadeObject(object)
        if SkinState.EvadeHiddenObjects[object] then
            return
        end

        local data = {}
        if object:IsA("BasePart") then
            data.Type = "Part"
            data.Transparency = object.Transparency
            data.LocalTransparencyModifier = object.LocalTransparencyModifier
            SkinState.EvadeHiddenObjects[object] = data
        elseif object:IsA("Decal") or object:IsA("Texture") then
            data.Type = "Image"
            data.Transparency = object.Transparency
            SkinState.EvadeHiddenObjects[object] = data
        elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
            or object:IsA("BillboardGui") or object:IsA("SurfaceGui") then
            data.Type = "Enabled"
            data.Enabled = object.Enabled
            SkinState.EvadeHiddenObjects[object] = data
        end
    end

    function SkinHideEvadeObject(object)
        if not object then return end
        SkinRememberEvadeObject(object)
        local data = SkinState.EvadeHiddenObjects[object]
        if not data then return end

        if data.Type == "Part" then
            object.Transparency = 1
            object.LocalTransparencyModifier = 1
        elseif data.Type == "Image" then
            object.Transparency = 1
        elseif data.Type == "Enabled" then
            object.Enabled = false
        end
    end

    function SkinRestoreEvadeObjects()
        for object, data in pairs(SkinState.EvadeHiddenObjects or {}) do
            if object and object.Parent then
                pcall(function()
                    if data.Type == "Part" then
                        object.Transparency = data.Transparency
                        object.LocalTransparencyModifier = data.LocalTransparencyModifier
                    elseif data.Type == "Image" then
                        object.Transparency = data.Transparency
                    elseif data.Type == "Enabled" then
                        object.Enabled = data.Enabled
                    end
                end)
            end
        end
        SkinState.EvadeHiddenObjects = {}
    end

    function SkinIsHeadAccessoryDirect(accessory, head)
        if not accessory or not accessory:IsA("Accessory") then
            return false
        end

        local okType, accessoryType = pcall(function()
            return accessory.AccessoryType
        end)

        if okType then
            if accessoryType == Enum.AccessoryType.Hair then
                return false
            end
            if accessoryType == Enum.AccessoryType.Hat
                or accessoryType == Enum.AccessoryType.Face then
                return true
            end
        end

        local handle = accessory:FindFirstChild("Handle")
        if not handle or not head then
            return false
        end

        for _, object in ipairs(handle:GetChildren()) do
            if object:IsA("Weld") or object:IsA("WeldConstraint") then
                local part1
                pcall(function() part1 = object.Part1 end)
                if part1 == head then
                    return true
                end
            elseif object:IsA("Attachment") and head:FindFirstChild(object.Name) then
                return true
            end
        end

        return false
    end

    function SkinApplyEvadeDirectModifiers(rig)
        if not rig or not rig.Parent then
            return false
        end

        SkinRestoreEvadeObjects()

        if SkinState.EvadeKorbloxVisual then
            pcall(function() SkinState.EvadeKorbloxVisual:Destroy() end)
            SkinState.EvadeKorbloxVisual = nil
        end

        SkinState.EvadeDirectRig = rig

        local head = rig:FindFirstChild("Head")
        local rightLeg = rig:FindFirstChild("Right Leg")
        if not head or not rightLeg then
            return false
        end

        if SkinState.Headless then
            SkinHideEvadeObject(head)
            for _, object in ipairs(head:GetDescendants()) do
                if object:IsA("Decal") or object:IsA("Texture")
                    or object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
                    or object:IsA("BillboardGui") or object:IsA("SurfaceGui") then
                    SkinHideEvadeObject(object)
                end
            end
        end

        if SkinState.Korblox then
            SkinRememberEvadeObject(rightLeg)
            rightLeg.Transparency = 1

            local old = rig:FindFirstChild("YukiKorbloxVisual")
            if old then
                pcall(function() old:Destroy() end)
            end

            local shell = Instance.new("Part")
            shell.Name = "YukiKorbloxVisual"
            shell.Size = Vector3.new(1, 2, 1)
            shell.Anchored = false
            shell.CanCollide = false
            shell.CanTouch = false
            shell.CanQuery = false
            shell.Massless = true
            shell.Transparency = 0
            shell.CFrame = rightLeg.CFrame * CFrame.new(0, EVADE_KORBLOX_OFFSET, 0)
            shell.Parent = rig

            local mesh = Instance.new("SpecialMesh")
            mesh.Name = "KorbloxMesh"
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://902942096"
            mesh.TextureId = "rbxassetid://902843398"
            mesh.Scale = Vector3.new(1, 1, 1)
            mesh.Parent = shell

            local weld = Instance.new("WeldConstraint")
            weld.Name = "YukiKorbloxWeld"
            weld.Part0 = shell
            weld.Part1 = rightLeg
            weld.Parent = shell

            SkinState.EvadeKorbloxVisual = shell
        end

        for _, object in ipairs(rig:GetChildren()) do
            if object:IsA("Accessory") then
                local hide = false
                local okType, accessoryType = pcall(function() return object.AccessoryType end)
                if SkinState.DeleteHair and okType and accessoryType == Enum.AccessoryType.Hair then
                    hide = true
                end
                if SkinState.DeleteAccessories and SkinIsHeadAccessoryDirect(object, head) then
                    hide = true
                end
                if SkinState.DeleteAllAccessories then
                    hide = true
                end
                if hide then
                    for _, descendant in ipairs(object:GetDescendants()) do
                        if descendant:IsA("BasePart") or descendant:IsA("Decal") or descendant:IsA("Texture")
                            or descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") or descendant:IsA("Beam")
                            or descendant:IsA("BillboardGui") or descendant:IsA("SurfaceGui") then
                            SkinHideEvadeObject(descendant)
                        end
                    end
                end
            end
        end

        return true
    end

    function SkinClearEvadeDirect()
        if SkinState.EvadeAccessoryConnection then
            pcall(function() SkinState.EvadeAccessoryConnection:Disconnect() end)
            SkinState.EvadeAccessoryConnection = nil
        end

        SkinRestoreEvadeObjects()

        if SkinState.EvadeKorbloxVisual then
            pcall(function() SkinState.EvadeKorbloxVisual:Destroy() end)
            SkinState.EvadeKorbloxVisual = nil
        end

        SkinState.EvadeDirectRig = nil
    end

    function SkinWatchEvadeDirectRig(rig)
        if SkinState.EvadeAccessoryConnection then
            pcall(function() SkinState.EvadeAccessoryConnection:Disconnect() end)
            SkinState.EvadeAccessoryConnection = nil
        end
        if not rig then
            return
        end

        SkinState.EvadeAccessoryConnection = rig.DescendantAdded:Connect(function(object)
            if not SkinState.IsEvade then return end
            if object:IsA("Accessory") then
                task.defer(function()
                    if rig.Parent and SkinState.EvadeDirectRig == rig then
                        SkinApplyEvadeDirectModifiers(rig)
                    end
                end)
            end
        end)
    end

    function SkinSetupEvadeRigWatcher()
        if SkinState.EvadeFolderConnection then
            pcall(function() SkinState.EvadeFolderConnection:Disconnect() end)
            SkinState.EvadeFolderConnection = nil
        end
        if SkinState.EvadeRigConnection then
            pcall(function() SkinState.EvadeRigConnection:Disconnect() end)
            SkinState.EvadeRigConnection = nil
        end

        local function onRigAdded(child)
            if child.Name ~= LocalPlayer.Name then
                return
            end
            task.spawn(function()
                for _ = 1, 25 do
                    if not child.Parent then return end
                    if child:FindFirstChild("Joints") and child:FindFirstChild("Head") and child:FindFirstChild("Right Leg") then
                        task.wait(0.1)
                        if SkinState.TargetUserId then
                            SkinState.RebuildCurrentSkin()
                        elseif SkinState.Headless or SkinState.Korblox or SkinState.DeleteHair or SkinState.DeleteAccessories then
                            SkinState.IsEvade = true
                            SkinApplyEvadeDirectModifiers(child)
                            SkinWatchEvadeDirectRig(child)
                        end
                        return
                    end
                    task.wait(0.2)
                end
            end)
        end

        local rigs = Workspace:FindFirstChild("Rigs")
        if rigs then
            SkinState.EvadeRigConnection = rigs.ChildAdded:Connect(onRigAdded)
        else
            SkinState.EvadeFolderConnection = Workspace.ChildAdded:Connect(function(child)
                if child.Name ~= "Rigs" then return end
                if SkinState.EvadeRigConnection then
                    pcall(function() SkinState.EvadeRigConnection:Disconnect() end)
                end
                SkinState.EvadeRigConnection = child.ChildAdded:Connect(onRigAdded)
            end)
        end
    end

    SkinSetupEvadeRigWatcher()

    function SkinIsAnimJoint(object)
        return object:IsA("Motor6D") or object:IsA("AnimationConstraint")
    end

    function SkinJointPartNames(object)
        local p0, p1 = nil, nil
        pcall(function() p0 = object.Part0 end)
        pcall(function() p1 = object.Part1 end)
        return p0 and p0.Name or "", p1 and p1.Name or ""
    end

    local BODY_PART_NAMES = {
        Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
        ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true,
        LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
        RightUpperArm=true, RightLowerArm=true, RightHand=true,
        LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
        RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
        LeftClavicle=true, RightClavicle=true,
    }

    function SkinIsBodyPart(object)
        if not object or not object:IsA("BasePart") then
            return false
        end
        if object.Name == "HumanoidRootPart" then
            return false
        end
        if object:FindFirstAncestorOfClass("Accessory") then
            return false
        end
        if object:FindFirstAncestorOfClass("Tool") then
            return false
        end
        return BODY_PART_NAMES[object.Name] == true
    end

    function SkinBuildPoseMap(sourceCharacter, proxy)
        SkinState.PosePairs = {}
        SkinState.BodyPairs = {}
        SkinState.PoseSourceCount = 0

        if not sourceCharacter or not proxy then
            return
        end

        local targetParts = {}

        for _, object in ipairs(proxy:GetDescendants()) do
            if SkinIsBodyPart(object) then
                targetParts[object.Name] = object
            end
        end

        -- The diagnostic proved that Evade's visible avatar is driven by the
        -- FINAL WORLD CFRAME of these visible body parts, while the logical
        -- Character exposes almost no useful animation state. Therefore the
        -- Skinchanger uses the rendered body pose as the authoritative source.
        for _, object in ipairs(sourceCharacter:GetDescendants()) do
            if SkinIsBodyPart(object) then
                local target = targetParts[object.Name]

                if target then
                    table.insert(SkinState.BodyPairs, {
                        Source = object,
                        Target = target
                    })
                end
            end
        end

        SkinState.PoseSourceCount = #SkinState.BodyPairs
    end

    function SkinSyncPose()
        local sourceCharacter = SkinState.SourceCharacter
        local proxy = SkinState.ProxyCharacter

        if not sourceCharacter
            or not sourceCharacter.Parent
            or not proxy
            or not proxy.Parent
        then
            return
        end

        local sourceReference = SkinGetRoot(sourceCharacter)

        -- In Evade the diagnostic shows Workspace.Rigs.<player> has no
        -- HumanoidRootPart, but it has a real Torso/UpperTorso body reference.
        -- For the proxy we intentionally use that same reference.
        if not sourceReference then
            return
        end

        local proxyRoot =
            proxy:FindFirstChild("HumanoidRootPart", true)

        if not proxyRoot then
            return
        end

        -- Keep the invisible proxy root on the same visual reference part.
        -- The root itself is never used as an animation source; it only keeps
        -- the cloned model's internal origin sane.
        pcall(function()
            proxyRoot.CFrame = sourceReference.CFrame
        end)

        -- IMPORTANT: the new diagnostic shows that Evade's rendered body is
        -- driven by a custom joint graph (TorsoRot -> ArmRot/Torso -> limbs),
        -- plus an external CarryModel root. Reconstructing a Roblox R6 pose
        -- from joint transforms loses information. The safest exact transfer is
        -- therefore the FINAL WORLD CFRAME of every visible source body part.
        -- We copy that world CFrame directly into the anchored proxy body part.
        -- No AnimationTrack replay, no Motor6D.Transform reconstruction and no
        -- proxy animation system can fight the result.
        for _, pair in ipairs(SkinState.BodyPairs or {}) do
            local source = pair.Source
            local target = pair.Target

            if source
                and source.Parent
                and target
                and target.Parent
            then
                pcall(function()
                    target.CFrame = source.CFrame
                end)
            end
        end

        for _, overlayData in ipairs(SkinState.ItemOverlays or {}) do
            local target = overlayData.Target
            local overlay = overlayData.Overlay
            if target and target.Parent and overlay and overlay.Parent then
                pcall(function() overlay.CFrame = target.CFrame end)
            end
        end
    end

    function SkinFindSourceAnimators(character)
        local animators = {}
        if not character then
            return animators
        end

        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("Animator") then
                table.insert(animators, object)
            end
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator and not table.find(animators, animator) then
                table.insert(animators, animator)
            end
        end

        return animators
    end

    function SkinShouldUseTrackFallback()
        -- Diagnostic-driven Skinchanger never replays source AnimationTracks.
        -- The source game's final rendered body pose is authoritative.
        return false
    end

    function SkinSyncAnimationTracks(_animators)
        -- Intentionally unused in the diagnostic-driven implementation.
        -- Kept as a compatibility stub because the surrounding Skinchanger
        -- cleanup/state code still references ProxyTracks.
        return false
    end

    -- ============================================================
    -- EVADE FIRST-PERSON SAFETY MASK
    -- Temporarily hides the proxy head and head accessories while the
    -- camera is inside the avatar. Permanent Skinchanger toggles are
    -- never modified.
    -- ============================================================

    function SkinFirstPersonShouldMask()
        if not SkinState.IsEvade then
            return false
        end

        local proxy = SkinState.ProxyCharacter
        if not proxy or not proxy.Parent then
            return false
        end

        -- Do not interfere with the dedicated pure Korblox / Headless
        -- Evade path. This safety layer is for proxy-based skin changes.
        local hasOtherSkinChange =
            SkinState.TargetUserId ~= nil
            or SkinHasCustomItems()
            or SkinState.DeleteHair
            or SkinState.DeleteAccessories
            or SkinState.DeleteAllAccessories
            or SkinState.DeleteArmsFP
            or (SkinState.SkinColorName and SkinState.SkinColorName ~= "Default")

        return hasOtherSkinChange
    end

    function SkinIsFirstPersonCamera()
        local camera = Workspace.CurrentCamera
        if not camera then
            return false
        end

        local proxy = SkinState.ProxyCharacter
        local character = LocalPlayer.Character
        local head =
            (proxy and proxy:FindFirstChild("Head", true))
            or (character and character:FindFirstChild("Head", true))

        if not head or not head:IsA("BasePart") then
            return false
        end

        -- Tight enough to avoid normal close third-person being classified
        -- as first person.
        return (camera.CFrame.Position - head.Position).Magnitude <= 1.70
    end

    function SkinRememberFirstPersonObject(object, kind)
        if not object or SkinState.FirstPersonMaskedObjects[object] then
            return
        end

        if kind == "Part" and object:IsA("BasePart") then
            SkinState.FirstPersonMaskedObjects[object] = {
                Kind = "Part",
                Transparency = object.Transparency,
                LocalTransparencyModifier = object.LocalTransparencyModifier
            }
        elseif kind == "Image" and (object:IsA("Decal") or object:IsA("Texture")) then
            SkinState.FirstPersonMaskedObjects[object] = {
                Kind = "Image",
                Transparency = object.Transparency
            }
        elseif kind == "Enabled"
            and (
                object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam")
                or object:IsA("BillboardGui")
                or object:IsA("SurfaceGui")
            )
        then
            SkinState.FirstPersonMaskedObjects[object] = {
                Kind = "Enabled",
                Enabled = object.Enabled
            }
        end
    end

    function SkinHideFirstPersonObject(object)
        if not object then
            return
        end

        if object:IsA("BasePart") then
            SkinRememberFirstPersonObject(object, "Part")
            object.Transparency = 1
            object.LocalTransparencyModifier = 1
        elseif object:IsA("Decal") or object:IsA("Texture") then
            SkinRememberFirstPersonObject(object, "Image")
            object.Transparency = 1
        elseif object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("BillboardGui")
            or object:IsA("SurfaceGui")
        then
            SkinRememberFirstPersonObject(object, "Enabled")
            object.Enabled = false
        end
    end

    function SkinIsFirstPersonHair(accessory)
        if not accessory or not accessory:IsA("Accessory") then
            return false
        end

        local okType, accessoryType = pcall(function()
            return accessory.AccessoryType
        end)

        return okType and accessoryType == Enum.AccessoryType.Hair
    end

    function SkinIsFirstPersonHeadAccessory(accessory, head)
        if not accessory or not accessory:IsA("Accessory") or not head then
            return false
        end

        local okType, accessoryType = pcall(function()
            return accessory.AccessoryType
        end)

        if okType then
            if accessoryType == Enum.AccessoryType.Hair
                or accessoryType == Enum.AccessoryType.Hat
                or accessoryType == Enum.AccessoryType.Face
            then
                return true
            end
        end

        local handle = accessory:FindFirstChild("Handle")
        if not handle then
            return false
        end

        for _, child in ipairs(handle:GetChildren()) do
            if child:IsA("Weld") or child:IsA("WeldConstraint") then
                local part1 = nil
                pcall(function() part1 = child.Part1 end)
                if part1 == head then
                    return true
                end
            elseif child:IsA("Attachment") and head:FindFirstChild(child.Name) then
                return true
            end
        end

        return false
    end

    function SkinEnterEvadeFirstPerson()
        local proxy = SkinState.ProxyCharacter
        if not proxy or not proxy.Parent then
            return
        end

        local head = proxy:FindFirstChild("Head", true)
        if not head or not head:IsA("BasePart") then
            return
        end

        -- Temporary Headless: hide the head and all visible children.
        SkinHideFirstPersonObject(head)
        for _, child in ipairs(head:GetDescendants()) do
            SkinHideFirstPersonObject(child)
        end

        -- Temporary Delete Hair + Delete Accessories for the proxy.
        for _, object in ipairs(proxy:GetChildren()) do
            if object:IsA("Accessory") then
                local hide =
                    SkinIsFirstPersonHeadAccessory(object, head)
                    or SkinIsFirstPersonHair(object)

                if hide then
                    for _, descendant in ipairs(object:GetDescendants()) do
                        SkinHideFirstPersonObject(descendant)
                    end
                end
            end
        end

        -- Delete arms in First Person: same enter/exit system as the head.
        if SkinState.DeleteArmsFP then
            local armNames = {
                ["Left Arm"] = true, ["Right Arm"] = true,
                LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
                RightUpperArm = true, RightLowerArm = true, RightHand = true,
            }
            for _, part in ipairs(proxy:GetChildren()) do
                if part:IsA("BasePart") and armNames[part.Name] then
                    SkinHideFirstPersonObject(part)
                    for _, child in ipairs(part:GetDescendants()) do
                        SkinHideFirstPersonObject(child)
                    end
                end
            end
        end

        SkinState.FirstPersonMaskActive = true
    end

    function SkinExitEvadeFirstPerson()
        if not SkinState.FirstPersonMaskActive
            and next(SkinState.FirstPersonMaskedObjects or {}) == nil
        then
            return
        end

        local proxy = SkinState.ProxyCharacter

        for object, data in pairs(SkinState.FirstPersonMaskedObjects or {}) do
            if object and object.Parent then
                pcall(function()
                    local keepHidden = false

                    -- If the user enabled permanent Headless while in
                    -- first person, do not restore the head on exit.
                    if data.Kind == "Part" and SkinState.Headless and object.Name == "Head" then
                        keepHidden = true
                    end

                    local accessory =
                        object:FindFirstAncestorOfClass("Accessory")

                    if accessory then
                        local head =
                            proxy and proxy:FindFirstChild("Head", true)

                        if SkinState.DeleteAllAccessories then
                            keepHidden = true
                        elseif SkinState.DeleteAccessories
                            and SkinIsFirstPersonHeadAccessory(accessory, head)
                        then
                            keepHidden = true
                        elseif SkinState.DeleteHair
                            and SkinIsFirstPersonHair(accessory)
                        then
                            keepHidden = true
                        end
                    end

                    if not keepHidden then
                        if data.Kind == "Part" then
