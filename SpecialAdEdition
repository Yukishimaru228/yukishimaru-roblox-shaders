--============================================================
-- V21 MENU FX: bolder font + living animations
-- Everything lives inside one function so it adds no top-level locals.
--============================================================
function _Yuki_MenuFx_Init()
    pcall(function() OuterGlow.Visible = false end) -- V23: edge glow removed
    -- 1) Bolder font everywhere in the menu (also for dynamically created UI).
    local function boldFont(obj)
        if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
            return
        end
        local f = obj.Font
        if f == Enum.Font.Gotham or f == Enum.Font.GothamMedium or f == Enum.Font.GothamSemibold then
            obj.Font = Enum.Font.GothamBold
        elseif f == Enum.Font.GothamBold and obj.TextSize >= 17 then
            obj.Font = Enum.Font.GothamBlack
        end
    end
    for _, obj in ipairs(ScreenGui:GetDescendants()) do
        pcall(boldFont, obj)
    end
    Connect(ScreenGui.DescendantAdded, function(obj)
        task.defer(function()
            if obj.Parent then pcall(boldFont, obj) end
        end)
    end)

    -- 2) Rotating light border around the whole window.
    local border = Instance.new("UIStroke")
    border.Name = "YukiFxBorder"
    border.Thickness = 1.8
    border.Color = Color3.new(1, 1, 1)
    border.Transparency = 0.1
    border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    border.Enabled = false -- V23: no glow around the window edges
    border.Parent = Main
    local borderGradient = Instance.new("UIGradient")
    borderGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 34, 40)),
        ColorSequenceKeypoint.new(0.18, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.36, Color3.fromRGB(34, 34, 40)),
        ColorSequenceKeypoint.new(0.62, Color3.fromRGB(170, 170, 180)),
        ColorSequenceKeypoint.new(0.80, Color3.fromRGB(34, 34, 40)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(34, 34, 40)),
    })
    borderGradient.Parent = border

    -- 3) Light sweep across the title.
    local titleGradient = Instance.new("UIGradient")
    titleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(150, 150, 158)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(150, 150, 158)),
    })
    titleGradient.Parent = HeaderTitle

    -- 4) Breathing status dots.
    local dots = {}
    for _, obj in ipairs(Main:GetDescendants()) do
        if obj.Name == "StatusDot" and obj:IsA("GuiObject") then
            dots[#dots + 1] = obj
        end
    end

    -- 5) Button hover / press animation (UIScale: never disturbs layouts).
    local function animateButton(btn)
        if not btn:IsA("TextButton") or btn:GetAttribute("YukiFx") then return end
        if CursorState.Grid and btn:IsDescendantOf(CursorState.Grid) then return end
        if btn:FindFirstChildOfClass("UIScale") then return end
        btn:SetAttribute("YukiFx", true)
        local scale = Instance.new("UIScale")
        scale.Name = "YukiFxScale"
        scale.Parent = btn
        local hovering = false
        btn.MouseEnter:Connect(function()
            hovering = true
            Tween(scale, {Scale = 1.045}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
        btn.MouseLeave:Connect(function()
            hovering = false
            Tween(scale, {Scale = 1}, 0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end)
        btn.MouseButton1Down:Connect(function()
            Tween(scale, {Scale = 0.94}, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        end)
        btn.MouseButton1Up:Connect(function()
            Tween(scale, {Scale = hovering and 1.045 or 1}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
    end
    for _, obj in ipairs(Main:GetDescendants()) do
        pcall(animateButton, obj)
    end
    Connect(Main.DescendantAdded, function(obj)
        if obj:IsA("TextButton") then
            task.defer(function()
                if obj.Parent then pcall(animateButton, obj) end
            end)
        end
    end)

    -- 6) Cascade: when a page opens, its blocks rise in one after another.
    local base = {}
    local function cascade(page)
        if not page or not page.Visible then return end
        if page:FindFirstChildOfClass("UIListLayout") or page:FindFirstChildOfClass("UIGridLayout") then return end
        local index = 0
        for _, child in ipairs(page:GetChildren()) do
            if child:IsA("GuiObject") and not child:FindFirstAncestorOfClass("UIListLayout") then
                index += 1
                if index > 26 then break end
                if not child:GetAttribute("YukiFxMoving") then
                    base[child] = child.Position
                end
                local target = base[child]
                if target then
                    child:SetAttribute("YukiFxMoving", true)
                    child.Position = target + UDim2.fromOffset(0, 16)
                    task.delay((index - 1) * 0.03, function()
                        if not child.Parent then return end
                        local tw = Tween(child, {Position = target}, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                        tw.Completed:Once(function()
                            child:SetAttribute("YukiFxMoving", nil)
                        end)
                    end)
                end
            end
        end
    end
    for _, page in pairs(Pages) do
        Connect(page:GetPropertyChangedSignal("Visible"), function()
            if page.Visible then cascade(page) end
        end)
    end

    -- 7) Click burst: little bubbles pop out of every click inside the window.
    Connect(UserInputService.InputBegan, function(input)
        if not Alive or not Main.Visible then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mouse = UserInputService:GetMouseLocation()
        local origin = BubbleLayer.AbsolutePosition
        local x, y = mouse.X - origin.X, mouse.Y - origin.Y
        local size = BubbleLayer.AbsoluteSize
        if x < 0 or y < 0 or x > size.X or y > size.Y then return end
        for _ = 1, 7 do
            local dot = Instance.new("Frame")
            local d = RNG:NextNumber(4, 9)
            dot.AnchorPoint = Vector2.new(0.5, 0.5)
            dot.Size = UDim2.fromOffset(d, d)
            dot.Position = UDim2.fromOffset(x, y)
            dot.BackgroundColor3 = CONFIG.White
            dot.BackgroundTransparency = 0.25
            dot.BorderSizePixel = 0
            dot.ZIndex = 9
            dot.Parent = BubbleLayer
            AddCorner(dot, 99)
            local angle = RNG:NextNumber(0, math.pi * 2)
            local dist = RNG:NextNumber(26, 70)
            Tween(dot, {
