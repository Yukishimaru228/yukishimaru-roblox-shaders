    function SkinCollectItemIds()
        local ids, seen = {}, {}
        for index = 1, 30 do
            local raw = SkinState.ItemIds[index]
            local uiRaw = SkinState.ItemInputs[index] and SkinState.ItemInputs[index].Text or ""

            -- The input boxes are the user-visible source of truth. Older
            -- revisions initialized ItemIds[index] to "", which prevented a
            -- value still present in the textbox from being collected.
            if SkinTrim(raw) == "" and SkinTrim(uiRaw) ~= "" then
                raw = uiRaw
            end

            raw = SkinTrim(raw)
            if raw ~= "" then
                local id = tonumber(raw:match("%d+"))
                if id and id > 0 then
                    id = math.floor(id)
                    if not seen[id] then
                        seen[id] = true
                        table.insert(ids, id)
                    end
                end
            end
        end
        return ids
    end

    function SkinHasCustomItems()
        return #SkinCollectItemIds() > 0
