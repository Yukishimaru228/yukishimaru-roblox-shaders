    -- The visible code fields are authoritative. Clearing a field clears the
    -- corresponding state too; older ActiveItemIds must never resurrect it.
    function SkinSyncItemStateFromUI()
        SkinState.ItemIds = SkinState.ItemIds or {}
        SkinState.ActiveItemIds = SkinState.ActiveItemIds or {}
        for index = 1, 30 do
            local input = SkinState.ItemInputs and SkinState.ItemInputs[index]
            -- If this build has no item UI, do not erase values restored from a preset.
            local raw = input and SkinTrim(input.Text) or (not input and SkinTrim(SkinState.ItemIds[index] or "") or "")
            if raw == "" then
                SkinState.ItemIds[index] = ""
                SkinState.ActiveItemIds[index] = nil
            else
                local id = tonumber(raw:match("%d+"))
                if id and id > 0 then
                    local canonical = tostring(math.floor(id))
                    SkinState.ItemIds[index] = canonical
                    SkinState.ActiveItemIds[index] = canonical
                    if input then input.Text = canonical end
                else
                    SkinState.ItemIds[index] = ""
                    SkinState.ActiveItemIds[index] = nil
                end
            end
        end
    end

