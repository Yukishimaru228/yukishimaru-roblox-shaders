_G.YukiSoundPack = _G.YukiSoundPack or {
    Click = "", Hover = "", Page = "", Open = "", Close = "", Toggle = "", Success = "", Theme = "",
}

local UISFX = {}

do
    local CLICK_ID = "rbxassetid://113397864512278"
    local HOVER_ID = "rbxassetid://18856494234"
    local base = {
        Click   = {id = CLICK_ID, vol = 0.30, speed = 0.82, eq = {-2, -6, -22}, wet = -12},
        Hover   = {id = HOVER_ID, vol = 0.10, speed = 0.90, eq = {0, -4, -24},  wet = -16},
        Page    = {id = HOVER_ID, vol = 0.20, speed = 0.66, eq = {2, -6, -22},  wet = -9},
        Open    = {id = CLICK_ID, vol = 0.30, speed = 0.60, eq = {3, -6, -20},  wet = -8},
        Close   = {id = CLICK_ID, vol = 0.26, speed = 0.70, eq = {3, -6, -22},  wet = -9},
        Toggle  = {id = CLICK_ID, vol = 0.26, speed = 1.02, eq = {-2, -5, -22}, wet = -13},
        Success = {id = CLICK_ID, vol = 0.34, speed = 0.52, eq = {4, -5, -18},  wet = -5},
        Theme   = {id = HOVER_ID, vol = 0.24, speed = 0.58, eq = {3, -5, -20},  wet = -7},
    }
    local pack = _G.YukiSoundPack
    for kind, cfg in pairs(base) do
        local sound = Instance.new("Sound")
        sound.Name = "YukiUI_" .. kind
        sound.SoundId = cfg.id
        sound.Volume = cfg.vol
        sound.PlaybackSpeed = cfg.speed
        local eq = Instance.new("EqualizerSoundEffect")
        eq.LowGain, eq.MidGain, eq.HighGain = cfg.eq[1], cfg.eq[2], cfg.eq[3]
        eq.Parent = sound
        local rv = Instance.new("ReverbSoundEffect")
        rv.DecayTime, rv.Density, rv.Diffusion = 0.9, 0.8, 0.9
        rv.DryLevel, rv.WetLevel = -2, cfg.wet
        rv.Parent = sound
        sound:SetAttribute("BaseSpeed", cfg.speed)
        sound.Parent = SoundService
        UISFX[kind] = sound

        local custom = pack and pack[kind]
        if custom ~= nil and tostring(custom) ~= "" then
            local id = tostring(custom)
            if tonumber(id) then id = "rbxassetid://" .. id end
            sound.SoundId = id
            sound.PlaybackSpeed = 1
            sound.Volume = 0.5
            sound:SetAttribute("BaseSpeed", 1)
            for _, e in ipairs(sound:GetChildren()) do
                if e:IsA("SoundEffect") then e.Enabled = false end
            end
            task.spawn(function()
                pcall(function() game:GetService("ContentProvider"):PreloadAsync({sound}) end)
                if sound.TimeLength <= 0 then
                    sound.SoundId = cfg.id
                    sound.PlaybackSpeed = cfg.speed
                    sound.Volume = cfg.vol
                    sound:SetAttribute("BaseSpeed", cfg.speed)
                    for _, e in ipairs(sound:GetChildren()) do
                        if e:IsA("SoundEffect") then e.Enabled = true end
                    end
                end
            end)
        end
    end
end

local function PlayUISFX(kind)
    local sound = UISFX[kind]
    if not sound then
        return
    end
    local now = os.clock()
    local last = _G.YukiSfxLast
    if not last then
        last = {}
        _G.YukiSfxLast = last
    end
    if now - (last[kind] or 0) < 0.035 then
        return
    end
    last[kind] = now
    sound.PlaybackSpeed = (sound:GetAttribute("BaseSpeed") or 1) * (0.97 + math.random() * 0.06)
    sound.TimePosition = 0
    sound:Play()
end
_G.YukiPlaySfx = PlayUISFX

local function BindUISFX(button)
    if not button or not button:IsA("TextButton") then
        return
    end
    if button:GetAttribute("YukiSFXBound") then
        return
    end
    button:SetAttribute("YukiSFXBound", true)
    button.MouseEnter:Connect(function()
        PlayUISFX("Hover")
    end)
    button.MouseButton1Click:Connect(function()
        PlayUISFX("Click")
    end)
end

ScreenGui.DescendantAdded:Connect(function(obj)
    if obj:IsA("TextButton") then
        BindUISFX(obj)
    end
end)

