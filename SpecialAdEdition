    function _Yuki_CursorRenderPage()
        if not CursorState.Grid then
            return
        end

        CursorState.RenderToken = (CursorState.RenderToken or 0) + 1
        local token = CursorState.RenderToken

        _Yuki_CursorDestroyCards()

        local filtered = _Yuki_CursorFilteredList()

        if CursorState.StatusLabel then
            CursorState.StatusLabel.Text =
                "Current: " .. CursorState.CurrentName
                .. " • " .. tostring(#filtered)
                .. " shown / " .. tostring(#CursorState.Library)
                .. " loaded"
        end

        task.spawn(function()
            for index, data in ipairs(filtered) do
                if token ~= CursorState.RenderToken then
                    return
                end

                _Yuki_CursorCreateCard(data, index)

                if index % 50 == 0 then
                    task.wait()
                end
            end
        end)
    end

    function _Yuki_CursorLoadRemote()
        if CursorState.Loading then
            return
        end

        CursorState.Loading = true

        if CursorState.StatusLabel then
            CursorState.StatusLabel.Text =
                "Current: " .. CursorState.CurrentName
                .. " • Loading a larger 1500+ cursor catalog..."
        end

        task.spawn(function()
            local rebuilt = {}

            local function appendParsed(parsed)
                for _, data in ipairs(parsed or {}) do
                    table.insert(rebuilt, data)
                end
            end

            -- Primary source: all currently listed cursors.dev entries.
            do
                local ok, raw = pcall(function()
                    return game:HttpGet("https://cursors.dev/")
                end)

                if ok and type(raw) == "string" and #raw > 1000 then
                    local parseOk, parsed = pcall(_Yuki_CursorExtractLibrary, raw, "cursors.dev")
                    if parseOk then appendParsed(parsed) end
                end
            end

            -- Additional public catalogs. We keep the primary cursors.dev
            -- catalog first, then merge unique Image IDs from several lists.
            -- The current cursors.dev catalog is authoritative here.
            -- Older third-party lists are intentionally not merged because they
            -- often contain deleted/private Roblox assets.

            -- Optional extra sources are declared explicitly; an absent source
            -- table previously caused ipairs(nil) and left Loading stuck forever.
            local extraSources = CursorState.ExtraSources or {}
