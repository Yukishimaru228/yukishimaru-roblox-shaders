function _Yuki_MenuFx_Init2()
    local function skipObj(o)
        return CursorState.Grid ~= nil and o:IsDescendantOf(CursorState.Grid)
    end

    -- a) Depth: soft top-to-bottom shading on big panels.
    local gradCount = 0
    local function depth(f)
        if gradCount >= 500 or not f:IsA("Frame") or f:GetAttribute("YukiDepth") then return end
        if f == Main or f.Name:find("^Yuki") or f.Name:find("Bubble") or f.Name:find("Glow") then return end
        if f.BackgroundTransparency > 0.85 or f.AbsoluteSize.X < 120 or f.AbsoluteSize.Y < 36 then return end
        if not f:FindFirstChildOfClass("UICorner") or f:FindFirstChildOfClass("UIGradient") then return end
        if f:IsDescendantOf(BubbleLayer) or skipObj(f) then return end
        f:SetAttribute("YukiDepth", true)
        gradCount += 1
        local g = Instance.new("UIGradient")
        g.Name = "YukiDepth"
        g.Rotation = 90
        g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(194, 194, 205))
        g.Parent = f
    end

    -- b) Stroke glow on hover, c) focus glow on text fields.
    local function glow(obj)
        if skipObj(obj) then return end
        local st = obj:FindFirstChildOfClass("UIStroke")
        if not st or obj:GetAttribute("YukiGlow") then return end
        if obj:IsA("TextButton") then
            obj:SetAttribute("YukiGlow", true)
            local orig
            obj.MouseEnter:Connect(function()
                orig = {st.Thickness, st.Transparency}
                Tween(st, {Thickness = orig[1] + 0.9, Transparency = math.max(0, orig[2] - 0.35)}, 0.18)
            end)
            obj.MouseLeave:Connect(function()
                if orig then
                    Tween(st, {Thickness = orig[1], Transparency = orig[2]}, 0.25)
                    orig = nil
                end
            end)
        elseif obj:IsA("TextBox") then
            obj:SetAttribute("YukiGlow", true)
            local orig
            obj.Focused:Connect(function()
                orig = {st.Thickness, st.Transparency}
                Tween(st, {Thickness = orig[1] + 1.2, Transparency = 0}, 0.2)
            end)
            obj.FocusLost:Connect(function()
                if orig then
                    Tween(st, {Thickness = orig[1], Transparency = orig[2]}, 0.3)
                    orig = nil
                end
            end)
        end
    end

    local function decorate(obj)
        pcall(depth, obj)
        pcall(glow, obj)
    end
    for _, obj in ipairs(Main:GetDescendants()) do
        decorate(obj)
    end
    Connect(Main.DescendantAdded, function(obj)
        task.delay(0.15, function()
            if obj.Parent then decorate(obj) end
        end)
    end)

    -- d) Big soft light orbs drifting behind the content.
    local orbs = {}
    for i = 1, 4 do
        local orb = Instance.new("Frame")
        orb.Name = "YukiOrb" .. i
        orb.AnchorPoint = Vector2.new(0.5, 0.5)
        orb.Size = UDim2.fromOffset(220 + i * 40, 220 + i * 40)
        orb.BackgroundTransparency = 1
        orb.ZIndex = 1
        orb.Parent = BubbleLayer
        for layer = 1, 5 do
            local ring = Instance.new("Frame")
            ring.AnchorPoint = Vector2.new(0.5, 0.5)
            ring.Position = UDim2.fromScale(0.5, 0.5)
            ring.Size = UDim2.fromScale(1 - (layer - 1) * 0.18, 1 - (layer - 1) * 0.18)
            ring.BackgroundColor3 = Color3.fromRGB(235, 235, 255)
            ring.BackgroundTransparency = 0.975
            ring.BorderSizePixel = 0
            ring.ZIndex = 1
            ring.Parent = orb
            AddCorner(ring, 999)
        end
        orbs[i] = {frame = orb, sx = 0.25 + i * 0.11, sy = 0.19 + i * 0.07, px = i * 1.7, py = i * 2.3}
    end

    -- e) Light sheen that sweeps over the window now and then.
    local sheen = Instance.new("Frame")
    sheen.Name = "YukiSheen"
    sheen.AnchorPoint = Vector2.new(0.5, 0.5)
    sheen.Size = UDim2.new(0.16, 0, 1.6, 0)
    sheen.Position = UDim2.fromScale(-0.3, 0.5)
    sheen.Rotation = 18
    sheen.BackgroundColor3 = Color3.new(1, 1, 1)
    sheen.BackgroundTransparency = 0
    sheen.BorderSizePixel = 0
    sheen.ZIndex = 3
    sheen.Parent = BubbleLayer
    local sheenGradient = Instance.new("UIGradient")
    sheenGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.93),
        NumberSequenceKeypoint.new(1, 1),
    })
    sheenGradient.Parent = sheen
    task.spawn(function()
        task.wait(1.5)
        while Alive and sheen.Parent do
            if Main.Visible then
                sheen.Position = UDim2.fromScale(-0.3, 0.5)
                Tween(sheen, {Position = UDim2.fromScale(1.3, 0.5)}, 1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            end
            task.wait(7)
        end
    end)

    -- g) Accent colour slowly cycles through the border and the title.
    local border = Main:FindFirstChild("YukiFxBorder")
    local borderGradient = border and border:FindFirstChildOfClass("UIGradient")
    local titleGradient = HeaderTitle:FindFirstChildOfClass("UIGradient")
    local acc = 0
    Connect(RunService.RenderStepped, function(dt)
        if not Alive or not Main.Visible then return end
        local t = os.clock()
        for _, o in ipairs(orbs) do
            o.frame.Position = UDim2.fromScale(
                0.5 + math.sin(t * o.sx + o.px) * 0.42,
                0.5 + math.cos(t * o.sy + o.py) * 0.4
            )
        end
        acc += dt
        if acc >= 0.05 then
            acc = 0
            local h = (t * 0.03) % 1
            local c1 = Color3.fromHSV(h, 0.38, 1)
            local c2 = Color3.fromHSV((h + 0.5) % 1, 0.3, 1)
            local dark = Color3.fromRGB(30, 30, 36)
            if borderGradient then
                borderGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, dark),
                    ColorSequenceKeypoint.new(0.18, c1),
                    ColorSequenceKeypoint.new(0.4, dark),
                    ColorSequenceKeypoint.new(0.66, c2),
                    ColorSequenceKeypoint.new(0.85, dark),
                    ColorSequenceKeypoint.new(1, dark),
                })
            end
            if titleGradient then
                titleGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 150, 158)),
                    ColorSequenceKeypoint.new(0.5, c1:Lerp(Color3.new(1, 1, 1), 0.55)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 158)),
                })
            end
        end
    end)
end

