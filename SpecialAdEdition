function _Yuki_ThemesInit()
    local DEFAULT_LOGO = "rbxassetid://121442531968508"
    local THEMES = {
        {Name = "Default"},
        {Name = "Sakura", Hue = 0.94, Sat = 0.42},
        {Name = "Crimson", Hue = 0.99, Sat = 0.55},
        {Name = "Sunset", Hue = 0.06, Sat = 0.52},
        {Name = "Gold", Hue = 0.12, Sat = 0.50},
        {Name = "Emerald", Hue = 0.38, Sat = 0.46},
        {Name = "Teal", Hue = 0.48, Sat = 0.46},
        {Name = "Ocean", Hue = 0.58, Sat = 0.52},
        {Name = "Midnight", Hue = 0.65, Sat = 0.56},
        {Name = "Amethyst", Hue = 0.76, Sat = 0.50},
        {Name = "Neon", Hue = 0.87, Sat = 0.62},
    }
    local byName = {}
    for _, t in ipairs(THEMES) do
        byName[t.Name] = t
        t.Accent = t.Hue and Color3.fromHSV(t.Hue, 0.5, 1) or Color3.fromRGB(235, 235, 242)
    end
    _G.YukiThemes = THEMES
    local FILE = "YukiTheme.txt"
    local current = THEMES[1]

    -- grey -> tinted grey. Depends only on brightness, so it is idempotent.
    local function T(c)
        local th = _G.YukiTheme
        if not th or not th.Hue then return c end
        local _, sat, v = c:ToHSV()
        if sat > 0.14 then return c end
        return Color3.fromHSV(th.Hue, th.Sat * (1 - 0.62 * v), v)
    end
    _G.YukiThemeColor = T

    local reg = setmetatable({}, {__mode = "k"})
    local gradReg = setmetatable({}, {__mode = "k"})

    local function propsFor(o)
        if o:IsA("UIStroke") then return {"Color"} end
        if not o:IsA("GuiObject") then return nil end
        local list = {"BackgroundColor3"}
        if o:IsA("TextLabel") or o:IsA("TextButton") then
            list[2] = "TextColor3"
        elseif o:IsA("TextBox") then
            list[2] = "TextColor3"
            list[3] = "PlaceholderColor3"
        end
        if o:IsA("ScrollingFrame") then list[#list + 1] = "ScrollBarImageColor3" end
        return list
    end

    local function register(o)
        if reg[o] or gradReg[o] then return end
        if o:GetAttribute("YukiNoTheme") then return end
        if CursorState.Grid and o:IsDescendantOf(CursorState.Grid) then return end
        if o:IsA("UIGradient") then
            gradReg[o] = {base = o.Color}
            return
        end
        local props = propsFor(o)
        if not props then return end
        local rec = {}
        for _, p in ipairs(props) do
            local ok, v = pcall(function() return o[p] end)
            if ok and typeof(v) == "Color3" then rec[p] = {base = v, applied = v} end
        end
        reg[o] = rec
    end

    local function tintSequence(seq)
        local pts = {}
        for _, kp in ipairs(seq.Keypoints) do
            pts[#pts + 1] = ColorSequenceKeypoint.new(kp.Time, T(kp.Value))
        end
        return ColorSequence.new(pts)
    end

    -- tweens made by the script itself are converted too, so nothing "pops" grey
    _G.YukiThemeTween = function(object, props)
        local th = _G.YukiTheme
        if not th or not th.Hue then return props end
        local out
        for k, v in pairs(props) do
            if typeof(v) == "Color3" and (k == "BackgroundColor3" or k == "TextColor3" or k == "Color"
                or k == "PlaceholderColor3" or k == "ScrollBarImageColor3") then
                out = out or table.clone(props)
                local nv = T(v)
                out[k] = nv
                local rec = reg[object]
                if rec and rec[k] then
                    rec[k].base = v
                    rec[k].applied = nv
                end
            end
        end
        return out or props
    end

    local function applyAll()
        for o, rec in pairs(reg) do
            if o.Parent then
                for p, r in pairs(rec) do
                    local cur = o[p]
                    if cur ~= r.applied then r.base = cur end
                    local new = T(r.base)
                    if new ~= cur then o[p] = new end
                    r.applied = new
                end
            end
        end
        for g, r in pairs(gradReg) do
            if g.Parent then g.Color = tintSequence(r.base) end
        end
    end

    local function logoId(theme)
        local id = _G.YukiThemeLogos and _G.YukiThemeLogos[theme.Name]
        if id ~= nil and tostring(id) ~= "" then
            id = tostring(id)
            if tonumber(id) then id = "rbxassetid://" .. id end
            return id
        end
        return nil
    end
    _G.YukiThemeLogoFor = function() return logoId(current) end
    _G.YukiThemeInfo = function() return current.Hue and current or nil end

    local function applyLogo(theme)
        local id = logoId(theme) or DEFAULT_LOGO
        pcall(function() HeaderImage.Image = id end)
        pcall(function()
            if _G.YukiMobileUI and _G.YukiMobileUI.Button then _G.YukiMobileUI.Button.Image = id end
        end)
    end

    local function setTheme(theme)
        current = theme
        _G.YukiTheme = theme.Hue and theme or nil
        applyAll()
        applyLogo(theme)
        pcall(function()
            if writefile then writefile(FILE, theme.Name) end
        end)
    end

    -- sweep: catches colours that the script assigns directly after theming
    local list, cursor = {}, 1
    Connect(RunService.Heartbeat, function()
        if not Alive or not _G.YukiTheme then return end
        if cursor > #list then
            list = {}
            for o in pairs(reg) do
                if o.Parent then list[#list + 1] = o end
            end
            cursor = 1
            return
        end
        for _ = 1, 300 do
            local o = list[cursor]
            if not o then break end
            cursor += 1
            local rec = reg[o]
            if rec and o.Parent then
                for p, r in pairs(rec) do
                    local cur = o[p]
                    if cur ~= r.applied then
                        local _, sat = cur:ToHSV()
                        if sat <= 0.14 then
                            r.base = cur
                            local new = T(cur)
                            r.applied = new
                            if new ~= cur then o[p] = new end
                        end
                    end
                end
            end
        end
    end)

    for _, o in ipairs(ScreenGui:GetDescendants()) do register(o) end
    Connect(ScreenGui.DescendantAdded, function(o)
        task.defer(function()
            if not o.Parent then return end
            register(o)
            local th = _G.YukiTheme
            if th and (reg[o] or gradReg[o]) then
                local rec = reg[o]
                if rec then
                    for p, r in pairs(rec) do
                        local new = T(r.base)
                        if new ~= r.base then o[p] = new end
                        r.applied = new
                    end
                end
                if gradReg[o] then o.Color = tintSequence(gradReg[o].base) end
            end
        end)
    end)

    ------------------------------------------------------------------
    -- theme picker (button in the header + animated popup)
    ------------------------------------------------------------------
    local function nt(o) o:SetAttribute("YukiNoTheme", true) return o end

    local themeButton = Instance.new("TextButton")
