        ----------------------------------------------------------------
        -- CAR BUILD
        ----------------------------------------------------------------
        local function buildCar(cfg, tmpl, hrp)
            local model = tmpl.Model:Clone()
            model.Name = "YukiCar"

            local k = CarFix[cfg.id] or 0
            local dir = CFrame.Angles(0, math.rad(90 * k), 0):VectorToWorldSpace(tmpl.Forward)
            local pivotPos = model:GetPivot().Position
            local frame = CFrame.lookAt(pivotPos, pivotPos + dir)
            local minV, maxV = measure(model, frame, true)
            local size = maxV - minV
            local rootCF = frame * CFrame.new((minV + maxV) / 2)

            local root = new("Part", {
                Name = "Root",
                Size = Vector3.new(math.max(size.X * 0.8, 2), math.max(size.Y * 0.45, 1), math.max(size.Z * 0.85, 3)),
                Transparency = 1,
                CanCollide = true,
                CanTouch = false,
                Anchored = true,
                CFrame = rootCF,
                CustomPhysicalProperties = PhysicalProperties.new(1.5, 0, 0.05, 100, 1),
            }, model)

            -- Where the driver sits (root space)
            local driverLocal
            local seat = nil
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") and d:GetAttribute("YukiSeat") then
                    seat = d
                    break
                end
            end
            if seat then
                local top = seat.Position + seat.CFrame.UpVector * (seat.Size.Y / 2 + 1.45)
                driverLocal = rootCF:PointToObjectSpace(top)
            else
                driverLocal = Vector3.new(0, -size.Y / 2 + size.Y * 0.35 + 1.4, size.Z * 0.04)
            end

            -- Rigidly weld every visual part to the root
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") and d ~= root then
                    new("Weld", {
                        Part0 = root,
                        Part1 = d,
                        C0 = rootCF:Inverse() * d.CFrame,
                        C1 = CFrame.new(),
                    }, d)
                end
            end

            local orientAtt = new("Attachment", {Name = "OrientAtt"}, root)
            local align = new("AlignOrientation", {
                Mode = Enum.OrientationAlignmentMode.OneAttachment,
                Attachment0 = orientAtt,
                RigidityEnabled = false,
                MaxTorque = math.huge,
                MaxAngularVelocity = math.huge,
                Responsiveness = 30,
                CFrame = rootCF.Rotation,
            }, root)

            -- Tyre smoke (Realistic Smoke asset), not for the Flying Car
            local emitters = {}
            if cfg.smoke and SmokeTemplates then
                for _, side in ipairs({-1, 1}) do
                    local att = new("Attachment", {
                        Name = "SmokeAtt",
                        Position = Vector3.new(size.X * 0.32 * side, -size.Y / 2 + 0.5, size.Z / 2 - size.Z * 0.1),
                    }, root)
                    for _, template in ipairs(SmokeTemplates) do
                        local e = template:Clone()
                        e.Enabled = false
                        e.Parent = att
                        table.insert(emitters, {E = e, Base = template.Rate})
                    end
                end
            end

            local prompt = new("ProximityPrompt", {
                ObjectText = cfg.name,
                ActionText = "Drive",
                KeyboardKeyCode = Enum.KeyCode.E,
                MaxActivationDistance = 11,
                HoldDuration = 0,
                RequiresLineOfSight = false,
                Enabled = false,
            }, root)
            prompt.Triggered:Connect(function()
                if Car and Car.Root == root then
                    enterCar()
                end
            end)

            -- Place the car in front of the player, on the ground
            local look = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
            if look.Magnitude < 0.1 then
                look = Vector3.new(0, 0, -1)
            end
            look = look.Unit

            local char = LocalPlayer.Character
            local filter = {model}
            if char then
                table.insert(filter, char)
            end
            local ray = RaycastParams.new()
            ray.FilterType = Enum.RaycastFilterType.Exclude
            ray.IgnoreWater = true
            ray.FilterDescendantsInstances = filter

            local spawnPos = hrp.Position + look * (size.Z / 2 + 5)
            local g = Workspace:Raycast(spawnPos + Vector3.new(0, 30, 0), Vector3.new(0, -120, 0), ray)
            local groundY = g and g.Position.Y or (hrp.Position.Y - 3)
            local center = Vector3.new(spawnPos.X, groundY + size.Y / 2 + 0.2, spawnPos.Z)

            model.PrimaryPart = root
            model:PivotTo(CFrame.lookAt(center, center + look))
            model.Parent = Workspace
            root.Anchored = false

            return {
                Cfg = cfg,
                Id = cfg.id,
                Model = model,
                Root = root,
                Align = align,
                Prompt = prompt,
                Weld = nil,
                Occupied = false,
                Yaw = math.atan2(-look.X, -look.Z),
                Up = Vector3.yAxis,
                Hold = false,
                Down = false,
                DriverLocal = driverLocal,
                Lift = CarLift[cfg.id] or 0,
                Size = size,
                RootToBottom = size.Y / 2,
                Emitters = emitters,
                Speed = 0,
                Ray = ray,
                CharParts = {},
                CharCollide = {},
                SafeT = 0,
                LastSafe = center,
            }
        end

        enterCar = function()
            local car = Car
            if not car or car.Occupied then
                return
            end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp or hum.Health <= 0 then
                return
            end

            car.CharParts = {}
            car.CharCollide = {}
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then
                    table.insert(car.CharParts, d)
                    car.CharCollide[d] = d.CanCollide
                end
            end
            car.Ray.FilterDescendantsInstances = {car.Model, char}

            ensureControls()

            local offset = car.DriverLocal + Vector3.new(0, car.Lift, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = car.Root.CFrame * CFrame.new(offset)
            car.Weld = new("Weld", {
                Name = "YukiDriverWeld",
                Part0 = car.Root,
                Part1 = hrp,
                C0 = CFrame.new(offset),
                C1 = CFrame.new(),
            }, car.Root)

            car.Occupied = true
            car.Hold = false
            car.Down = false
            hum.Sit = true
            if car.Prompt then
                car.Prompt.Enabled = false
            end

            bindDrive()
            ensureHud()
            showHud(true, car.Cfg)
            setCarStatus("Driving: " .. car.Cfg.name)
            refreshCarButtons()
        end

        exitCar = function()
            local car = Car
            if not car or not car.Occupied then
                return
            end
            car.Occupied = false
            car.Hold = false
            car.Down = false
            if car.Weld then
                pcall(function()
                    car.Weld:Destroy()
                end)
                car.Weld = nil
            end
            unbindDrive()
            showHud(false)

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            for part, original in pairs(car.CharCollide) do
                if part.Parent then
                    part.CanCollide = original
                end
            end

            if hum then
                hum.Sit = false
            end
            if hrp and car.Root.Parent then
                local side = car.Root.CFrame:PointToWorldSpace(Vector3.new(-(car.Size.X / 2 + 3), 0, 0))
                local ground = Workspace:Raycast(side + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), car.Ray)
                local place = ground and (ground.Position + Vector3.new(0, 3.2, 0)) or (side + Vector3.new(0, 4, 0))
                local look = Vector3.new(-math.sin(car.Yaw), 0, -math.cos(car.Yaw))
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = CFrame.lookAt(place, place + look)
            end
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                local cameraNow = Workspace.CurrentCamera
                if cameraNow then
                    cameraNow.CameraType = Enum.CameraType.Custom
                    cameraNow.CameraSubject = hum
                end
            end

            -- Vehicle seating can leave Roblox's camera mouse in LockCenter.
            -- Release it over several render frames so the default camera script
            -- cannot immediately re-apply the seated state after we exit.
            task.spawn(function()
                for _ = 1, 5 do
                    RunService.RenderStepped:Wait()
                    if not Alive or (Car and Car.Occupied) then
                        break
                    end
                    local rightMouseHeld = false
                    pcall(function()
                        rightMouseHeld = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                    end)
                    if not rightMouseHeld then
                        pcall(function()
                            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                        end)
                    end
                    if CursorState.CurrentData then
                        pcall(function()
                            UserInputService.MouseIconEnabled = false
                            if _Yuki_CursorEnsureOverlay then _Yuki_CursorEnsureOverlay() end
                            if CursorState.OverlayImage then
                                CursorState.OverlayImage.Visible = true
                            end
                        end)
                    else
                        pcall(function()
                            UserInputService.MouseIconEnabled = true
                        end)
                    end
                end
            end)

            if car.Prompt then
                car.Prompt.Enabled = true
            end
            setCarStatus("Parked: " .. car.Cfg.name .. " - press E near it or use Get in car")
            refreshCarButtons()
        end

