    function _Yuki_CursorDecodeHtml(value)
        value = value:gsub("&amp;", "&")
        value = value:gsub("&quot;", "\"")
        value = value:gsub("&#39;", "'")
        value = value:gsub("&lt;", "<")
        value = value:gsub("&gt;", ">")
        return value
    end

    function _Yuki_CursorTrim(value)
        value = value:gsub("^%s+", ""):gsub("%s+$", "")
        value = value:gsub("%s+", " ")
        return value
    end

    function _Yuki_CursorLooksValid(name, imageId)
        if not imageId or imageId == "" then
            return false
        end

        local lower = string.lower(name or "")
        if lower == "" then
            return false
        end

        if lower == "image"
            or lower == "image id"
            or lower == "decal"
            or lower == "decal id"
            or lower == "search cursors" then
            return false
        end

        return true
    end

    function _Yuki_CursorAddUnique(name, author, imageId, decalId, hint)
        if not imageId or imageId == "" then
            return
        end

        CursorState._Seen = CursorState._Seen or {}
        if CursorState._Seen[imageId] then
            return
        end

        if not _Yuki_CursorLooksValid(name, imageId) then
            return
        end

        CursorState._Seen[imageId] = true

        local isTrending =
            (type(hint) == "table" and hint.Trending == true)
            or (imageId == "11726322336")

        local resolvedHint = hint
        local source = "cursors.dev"

        if type(hint) == "table" then
            resolvedHint = hint.Hint or hint.Name or name
            source = hint.Source or source
        end

        table.insert(CursorState.Library, {
            Name = _Yuki_CursorTrim(name),
            Author = _Yuki_CursorTrim(author or "cursors.dev"),
            ImageId = tostring(imageId),
            DecalId = decalId and tostring(decalId) or nil,
            Hint = string.lower(tostring(resolvedHint or (name or ""))),
            Trending = isTrending,
            Source = source,
        })
    end

    function _Yuki_CursorExtractLibrary(raw, sourceName)
        local found = {}

        local function decode(value)
            value = value or ""
            value = value:gsub("&amp;", "&")
            value = value:gsub("&quot;", "\"")
            value = value:gsub("&#39;", "'")
            value = value:gsub("&lt;", "<")
            value = value:gsub("&gt;", ">")
            return value
        end

        local function clean(value)
            value = decode(value)
            value = value:gsub("^%s+", ""):gsub("%s+$", "")
            value = value:gsub("%s+", " ")
            return value
        end

        local function push(name, author, imageId, decalId, trending, hint)
            if not imageId then
                return
            end

            name = clean(name)
            author = clean(author or sourceName or "External")
            imageId = tostring(imageId)
            decalId = decalId and tostring(decalId) or nil

            if name == "" then
                name = "Cursor " .. imageId
            end

            table.insert(found, {
                Name = name,
                Author = author,
                ImageId = imageId,
                DecalId = decalId,
                Hint = string.lower(tostring(hint or name)),
                Trending = trending == true,
                Source = sourceName or "External"
            })
        end

        -- Embedded data pass.
        for name, author, imageId, decalId in raw:gmatch(
            '"name"%s*:%s*"([^"]-)"[^}]-"author"%s*:%s*"([^"]-)"[^}]-"imageId"%s*:%s*(%d+)[^}]-"decalId"%s*:%s*(%d+)'
        ) do
            push(name, author, imageId, decalId, false, name)
        end

        -- Convert closing tags into line boundaries. This makes both
        -- cursors.dev cards and external catalog cards much easier to parse.
        local plain = raw
        plain = plain:gsub("<script.-</script>", "\n")
        plain = plain:gsub("<style.-</style>", "\n")
        plain = plain:gsub("</[^>]+>", "\n")
        plain = plain:gsub("<br%s*/?>", "\n")
        plain = plain:gsub("<[^>]->", " ")
        plain = decode(plain)
        plain = plain:gsub("\r", "\n")
        plain = plain:gsub("[ \t]+", " ")

        local lines = {}
        for line in plain:gmatch("[^\n]+") do
            line = clean(line)
            if line ~= "" then
                table.insert(lines, line)
            end
        end

        local pendingTrending = false

        for i, line in ipairs(lines) do
            if string.lower(line) == "trending" then
                pendingTrending = true
            end

            local author = line:match("^by%s+(.+)$")
            if author then
                local name = lines[i - 1]
                local imageLine = lines[i + 1] or ""

                local imageId, decalId =
                    imageLine:match("Image%s+(%d+)%s+Decal%s+(%d+)")

                if name and imageId then
                    local lowerName = string.lower(name)
                    if lowerName ~= "dot"
                        and lowerName ~= "circle"
                        and lowerName ~= "crosshair"
                        and lowerName ~= "misc"
                        and lowerName ~= "trending" then

                        push(
                            name:gsub("^##%s*", ""),
                            author,
                            imageId,
                            decalId,
                            pendingTrending,
                            name
                        )

                        pendingTrending = false
                    end
                end
            end

            -- External sites such as UrGameTips expose "ID N" without a
            -- separate author. Use the title two lines above that ID.
            local onlyId = line:match("^ID%s+(%d+)$")
            if onlyId then
                local name = lines[i - 2]
                if name then
                    name = name:gsub("^##%s*", "")
                    local lowerName = string.lower(name)
                    if lowerName ~= "crosshair"
                        and lowerName ~= "cursor"
                        and lowerName ~= "image"
                        and lowerName ~= "copy id" then

                        push(name, sourceName or "External", onlyId, nil, false, name)
                    end
                end
            end
        end

        return found
    end

    function _Yuki_CursorGetVisualSize(data)
        local hint = string.lower((data.Name or "") .. " " .. (data.Hint or ""))

        -- Normal cursors are deliberately larger than the previous 32px pass.
        -- Small/dot assets stay readable, while oversized assets are still capped.
        if hint:find("gigantic", 1, true)
            or hint:find("massive", 1, true)
            or hint:find("ultra big", 1, true) then
            return 38
        elseif hint:find("huge", 1, true)
            or hint:find("oversized", 1, true)
            or hint:find("giant", 1, true) then
            return 42
        elseif hint:find("big", 1, true)
            or hint:find("large", 1, true) then
            return 46
        elseif hint:find("tiny", 1, true)
            or hint:find("4px", 1, true)
            or hint:find("6x6", 1, true)
            or hint:find("8px", 1, true) then
            return 34
        elseif hint:find("small", 1, true)
            or hint:find("mini", 1, true)
            or hint:find("micro", 1, true) then
            return 40
        elseif data.ImageId == "11726322336" then
            return 52
        end

        return 50
    end

    function _Yuki_CursorEnsureOverlay()
        if not CursorState.IsPC then
            return
        end

        if CursorState.OverlayGui and CursorState.OverlayGui.Parent
            and CursorState.OverlayImage and CursorState.OverlayImage.Parent then
            return
        end

        if CursorState.OverlayConnection then
            pcall(function()
                CursorState.OverlayConnection:Disconnect()
            end)
            CursorState.OverlayConnection = nil
        end

        local gui = Instance.new("ScreenGui")
        gui.Name = "YukiCursorOverlay"
        gui.IgnoreGuiInset = true
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 999999
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        pcall(function()
            if syn and syn.protect_gui then
                syn.protect_gui(gui)
            end
        end)

        gui.Parent = CoreGui

        local image = Instance.new("ImageLabel")
        image.Name = "Cursor"
        image.AnchorPoint = Vector2.new(0.5, 0.5)
        image.Position = UDim2.fromOffset(0, 0)
        image.Size = UDim2.fromOffset(32, 32)
        image.BackgroundTransparency = 1
        image.BorderSizePixel = 0
        image.ImageTransparency = 0
        image.ScaleType = Enum.ScaleType.Fit
        image.ZIndex = 100
        image.Active = false
        image.Selectable = false
        image.Parent = gui

        CursorState.OverlayGui = gui
        CursorState.OverlayImage = image

        -- V21: zero-extra-latency follow. The position is written (1) the moment
        -- the mouse input arrives and (2) again at the very LAST render priority,
        -- right before the frame is drawn, so no other per-frame script can push
        -- the cursor a frame behind the real mouse.
        local function followMouse()
            local img = CursorState.OverlayImage
            if not img or not img.Parent then
                return
            end
            local p = UserInputService:GetMouseLocation()
            img.Position = UDim2.fromOffset(p.X, p.Y)
        end

        local bindName = "YukiCursorFollow"
        pcall(function() RunService:UnbindFromRenderStep(bindName) end)
        RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value, followMouse)
        local inputConn = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                followMouse()
            end
        end)
        followMouse()

        CursorState.OverlayConnection = {
            Disconnect = function()
                pcall(function() RunService:UnbindFromRenderStep(bindName) end)
                pcall(function() inputConn:Disconnect() end)
            end,
        }
    end

    function _Yuki_CursorApplySize()
        if not CursorState.OverlayImage then
            return
        end

        local size = math.clamp(
            tonumber(CursorState.Size) or 50,
            CursorState.SizeMin or 24,
            CursorState.SizeMax or 72
        )

        CursorState.OverlayImage.Size = UDim2.fromOffset(size, size)
    end

    function _Yuki_CursorShow(data)
        if not CursorState.IsPC then
            return
        end

        _Yuki_CursorEnsureOverlay()

        if not CursorState.OverlayImage then
            return
        end

        local ok = pcall(function()
            CursorState.Mouse.Icon = ""
            UserInputService.MouseIconEnabled = false
        end)

        if not ok then
            return
        end

        CursorState.OverlayImage.Image = "rbxassetid://" .. tostring(data.ImageId)
        _Yuki_CursorApplySize()
        CursorState.OverlayImage.Visible = true
    end

    function _Yuki_CursorHideOverlay()
        if CursorState.OverlayImage then
            CursorState.OverlayImage.Visible = false
        end
    end

    function _Yuki_CursorResetSystem()
        _Yuki_CursorHideOverlay()
        pcall(function()
            CursorState.Mouse.Icon = CursorState.OriginalMouseIcon
            UserInputService.MouseIconEnabled = true
        end)
    end

