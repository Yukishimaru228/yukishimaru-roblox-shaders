local function SetCollapsed(
    state
)
    if not Alive then
        return
    end

    if Collapsed ==
        state then
        return
    end

    Collapsed =
        state

    -- Main menu uses scale-based motion so the internal layout never collapses.
    if not _G.YukiMainScale or not _G.YukiMainScale.Parent then
        _G.YukiMainScale = Instance.new("UIScale")
        _G.YukiMainScale.Name = "YukiMainScale"
        _G.YukiMainScale.Scale = 1
        _G.YukiMainScale.Parent = Main
    end

    local scale = _G.YukiMainScale
    _G.YukiDragTarget = nil

    if state then
        -- V24: the window "sucks" into a point, tilting and dropping away.
        SavedPosition = Main.Position
        pcall(PlayUISFX, "Close")
        local p = SavedPosition
        Tween(scale, {Scale = 0.04}, 0.46, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        Tween(Main, {
            Rotation = 8,
            Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + 110),
        }, 0.46, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

        task.delay(0.44, function()
            if not Alive or not Collapsed then
                return
            end
            Main.Visible = false
            Main.Rotation = 0
            Main.Position = SavedPosition
            if _G.YukiMobileUI and _G.YukiMobileUI.IsMobile and _G.YukiMobileUI.Button then
                _G.YukiMobileUI.Button.Visible = true
                if _G.YukiMobileUI.Scale then
                    _G.YukiMobileUI.Scale.Scale = 0.72
                    Tween(_G.YukiMobileUI.Scale, {Scale = 1}, 0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end
            end
        end)
    else
        -- V24: springs back out of that point with an overshoot.
        local p = SavedPosition
        Main.Visible = true
        Main.Rotation = -8
        Main.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + 110)
        scale.Scale = 0.04
        pcall(PlayUISFX, "Open")

        if _G.YukiMobileUI and _G.YukiMobileUI.Button then
            _G.YukiMobileUI.Button.Visible = false
        end

        Tween(scale, {Scale = 1}, 0.72, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        Tween(Main, {Rotation = 0, Position = p}, 0.66, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        if _G.YukiMenuBurst then
            task.delay(0.25, _G.YukiMenuBurst)
        end
    end
end

_G.YukiSetCollapsed = SetCollapsed

