function _Yuki_MenuAnim_Init()
    -- soft burst of bubbles from the window centre (used when it expands)
    _G.YukiMenuBurst = function()
        if not BubbleLayer or not BubbleLayer.Parent then return end
        local size = BubbleLayer.AbsoluteSize
        local cx, cy = size.X / 2, size.Y / 2
        for _ = 1, 18 do
            local d = RNG:NextNumber(5, 12)
