    local effect =
        Effects.ColorCorrection

    if not effect then
        return
    end

    effect.Saturation =
        ShaderState.Saturation

    effect.Brightness =
        ShaderState.Brightness

    effect.Contrast =
        ShaderState.Contrast
end

function _Yuki_UpdateBlur()
    local effect =
        Effects.Blur

    if not effect then
