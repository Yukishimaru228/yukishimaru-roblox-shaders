--============================================================
-- EXTRA MAP-ANCHORED 3D EFFECTS
--============================================================
-- These effects sample the discovered map surface instead of only spawning
-- beside the character. When the player moves far enough (or streaming loads
-- a new area), AddWorldEffect rebuilds them so the effect field never gets
-- stranded far behind the player.

local World3D = {}

local function WorldFolder(name)
    local folder = Workspace:FindFirstChild("Yuki3D_" .. name)
    if folder then
        folder:Destroy()
    end
    folder = Instance.new("Folder")
    folder.Name = "Yuki3D_" .. name
    folder.Parent = Workspace
    return folder
end

local MapBoundsCache = nil
local MapBoundsBuiltAt = 0

local function GetMapBounds()
    local now = os.clock()
    if MapBoundsCache and now - MapBoundsBuiltAt < 6 then
        return MapBoundsCache
    end

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local found = false

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart")
            and obj.Anchored
            and obj.Transparency < 1
            and not obj:IsDescendantOf(LocalPlayer.Character)
            and not obj.Name:match("^Yuki")
            and not obj.Name:match("^RainEffect")
            and not obj.Name:match("^PortalVisual_") then
            local p = obj.Position
            local s = obj.Size * 0.5
            minX = math.min(minX, p.X - s.X)
            minY = math.min(minY, p.Y - s.Y)
            minZ = math.min(minZ, p.Z - s.Z)
            maxX = math.max(maxX, p.X + s.X)
            maxY = math.max(maxY, p.Y + s.Y)
            maxZ = math.max(maxZ, p.Z + s.Z)
            found = true
        end
    end

    if not found then
        MapBoundsCache = nil
        return nil
    end

    MapBoundsCache = {
        Min = Vector3.new(minX, minY, minZ),
        Max = Vector3.new(maxX, maxY, maxZ)
    }
    MapBoundsBuiltAt = now
    return MapBoundsCache
end

local function GroundPoint(origin, offset, height)
    -- V22: placement is relative to the camera field, never the whole map.
    local c = World3D.Center or origin
    local m = math.max(math.abs(offset.X), math.abs(offset.Y), 1)
    local k = m > 100 and (70 / m) or 0.62
    local x = c.X + offset.X * k
    local z = c.Z + offset.Y * k
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true
    local result = Workspace:Raycast(Vector3.new(x, c.Y + 30, z), Vector3.new(0, -220, 0), params)
    if result then
        return result.Position + Vector3.new(0, 0.12, 0)
    end
    return Vector3.new(x, c.Y, z)
end

local function Make3DPart(parent, size, color, material)
    local part = Instance.new("Part")
    part.Size = size
    part.Color = color
    part.Material = material or Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

local function AddWorldEffect(name, create, update, interval)
    local running = false
    local folder = nil
    local objects = {}
    local heartbeat = nil
    local lastCenter = nil
    local rebuildClock = 0
    local fadeIn = nil
    local fadeOuts = {}
    local FADE_TIME = 1.0

    local function snapshot(f)
        local snap = {}
        for _, d in ipairs(f:GetDescendants()) do
            if d:IsA("BasePart") then
                snap[#snap + 1] = {d, "Transparency", d.Transparency}
            elseif d:IsA("Light") then
                snap[#snap + 1] = {d, "Brightness", d.Brightness}
            elseif d:IsA("Beam") or d:IsA("Trail") or d:IsA("ParticleEmitter") then
                snap[#snap + 1] = {d, "Enabled", d.Enabled}
            end
        end
        return snap
    end

    local function applyAlpha(snap, alpha)
        for _, e in ipairs(snap) do
            local inst, prop, orig = e[1], e[2], e[3]
            if inst.Parent then
                if prop == "Transparency" then
                    inst.Transparency = 1 - (1 - orig) * alpha
                elseif prop == "Brightness" then
                    inst.Brightness = orig * alpha
                else
                    inst.Enabled = orig and alpha >= 0.5
                end
            end
        end
    end

    local function spawnField()
        lastCenter = Yuki_CameraCenter(0)
        World3D.Center = Yuki_CameraCenter(22)
        objects = create(folder)
        fadeIn = {snap = snapshot(folder), t = 0}
        applyAlpha(fadeIn.snap, 0)
    end

    -- Old field fades out while a fresh one fades in around the camera.
    local function rebuild()
        if not running then
            return
        end
        if fadeIn then
            applyAlpha(fadeIn.snap, 1)
            fadeIn = nil
        end
        if folder then
            folder.Name = "Yuki3D_" .. name .. "_old"
            fadeOuts[#fadeOuts + 1] = {folder = folder, snap = snapshot(folder), t = 0}
        end
        folder = Instance.new("Folder")
        folder.Name = "Yuki3D_" .. name
        folder.Parent = Workspace
        spawnField()
    end

    local function disable()
        running = false
        if heartbeat then
            heartbeat:Disconnect()
            heartbeat = nil
        end
        if folder then
            folder:Destroy()
            folder = nil
        end
        for _, f in ipairs(fadeOuts) do
            if f.folder then f.folder:Destroy() end
        end
        table.clear(fadeOuts)
        fadeIn = nil
        table.clear(objects)
        lastCenter = nil
    end

    local function enable()
        if running then
            return
        end
        running = true
        folder = WorldFolder(name)
        spawnField()
        local elapsed = 0

        heartbeat = RunService.Heartbeat:Connect(function(dt)
            if not running then
                return
            end

            rebuildClock = rebuildClock + dt
            if lastCenter and rebuildClock >= 1.0
                and (Yuki_CameraCenter(0) - lastCenter).Magnitude >= 30 then
                rebuildClock = 0
                rebuild()
            end

            elapsed = elapsed + dt
            if elapsed >= (interval or 0.033) then
                local step = elapsed
                elapsed = 0
                pcall(update, objects, step, os.clock())
            end

            if fadeIn then
                fadeIn.t = fadeIn.t + dt
                local a = math.min(fadeIn.t / FADE_TIME, 1)
                applyAlpha(fadeIn.snap, a * a * (3 - 2 * a))
                if fadeIn.t >= FADE_TIME then
                    fadeIn = nil
                end
            end
            for i = #fadeOuts, 1, -1 do
                local f = fadeOuts[i]
                f.t = f.t + dt
                local a = 1 - math.min(f.t / FADE_TIME, 1)
                applyAlpha(f.snap, a * a * (3 - 2 * a))
                if f.t >= FADE_TIME then
                    if f.folder then f.folder:Destroy() end
                    table.remove(fadeOuts, i)
                end
            end
        end)
    end

    _G.PortalVisuals._enableFuncs[name] = enable
    _G.PortalVisuals._disableFuncs[name] = disable
end

