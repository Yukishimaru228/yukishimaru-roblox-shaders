    function _Yuki_CursorFilteredList()
        local query = string.lower(_Yuki_CursorTrim(CursorState.Query or ""))
        CursorState.Filtered = {}

        for _, data in ipairs(CursorState.Library or {}) do
            if query == ""
                or string.find(string.lower(data.Name or ""), query, 1, true)
                or string.find(string.lower(data.Author or ""), query, 1, true)
                or string.find(string.lower(data.Hint or ""), query, 1, true) then
                table.insert(CursorState.Filtered, data)
            end
        end

        return CursorState.Filtered
    end

