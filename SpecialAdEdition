    if SkinState.SkinColorButton then
        Connect(SkinState.SkinColorButton.MouseButton1Click, function()
            local uiRef = _G.YukiAvatarModifiersUI
            local list = uiRef and uiRef.SkinColors or {}
            if #list == 0 then return end
            uiRef.SkinColorIndex = (uiRef.SkinColorIndex % #list) + 1
            local selected = list[uiRef.SkinColorIndex]
            SkinState.SkinColorName = selected.Name
            SkinState.SkinColorButton.Text = selected.Name
            if SkinState.RebuildCurrentSkin then SkinState.RebuildCurrentSkin() end
        end)
    end

    SkinState.ApplyItemInputs = function(rebuild)
        local valid, invalid = 0, 0
        SkinSyncItemStateFromUI()
        for index = 1, 30 do
            local input = SkinState.ItemInputs[index]
            if SkinState.ItemIds[index] ~= "" then
                valid += 1
            elseif input and SkinTrim(input.Text) ~= "" then
                invalid += 1
            end
        end
        SkinSetItemStatus(string.format("Принято Asset ID: %d/20%s", valid, invalid > 0 and (" • неверных полей: "..tostring(invalid)) or ""), invalid > 0 and Color3.fromRGB(255, 185, 150) or Color3.fromRGB(180, 230, 190))
        if rebuild then SkinState.RebuildCurrentSkin() end
    end

    if SkinState.ItemApplyButton then
        Connect(SkinState.ItemApplyButton.MouseButton1Click, function()
            SkinState.ApplyItemInputs(true)
        end)
    end

    for index = 1, 30 do
        local input = SkinState.ItemInputs[index]
        if input then
            Connect(input.FocusLost, function(enterPressed)
                if enterPressed then SkinState.ApplyItemInputs(true) end
            end)
        end
    end

    local AvatarUI = _G.YukiAvatarModifiersUI
    if AvatarUI then
        Connect(AvatarUI.SavedPlusButton.MouseButton1Click,function()
            AvatarUI.SaveOverlay.Visible=true
            AvatarUI.SaveNameInput.Text=""
            AvatarUI.SaveMessage.Text=""
            task.defer(function() if AvatarUI.SaveNameInput then AvatarUI.SaveNameInput:CaptureFocus() end end)
        end)
        Connect(AvatarUI.SaveCancel.MouseButton1Click,function()
            AvatarUI.SaveOverlay.Visible=false
            AvatarUI.SaveNameInput.Text=""
            AvatarUI.SaveMessage.Text=""
        end)
        local function commitAvatarSave()
            local ok,msg=SkinState.SaveCurrentSkin(AvatarUI.SaveNameInput.Text)
            if ok then
                local savedEntry=FindSavedSkinByName(AvatarUI.SaveNameInput.Text)
                AvatarUI.SaveOverlay.Visible=false
                AvatarUI.SaveNameInput.Text=""
                AvatarUI.SaveMessage.Text=savedEntry and ("Сохранено: "..tostring(savedEntry.__File or AvatarEntryFile(savedEntry))) or "Сохранено"
            else
                AvatarUI.SaveMessage.Text=tostring(msg)
                AvatarUI.SaveMessage.TextColor3=Color3.fromRGB(255,185,150)
            end
        end
        Connect(AvatarUI.SaveConfirm.MouseButton1Click,commitAvatarSave)
        Connect(AvatarUI.SaveNameInput.FocusLost,function(enterPressed) if enterPressed and AvatarUI.SaveOverlay.Visible then commitAvatarSave() end end)
    end

    SkinState.MigrateSavedSkins()

    do
        local recentUi=SkinState.RecentUI
        if recentUi and recentUi.SaveButton and recentUi.Input then
            Connect(recentUi.SaveButton.MouseButton1Click,function()
                local name=SkinTrim(recentUi.Input.Text)
                if name=="" then
                    SkinStatus("Введи ник для сохранения в память.", Color3.fromRGB(255,185,150))
                    return
                end

                local known=false
                for _,old in ipairs(SkinState.RecentUsernames or {}) do
                    if string.lower(SkinTrim(old))==string.lower(name) then
                        known=true
                        break
                    end
                end

                RecentRemember(name)
                recentUi.Input.Text=""

                if known then
                    SkinStatus("Этот ник уже был сохранён — он перемещён наверх.", Color3.fromRGB(200,200,210))
                else
                    SkinStatus("Ник сохранён в «Последние использованные».", Color3.fromRGB(180,230,190))
                end
            end)

            Connect(recentUi.Input.FocusLost,function(enterPressed)
                if enterPressed then recentUi.SaveButton:Activate() end
            end)
        end
    end

    SkinState.RestoreOriginal = SkinRestoreOriginal

    task.spawn(function()
        -- CharacterAdded and game-specific visual rigs can arrive later than the UI.
        -- Wait for the actual character root before kicking off the saved preset.
        task.wait(0.35)
        local autoName=SkinTrim(SkinState.AutoLoadSkinName or "")
        if autoName=="" then return end
        local entry=FindSavedSkinByName(autoName)
        if not entry then
            SkinStatus("Автозагрузка не выполнена: не найден сохранённый скин «"..autoName.."».", Color3.fromRGB(255,170,170))
            return
        end
        for attempt=1,24 do
            local character=LocalPlayer.Character
            if character
                and character:FindFirstChildOfClass("Humanoid")
                and character:FindFirstChild("HumanoidRootPart")
            then
                break
            end
            task.wait(0.25)
        end
        if SkinState.AutoLoadSkinName=="" or not SkinState.ApplySavedSkin then return end
        local liveEntry=FindSavedSkinByName(SkinState.AutoLoadSkinName)
        if liveEntry then
            SkinState.ApplySavedSkin(liveEntry)
        end
    end)

    SkinState.IsEvade = SkinLooksLikeEvade()
    if SkinState.IsEvade and (SkinState.Headless or SkinState.Korblox or SkinState.DeleteHair or SkinState.DeleteAccessories or SkinState.DeleteAllAccessories or (SkinState.SkinColorName and SkinState.SkinColorName ~= "Default")) then
        task.defer(function()
            local rig = SkinGetEvadeRig()
            if rig then
                SkinApplyEvadeDirectModifiers(rig)
                SkinWatchEvadeDirectRig(rig)
            end
        end)
    end
