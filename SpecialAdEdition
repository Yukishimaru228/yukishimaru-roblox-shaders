    function SkinCsvAppendUnique(csv, assetId)
        local id = tostring(math.floor(tonumber(assetId) or 0))
        if id == "0" then return tostring(csv or "") end
        local source = tostring(csv or "")
        for token in source:gmatch("%d+") do
            if tonumber(token) == tonumber(id) then
                return source
            end
        end
        if source == "" then return id end
        return source .. "," .. id
    end

    function SkinGetAccessoryTypeForAsset(assetTypeId)
        local rigid = RIGID_ACCESSORY_PROPERTY_MAP[tonumber(assetTypeId)]
        if rigid then
            if assetTypeId == 8 then return Enum.AccessoryType.Hat end
            if assetTypeId == 41 then return Enum.AccessoryType.Hair end
            if assetTypeId == 42 then return Enum.AccessoryType.Face end
            if assetTypeId == 43 then return Enum.AccessoryType.Neck end
            if assetTypeId == 44 then return Enum.AccessoryType.Shoulder end
            if assetTypeId == 45 then return Enum.AccessoryType.Front end
            if assetTypeId == 46 then return Enum.AccessoryType.Back end
            if assetTypeId == 47 then return Enum.AccessoryType.Waist end
        end
        return LAYERED_ACCESSORY_TYPE_MAP[tonumber(assetTypeId)] or Enum.AccessoryType.Unknown
    end

    function SkinBuildCustomAccessorySpecs(ids, description)
        local layeredSpecs, fallback, report = {}, {}, {}
        local okExisting, existing = pcall(function() return description:GetAccessories(false) end)
        if not okExisting or type(existing) ~= "table" then existing = {} end
        for _, spec in ipairs(existing) do
            layeredSpecs[#layeredSpecs + 1] = spec
        end

        for _, assetId in ipairs(ids or {}) do
            local info, infoError = SkinGetItemInfo(assetId)
            local assetTypeId = info and tonumber(info.AssetTypeId) or nil
            local bodyProperty = assetTypeId and BODY_ASSET_PROPERTY_MAP[assetTypeId] or nil
            local rigidProperty = assetTypeId and RIGID_ACCESSORY_PROPERTY_MAP[assetTypeId] or nil
            local layeredType = assetTypeId and LAYERED_ACCESSORY_TYPE_MAP[assetTypeId] or nil
            local handled = false

            -- Classic clothing and body-part asset IDs are scalar properties
            -- on HumanoidDescription, not entries in GetAccessories()/SetAccessories().
            -- Keep this branch ahead of the accessory branches so these assets
            -- are applied by Roblox's avatar builder itself.
            if bodyProperty then
                local okSet, setErr = pcall(function()
                    description[bodyProperty] = tonumber(assetId)
                end)
                handled = okSet
                report[#report + 1] = {
                    Id = assetId,
                    Type = assetTypeId,
                    Mode = okSet and ("Description." .. bodyProperty) or "Fallback",
                    Error = okSet and nil or tostring(setErr or infoError or "body/clothing property write failed")
                }
                if not okSet then
                    fallback[#fallback + 1] = assetId
                end
            elseif rigidProperty then
                local okSet, setErr = pcall(function()
                    description[rigidProperty] = SkinCsvAppendUnique(description[rigidProperty], assetId)
                end)
                handled = okSet
                report[#report + 1] = {
                    Id = assetId,
                    Type = assetTypeId,
                    Mode = okSet and ("Description." .. rigidProperty) or "Fallback",
                    Error = okSet and nil or tostring(setErr or infoError or "property write failed")
                }
                if not okSet then
                    fallback[#fallback + 1] = assetId
                end
            elseif layeredType then
                local okCurrent, currentList = pcall(function() return description:GetAccessories(false) end)
                if not okCurrent or type(currentList) ~= "table" then currentList = layeredSpecs end
                local already = false
                for _, existingSpec in ipairs(currentList) do
                    if tonumber(existingSpec.AssetId) == tonumber(assetId) then
                        already = true
                        break
                    end
                end
                if not already then
                    layeredSpecs[#layeredSpecs + 1] = {
                        Order = (#layeredSpecs) + 1,
                        AssetId = tonumber(assetId),
                        AccessoryType = layeredType,
                        IsLayered = true,
                    }
                end
                handled = true
                report[#report + 1] = {Id=assetId, Type=assetTypeId, Mode="SetAccessories.Layered"}
            else
                -- Some marketplace assets are reported with a generic/unknown
                -- type. Try a best-effort local load instead of discarding them.
                fallback[#fallback + 1] = assetId
                report[#report + 1] = {
                    Id = assetId,
                    Type = assetTypeId or "Unknown",
                    Mode = "Fallback",
                    Error = tostring(infoError or "unsupported catalog type")
                }
            end
        end

        local okApply, applyErr = pcall(function()
            description:SetAccessories(layeredSpecs, false)
        end)
        if not okApply then
            -- Preserve the IDs for the raw-instance fallback path.
            for _, id in ipairs(ids or {}) do
                local duplicate = false
                for _, existingId in ipairs(fallback) do
                    if tonumber(existingId) == tonumber(id) then duplicate = true break end
                end
                if not duplicate then fallback[#fallback + 1] = id end
            end
            report[#report + 1] = {Mode="SetAccessories.LayeredError", Error=tostring(applyErr)}
        end

        return fallback, report
    end

