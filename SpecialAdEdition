    _Yuki_ResetShaderState()
    _Yuki_DestroyShaderEffects()
    _Yuki_DestroyVignette()
    _Yuki_StopMotionBlur()
    _Yuki_RestoreOriginalWorld()

    if config.cc then
        _Yuki_CreateEffect("ColorCorrection", config.cc)
    end
    if config.bloom then
        _Yuki_CreateEffect("Bloom", config.bloom)
    end
    if config.dof then
        _Yuki_CreateEffect("DepthOfField", config.dof)
    end
    if config.atmosphere then
        _Yuki_CreateEffect("Atmosphere", config.atmosphere)
    end
    if config.sun then
        _Yuki_CreateEffect("SunRays", config.sun)
    end

    if config.vignette then
        ShaderState.Vignette = true
        ShaderState.VignetteStrength = config.vignette
        _Yuki_UpdateVignette()
    end

    if config.clock ~= nil then
        Lighting.ClockTime = config.clock
    end
end

