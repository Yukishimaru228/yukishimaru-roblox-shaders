        local function buildPreview(entry, tmpl)
            local vp = entry.Viewport
            if not vp or not vp.Parent then
                return
            end
            local m = tmpl.Model:Clone()
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.Anchored = true
                end
            end
            m.Parent = vp

            local mn, mx = measure(m, CFrame.new(), true)
            local cam = new("Camera", {FieldOfView = 40}, vp)
            vp.CurrentCamera = cam
            entry.Center = (mn + mx) / 2
            entry.Dist = math.max((mx - mn).Magnitude * 0.95, 8)
            entry.Cam = cam
            entry.Loading.Visible = false
        end

        local previewsStarted = false
        local function preloadPreviews()
            if previewsStarted then
                return
            end
            previewsStarted = true
            for _, entry in ipairs(CarEntries) do
                entry.Loading.Text = "Loading..."
            end
            task.spawn(function()
                for _, entry in ipairs(CarEntries) do
                    if not Alive then
                        return
                    end
                    local tmpl = getTemplate(entry.Cfg)
                    if tmpl then
                        local okP, errP = pcall(buildPreview, entry, tmpl)
                        if not okP then
                            warn("[Yuki Cars] Preview error: " .. tostring(errP))
                            entry.Loading.Text = "No preview"
                        end
                    else
                        entry.Loading.Text = "Unavailable"
                    end
                end
            end)
