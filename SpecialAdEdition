    SkinState.ApplyVisualModifiers = function(proxy)
        if not proxy then return end

        local head = proxy:FindFirstChild("Head", true)

        if SkinState.DeleteHair or SkinState.DeleteAccessories or SkinState.DeleteAllAccessories then
            for _, object in ipairs(proxy:GetChildren()) do
                if object:IsA("Accessory") and head then
                    local remove = false

                    if SkinState.DeleteHair then
                        local okType, accessoryType = pcall(function()
                            return object.AccessoryType
                        end)
                        if okType and accessoryType == Enum.AccessoryType.Hair then
                            remove = true
                        end
                    end

                    if SkinState.DeleteAccessories and not remove then
                        remove = SkinIsHeadAccessory(object, head)
                    end

                    if SkinState.DeleteAllAccessories then
                        remove = true
                    end

                    if remove then
                        pcall(function()
                            object:Destroy()
                        end)
                    end
                end
            end
        end

        if SkinState.Headless then
            if head and head:IsA("BasePart") then
                head.Transparency = 1
                head.LocalTransparencyModifier = 1
            end
            if head then
                for _, object in ipairs(head:GetDescendants()) do
                    if object:IsA("Decal") or object:IsA("Texture") then
                        object.Transparency = 1
                    elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
                        object.Enabled = false
                    elseif object:IsA("SurfaceGui") or object:IsA("BillboardGui") then
                        object.Enabled = false
                    end
                end
            end
        end
    end

    function SkinApplyProxyKorblox(proxy, rigType)
        if not proxy or not SkinState.Korblox then return end

        -- Match the proven KorbloxHeadless script for classic R6 rigs: keep the
        -- Motor6D, hide the original right leg and weld the catalog mesh shell.
        -- R15 uses the HumanoidDescription body-part when it applied cleanly;
        -- otherwise a smaller lower-leg shell is used as a local fallback.
        local classicRightLeg = proxy:FindFirstChild("Right Leg", true)
        local shell = proxy:FindFirstChild("YukiProxyKorblox", true)
        if shell then pcall(function() shell:Destroy() end) end

        local attachPart = nil
        local shellSize = Vector3.new(1, 2, 1)
        local offsetY = 0.7
        local meshScale = Vector3.new(1, 1, 1)

        if classicRightLeg and classicRightLeg:IsA("BasePart") then
            attachPart = classicRightLeg
        elseif rigType == Enum.HumanoidRigType.R15 and SkinState.KorbloxDescriptionApplied then
            -- The R15 body part already came from the HumanoidDescription.
            return
        else
            attachPart = proxy:FindFirstChild("RightLowerLeg", true)
            shellSize = Vector3.new(1, 1.25, 1)
            offsetY = 0.15
            meshScale = Vector3.new(1, 0.72, 1)
        end

        if not attachPart or not attachPart:IsA("BasePart") then return end
        attachPart.Transparency = 1
        attachPart.LocalTransparencyModifier = 1

        shell = Instance.new("Part")
        shell.Name = "YukiProxyKorblox"
        shell.Size = shellSize
        shell.Anchored = false
        shell.CanCollide = false
        shell.CanTouch = false
        shell.CanQuery = false
        shell.CastShadow = false
        shell.Massless = true
        shell.Transparency = 0
        shell.CFrame = attachPart.CFrame * CFrame.new(0, offsetY, 0)
        shell.Parent = proxy

        local mesh = Instance.new("SpecialMesh")
        mesh.Name = "KorbloxMesh"
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://902942096"
        mesh.TextureId = "rbxassetid://902843398"
        mesh.Scale = meshScale
        mesh.Parent = shell

        local weld = Instance.new("WeldConstraint")
        weld.Name = "YukiProxyKorbloxWeld"
        weld.Part0 = shell
        weld.Part1 = attachPart
        weld.Parent = shell
    end

    function SkinApplyProxyPhysics(proxy, humanoid)
        humanoid.AutoRotate = false
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        humanoid.RequiresNeck = false

        pcall(function()
            humanoid.EvaluateStateMachine = false
        end)

        local root =
            humanoid.RootPart
            or proxy:FindFirstChild("HumanoidRootPart", true)

        -- The proxy is a pure visual shell now.
        -- Remove the body Motor6D graph so Roblox cannot fight our exact
        -- per-frame body CFrame replication.
        for _, object in ipairs(proxy:GetDescendants()) do
            if object:IsA("Motor6D") then
                pcall(function()
                    object:Destroy()
                end)
            elseif object:IsA("BasePart") then
                object.CanCollide = false
                object.CanTouch = false
                object.CanQuery = false
                object.Massless = true
                object.AssemblyLinearVelocity = Vector3.zero
                object.AssemblyAngularVelocity = Vector3.zero

                if object == root or SkinIsBodyPart(object) then
                    object.Anchored = true
                else
                    -- Accessories stay physically attached to their avatar
                    -- body parts through their own Weld/AccessoryWeld.
                    object.Anchored = false
                end
            elseif object:IsA("Script") or object:IsA("LocalScript") then
                pcall(function()
                    object.Disabled = true
                end)
            end
        end
    end

    function SkinCleanupStaleProxies()
        local names={YukiSkinProxy=true,YukiAvatarProxy=true,YukiKorbloxVisual=true,YukiProxyKorblox=true}
        for _,object in ipairs(Workspace:GetChildren()) do
            if names[object.Name] then pcall(function() object:Destroy() end)
            elseif object:IsA("Model") and object:GetAttribute("YukiSkinProxy")==true then pcall(function() object:Destroy() end) end
        end
    end

    function SkinGetAppliedAccessoryIds(humanoid)
        local ids = {}
        if not humanoid then return ids, false end
        local okDescription, applied = pcall(function()
            return humanoid:GetAppliedDescription()
        end)
        if not okDescription or not applied then
            return ids, false
        end

        -- Include scalar clothing/body-part slots as well as accessories.
        -- Otherwise every Shirt/Pants/Head/limb ID looked "missing" because
        -- GetAccessories() never returns those properties, and the raw fallback
        -- could run on top of the already-built avatar (or fail altogether).
        for _, propertyName in pairs(BODY_ASSET_PROPERTY_MAP or {}) do
            pcall(function()
                local id = tonumber(applied[propertyName])
                if id and id > 0 then ids[id] = true end
            end)
        end

        -- Rigid accessories live in comma-separated properties too.
        for _, propertyName in pairs(RIGID_ACCESSORY_PROPERTY_MAP or {}) do
            pcall(function()
                local raw = tostring(applied[propertyName] or "")
                for token in raw:gmatch("%d+") do
                    local id = tonumber(token)
                    if id and id > 0 then ids[id] = true end
                end
            end)
        end

        -- Layered/rigid accessory specs provide a second source of verification.
        local okAccessories, accessories = pcall(function()
            return applied:GetAccessories(true)
        end)
        if okAccessories and type(accessories) == "table" then
            for _, spec in ipairs(accessories) do
                local id = tonumber(spec.AssetId)
                if id and id > 0 then ids[id] = true end
            end
        end
        return ids, true
    end

    function SkinUniqueMissingIds(sourceIds, appliedIds)
        local missing = {}
        for _, id in ipairs(sourceIds or {}) do
            local n = tonumber(id)
            if n and n > 0 and not (appliedIds and appliedIds[n]) then
                missing[#missing + 1] = n
            end
        end
        return missing
    end

    --========================================================
    -- V21: saved skins are SNAPSHOTS.
    -- A saved skin stores the exact HumanoidDescription that was used when it
    -- was saved, so loading it never re-downloads the nickname's current
    -- avatar and never writes the nickname back into the input field.
    --========================================================
    SkinState.SnapNumberProps = {"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg","Face","GraphicTShirt","Shirt","Pants","HeightScale","WidthScale","DepthScale","HeadScale","BodyTypeScale","ProportionScale"}
    SkinState.SnapStringProps = {"HatAccessory","HairAccessory","FaceAccessory","NeckAccessory","ShouldersAccessory","FrontAccessory","BackAccessory","WaistAccessory"}
    SkinState.SnapColorProps = {"HeadColor","TorsoColor","LeftArmColor","RightArmColor","LeftLegColor","RightLegColor"}

    function SkinSerializeDescription(desc, userId)
        if not desc then return nil end
        local snap = {Version = 1, UserId = tonumber(userId), Numbers = {}, Strings = {}, Colors = {}, Layered = {}}
        for _, prop in ipairs(SkinState.SnapNumberProps) do
            local ok, value = pcall(function() return desc[prop] end)
            if ok and type(value) == "number" then snap.Numbers[prop] = value end
        end
        for _, prop in ipairs(SkinState.SnapStringProps) do
            local ok, value = pcall(function() return desc[prop] end)
            if ok and type(value) == "string" then snap.Strings[prop] = value end
        end
        for _, prop in ipairs(SkinState.SnapColorProps) do
            local ok, value = pcall(function() return desc[prop] end)
            if ok and typeof(value) == "Color3" then
                snap.Colors[prop] = {
                    math.floor(value.R * 255 + 0.5),
                    math.floor(value.G * 255 + 0.5),
                    math.floor(value.B * 255 + 0.5),
                }
            end
        end
        local okLayered, layered = pcall(function() return desc:GetAccessories(false) end)
        if okLayered and type(layered) == "table" then
            for index, spec in ipairs(layered) do
                local accType = spec.AccessoryType
                snap.Layered[#snap.Layered + 1] = {
                    AssetId = tonumber(spec.AssetId),
                    Type = typeof(accType) == "EnumItem" and accType.Name or tostring(accType),
                    Order = tonumber(spec.Order) or index,
                    Puffiness = tonumber(spec.Puffiness),
                }
            end
        end
        return snap
    end

    function SkinDescriptionFromSnapshot(snap)
        if type(snap) ~= "table" then return nil end
        local allowed = {}
        for _, list in ipairs({SkinState.SnapNumberProps, SkinState.SnapStringProps, SkinState.SnapColorProps}) do
            for _, prop in ipairs(list) do allowed[prop] = true end
        end
        local desc = Instance.new("HumanoidDescription")
        for prop, value in pairs(snap.Numbers or {}) do
            if allowed[prop] then pcall(function() desc[prop] = tonumber(value) or 0 end) end
        end
        for prop, value in pairs(snap.Strings or {}) do
            if allowed[prop] then pcall(function() desc[prop] = tostring(value) end) end
        end
        for prop, rgb in pairs(snap.Colors or {}) do
            if allowed[prop] and type(rgb) == "table" then
                pcall(function() desc[prop] = Color3.fromRGB(rgb[1] or 0, rgb[2] or 0, rgb[3] or 0) end)
            end
        end
        local specs = {}
        for index, item in ipairs(snap.Layered or {}) do
            local assetId = tonumber(item.AssetId)
            local okType, accType = pcall(function() return Enum.AccessoryType[tostring(item.Type)] end)
            if assetId and okType and accType then
                local spec = {Order = tonumber(item.Order) or index, AssetId = assetId, AccessoryType = accType, IsLayered = true}
                if tonumber(item.Puffiness) then spec.Puffiness = tonumber(item.Puffiness) end
                specs[#specs + 1] = spec
            end
        end
        if #specs > 0 then pcall(function() desc:SetAccessories(specs, false) end) end
        return desc
    end

    -- Returns ok, description. Uses the saved snapshot when one is active;
    -- otherwise downloads the live avatar and remembers a snapshot of it.
    function SkinGetBaseDescription(userId)
        if SkinState.ActiveSnapshot then
            local okSnap, descSnap = pcall(SkinDescriptionFromSnapshot, SkinState.ActiveSnapshot)
            if okSnap and descSnap then return true, descSnap end
        end
        local ok, desc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
        end)
        if ok and desc then
            local okSer, snap = pcall(SkinSerializeDescription, desc, userId)
            SkinState.LastDescriptionSnapshot = okSer and snap or nil
        end
        return ok, desc
    end

    -- Called from SaveCurrentSkin (may yield). Freezes the avatar into the entry.
    function SkinAttachSnapshot(entry)
        if SkinState.ActiveSnapshot then
            entry.Snapshot = SkinState.ActiveSnapshot
            entry.UserId = entry.UserId or tonumber(SkinState.ActiveSnapshot.UserId)
            return true
        end
        local uid = tonumber(entry.UserId)
        if not uid and SkinTrim(entry.Username) ~= "" then
            local okId, resolved = pcall(function() return Players:GetUserIdFromNameAsync(entry.Username) end)
            if okId then uid = tonumber(resolved) end
        end
        uid = uid or tonumber(LocalPlayer.UserId)
        local last = SkinState.LastDescriptionSnapshot
        if last and tonumber(last.UserId) == uid then
            entry.Snapshot = last
            entry.UserId = uid
            return true
        end
        local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserIdAsync(uid) end)
        if ok and desc then
            local okSer, snap = pcall(SkinSerializeDescription, desc, uid)
            if okSer and snap then
                entry.Snapshot = snap
                entry.UserId = uid
                return true
            end
        end
        return false
    end

    function SkinBuildProxy(userId, buildToken)
        local character = LocalPlayer.Character
        local characterHumanoid = character and character:FindFirstChildOfClass("Humanoid")
        local characterRoot = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not characterHumanoid or not characterRoot then
            return false, "Персонаж ещё не готов."
        end

        SkinCleanupStaleProxies()
        local sourceVisual = SkinResolveSourceCharacter(character, true)
        if buildToken and buildToken ~= SkinState.ApplyToken then
            return false, "Сборка отменена новым запросом."
        end
        local sourceHumanoid = sourceVisual and sourceVisual:FindFirstChildOfClass("Humanoid") or characterHumanoid
        local sourceRoot = SkinGetRoot(sourceVisual) or characterRoot
        SkinState.SourceCharacter = sourceVisual
        if not sourceHumanoid or not sourceRoot then
            return false, "Не найден визуальный humanoid/root риг."
        end

        -- Diagnostic report confirmed:
        -- Evade's Workspace.Rigs.<player> is the rendered avatar, while
        -- Workspace.Players.<player> is only the tiny controller shell.
        SkinState.SourceKind = SkinState.SourceKind or "DetectedVisualRig"

        local sourceVisualRoot = sourceRoot
        SkinState.IsEvade = sourceVisual ~= character and SkinLooksLikeEvade()

        SkinClearEvadeDirect()
        SkinDestroyProxy()
        SkinState.IsEvade = sourceVisual ~= character and SkinLooksLikeEvade()

        -- Hide the logical character BEFORE inserting the proxy, so there is no
        -- one-frame overlap with the old avatar. In Evade also hide the actual
        -- Workspace.Rigs visual shell; its Motor6D/Animator continues running.
        SkinHideCharacter(character, true)
        if sourceVisual ~= character then
            SkinHideModelVisuals(sourceVisual)
        end
        SkinScanExtraLocalVisuals()
        task.defer(function()
            local leftovers = {}
            for _, model in ipairs({character, sourceVisual}) do
                if model and model.Parent then
                    for _, d in ipairs(model:GetDescendants()) do
                        if d:IsA("BasePart") and d.Transparency < 0.95 and d.LocalTransparencyModifier < 0.95
                            and not (SkinState.ProxyCharacter and d:IsDescendantOf(SkinState.ProxyCharacter)) then
                            leftovers[#leftovers + 1] = d:GetFullName():sub(-60)
                            if #leftovers >= 12 then break end
                        end
                    end
                end
            end
            if #leftovers > 0 then
                warn("[Yuki] Visible parts left on the original character (kept as game assets): " .. table.concat(leftovers, " | "))
            end
        end)

        -- Build the target appearance on the SAME rig type as the real
        -- character. This is critical for games such as Evade: the game's
        -- animation rig can be R6 or R15/custom, and Roblox can explicitly
        -- build a HumanoidDescription as either R6 or R15.
        local sourceRigType = sourceHumanoid.RigType
        local okDescription, description = SkinGetBaseDescription(userId)
        if buildToken and buildToken ~= SkinState.ApplyToken then
            SkinHideCharacter(character, false)
            SkinDestroyAllYukiProxies(nil)
            return false, "Сборка отменена новым запросом."
        end
        if not okDescription or not description then
            SkinHideCharacter(character, false)
            return false, tostring(description or "Не удалось получить описание аватара.")
        end

        -- Apply avatar-description modifiers before the proxy is created so
        -- the resulting model is clean from the first rendered frame.
        SkinApplyDescriptionModifiers(description)

        local customItemIds = SkinCollectItemIds()
        SkinState.ActiveItemIds = {}
        for index, id in ipairs(customItemIds) do
            SkinState.ActiveItemIds[index] = tostring(id)
        end
        for index = 1, 30 do
            if SkinState.ItemInputs[index] and SkinTrim(SkinState.ItemInputs[index].Text) == "" then
                local canonical = SkinState.ItemIds[index]
                if canonical and SkinTrim(canonical) ~= "" then
                    SkinState.ItemInputs[index].Text = tostring(canonical)
                end
            end
        end
        local customFallbackIds, customReport = SkinBuildCustomAccessorySpecs(customItemIds, description)
        SkinState.LastItemApplyReport = customReport
        SkinSetItemStatus(#customItemIds > 0 and ("Подготовлено Asset ID: "..tostring(#customItemIds)) or "Слоты предметов не задействованы.", Color3.fromRGB(180, 230, 190))

        local ok, proxy = pcall(function()
            return Players:CreateHumanoidModelFromDescriptionAsync(
                description,
                sourceRigType,
                Enum.AssetTypeVerification.Default
            )
        end)
        if buildToken and buildToken ~= SkinState.ApplyToken then
            if proxy then pcall(function() proxy:Destroy() end) end
            SkinHideCharacter(character, false)
            SkinDestroyAllYukiProxies(nil)
            return false, "Сборка отменена новым запросом."
        end
        if not ok or not proxy then
            SkinHideCharacter(character, false)
            return false, tostring(proxy or "Не удалось создать модель аватара.")
        end

        proxy.Name = "YukiSkinProxy"
        proxy:SetAttribute("YukiSkinProxy", true)
        proxy.Parent = Workspace
        task.wait()

        if buildToken and buildToken ~= SkinState.ApplyToken then
            pcall(function() proxy:Destroy() end)
            return false, "Сборка отменена новым запросом."
        end

        local proxyHumanoid = proxy:FindFirstChildOfClass("Humanoid")
        local proxyRoot = proxyHumanoid and (proxyHumanoid.RootPart or proxy:FindFirstChild("HumanoidRootPart", true))
        if not proxyHumanoid or not proxyRoot then
            proxy:Destroy()
            SkinHideCharacter(character, false)
            return false, "Roblox не вернул корректный humanoid-риг."
        end

        -- Apply any custom items that the generated description did not
        -- actually materialize. We do this BEFORE destroying the proxy's
        -- Motor6D graph so Humanoid:AddAccessory gets the original rig and
        -- attachment layout.
        SkinState.ItemOverlays = {}
        SkinState.ItemLoadedObjects = {}
        local appliedAccessoryIds, verifiedApplied = SkinGetAppliedAccessoryIds(proxyHumanoid)
        local missingCustomIds = {}
        if verifiedApplied then
            missingCustomIds = SkinUniqueMissingIds(customItemIds, appliedAccessoryIds)
        else
            for _, id in ipairs(customFallbackIds or {}) do
                missingCustomIds[#missingCustomIds + 1] = id
            end
        end

        local rawLoaded, rawFailed = SkinApplyRawCustomItems(proxy, proxyHumanoid, missingCustomIds)

        SkinApplyProxyPhysics(proxy, proxyHumanoid)
        SkinState.ApplyVisualModifiers(proxy)
        SkinApplyProxyKorblox(proxy, sourceRigType)
        if #customItemIds > 0 then
            local catalogCount = verifiedApplied and (#customItemIds - #missingCustomIds) or 0
            SkinSetItemStatus(string.format("Items: %d • description: %d • raw: %d • failed: %d", #customItemIds, math.max(catalogCount, 0), rawLoaded, rawFailed), rawFailed > 0 and Color3.fromRGB(255, 205, 150) or Color3.fromRGB(180, 230, 190))
        end
        SkinStartVisualWatchers(character, sourceVisual)

        local proxyAnimator = proxyHumanoid:FindFirstChildOfClass("Animator")
        if not proxyAnimator then
            proxyAnimator = Instance.new("Animator")
            proxyAnimator.Parent = proxyHumanoid
        end

        -- The new proxy becomes the only Yuki proxy we keep.
        SkinDestroyAllYukiProxies(proxy)
        SkinState.ProxyCharacter = proxy
        SkinState.ProxyHumanoid = proxyHumanoid
        SkinState.ProxyAnimator = proxyAnimator
        SkinState.SourceCharacter = sourceVisual
        if SkinFirstPersonShouldMask() and SkinIsFirstPersonCamera() then
            SkinEnterEvadeFirstPerson()
        end
        SkinState.SourceRoot = sourceVisualRoot
        SkinState.SourceRootName = sourceVisualRoot.Name
        SkinBuildPoseMap(sourceVisual, proxy)

        local sourceAnimators = SkinFindSourceAnimators(sourceVisual)
        if sourceVisual ~= character then
            for _, extraAnimator in ipairs(SkinFindSourceAnimators(character)) do
                if not table.find(sourceAnimators, extraAnimator) then
                    table.insert(sourceAnimators, extraAnimator)
                end
            end
        end
        SkinState.SourceAnimators = sourceAnimators

        if SkinState.SourceDetectorConnection then
            pcall(function() SkinState.SourceDetectorConnection:Disconnect() end)
            SkinState.SourceDetectorConnection = nil
        end
        if SkinState.SourcePollConnection then
            pcall(function() SkinState.SourcePollConnection:Disconnect() end)
            SkinState.SourcePollConnection = nil
        end

        -- Generic source-rig detection for Skinchanger. Evade is only one
        -- supported layout; other games can expose a visual avatar under
        -- Workspace.Players / Workspace.Rigs or as a separate model.
        SkinState.SourceDetectorConnection = Workspace.DescendantAdded:Connect(function(object)
            if not Alive or SkinState.ProxyCharacter ~= proxy then return end
            if object:IsA("Model") or object:IsA("Humanoid") or object:IsA("Motor6D") or object:IsA("Animator") then
                task.defer(function()
                    if not Alive or SkinState.ProxyCharacter ~= proxy then return end
                    local detected = SkinDetectSourceCharacter(LocalPlayer.Character, false)
                    if detected and detected ~= SkinState.SourceCharacter then
                        SkinState.RebuildCurrentSkin()
                    end
                end)
            end
        end)

        local detectClock = 0
        SkinState.SourcePollConnection = RunService.Heartbeat:Connect(function(dt)
            if not Alive or SkinState.ProxyCharacter ~= proxy then return end
            detectClock += dt
            if detectClock < 0.35 then return end
            detectClock = 0
            local detected = SkinDetectSourceCharacter(LocalPlayer.Character, false)
            if detected and detected ~= SkinState.SourceCharacter and detected ~= proxy then
                SkinState.RebuildCurrentSkin()
            end
        end)

        -- Prime track mirroring immediately and react to new tracks as soon as
        -- the game's Animator starts them. This avoids waiting for the polling
        -- fallback and is useful for Evade's short-lived action tracks.
        for _, sourceAnimator in ipairs(sourceAnimators) do
            pcall(function()
                local connection = sourceAnimator.AnimationPlayed:Connect(function()
                    if Alive and SkinState.ProxyCharacter == proxy and SkinShouldUseTrackFallback() then
                        task.defer(function()
                            if Alive and SkinState.ProxyCharacter == proxy and SkinShouldUseTrackFallback() then
                                SkinSyncAnimationTracks(sourceAnimators)
                            end
                        end)
                    end
                end)
                table.insert(SkinState.SourceAnimationConnections, connection)
            end)
        end
        if SkinShouldUseTrackFallback() then
            SkinSyncAnimationTracks(sourceAnimators)
        end

        local proxyRootCF = proxyRoot.CFrame
        local proxyPivotCF = proxy:GetPivot()
        local rootToPivot = proxyRootCF:ToObjectSpace(proxyPivotCF)

        pcall(function()
            -- Align to the actual visual source. In Evade this is Workspace.Rigs.<player>.
            proxy:PivotTo(sourceVisualRoot.CFrame * rootToPivot)
        end)

        pcall(function()
            Camera.CameraSubject = characterHumanoid
        end)

        -- The game's own visual rig is the authoritative animation source.
        -- Copy its final body pose after simulation, right before rendering.
        SkinState.PoseConnection = RunService.PreSimulation:Connect(function()
            if not Alive then
                return
            end

            local realCharacter = LocalPlayer.Character
            local sourceCurrent = SkinState.SourceCharacter or sourceVisual
            local visual = SkinState.ProxyCharacter

            if realCharacter ~= character
                or not sourceCurrent
                or not sourceCurrent.Parent
                or not visual
                or not visual.Parent
            then
                return
            end

            -- Root/body pose will be applied again on RenderStepped.
            -- This early pass reduces one-frame lag on low-FPS clients.
            SkinSyncPose()
        end)

        SkinState.RenderConnection = RunService.RenderStepped:Connect(function()
            if not Alive then
                return
            end

            local realCharacter = LocalPlayer.Character
            local sourceCurrent = SkinState.SourceCharacter or realCharacter
            local visual = SkinState.ProxyCharacter

            if not realCharacter
                or realCharacter ~= character
                or not sourceCurrent
                or not sourceCurrent.Parent
                or not visual
                or not visual.Parent
            then
                return
            end

            -- IMPORTANT:
            -- Never replay source AnimationTracks here.
            -- The source game's already-rendered body CFrames are the truth.
            SkinSyncPose()

            local now = os.clock()

            if now - (SkinState.LastMaskRefresh or 0) >= 0.12 then
                SkinState.LastMaskRefresh = now
                SkinReassertHiddenObjects()
            end

            -- Evade proxy first-person safety.
            SkinUpdateEvadeFirstPerson()

            pcall(function()
                Camera.CameraSubject = characterHumanoid
            end)
        end)

        return true
    end

    function SkinRestoreOriginal()
        SkinState.ActiveSnapshot = nil
        SkinState.ApplyToken += 1
        SkinClearEvadeDirect()
        SkinDestroyProxy()
        SkinCleanupStaleProxies()

        local character = SkinState.HiddenCharacter
        if character then
            SkinHideCharacter(character, false)
        end

        SkinState.TargetUsername = ""
        SkinState.TargetUserId = nil
        SkinStatus("Обычный внешний вид восстановлен.", Color3.fromRGB(180, 220, 190))
    end

    function SkinResetAll()
        SkinState.Headless = false
        SkinState.Korblox = false
        SkinState.DeleteHair = false
        SkinState.DeleteArmsFP = false
        SkinState.DeleteAccessories = false
        SkinState.DeleteAllAccessories = false
        SkinState.SkinColorName = "Default"
        SkinState.TargetUsername = ""
        SkinState.TargetUserId = nil
        SkinState.ItemIds = {}
        SkinState.ActiveItemIds = {}

        if SkinState.Input then SkinState.Input.Text = "" end
        for index=1,30 do
            SkinState.ItemIds[index] = ""
            SkinState.ActiveItemIds[index] = nil
            if SkinState.ItemInputs and SkinState.ItemInputs[index] then
                SkinState.ItemInputs[index].Text = ""
            end
        end

        SkinState.RefreshModifierButton(SkinState.HeadlessButton, false, "Headless")
        SkinState.RefreshModifierButton(SkinState.KorbloxButton, false, "Korblox")
        SkinState.RefreshModifierButton(SkinState.DeleteHairButton, false, "Delete hair")
        SkinState.RefreshModifierButton(SkinState.DeleteArmsFPButton, false, "Delete arms in First Person")
        SkinState.RefreshModifierButton(SkinState.DeleteAccessoriesButton, false, "Delete accessories")
        SkinState.RefreshModifierButton(SkinState.DeleteAllAccessoriesButton, false, "Delete all accessories")
        if SkinState.SkinColorButton then SkinState.SkinColorButton.Text = "Default" end
        SkinRestoreOriginal()
    end

    function SkinApplyUsername(username)
        username = tostring(username or ""):gsub("^%s+", ""):gsub("%s+$", "")
        SkinState.ActiveSnapshot = nil

        if username == "" then
            SkinState.TargetUsername = ""
            SkinState.TargetUserId = nil
            if SkinState.Input then SkinState.Input.Text = "" end
            SkinState.ActiveItemIds = {}
            SkinSyncItemStateFromUI()
            if SkinState.Headless or SkinState.Korblox or SkinState.DeleteHair or SkinState.DeleteAccessories or SkinState.DeleteAllAccessories or SkinHasCustomItems() or (SkinState.SkinColorName and SkinState.SkinColorName ~= "Default") then
                SkinState.RebuildCurrentSkin()
            else
                SkinRestoreOriginal()
            end
            return
        end

        -- Snapshot visible item fields before changing username. Empty fields
        -- deliberately remove previous custom items instead of preserving them.
        SkinSyncItemStateFromUI()
        SkinClearEvadeDirect()
        SkinState.ApplyToken += 1
        local token = SkinState.ApplyToken
        SkinStatus("Загружаю аватар " .. username .. "...")

        task.spawn(function()
            local okUser, userId = pcall(function()
                return Players:GetUserIdFromNameAsync(username)
            end)
            if token ~= SkinState.ApplyToken then return end

            if not okUser or not userId then
                SkinStatus("Не удалось найти username: " .. username, Color3.fromRGB(255, 170, 170))
                return
            end

            local okBuild, err = SkinBuildProxy(tonumber(userId), token)
            if token ~= SkinState.ApplyToken then return end

            if okBuild then
                SkinState.TargetUsername = username
                SkinState.TargetUserId = tonumber(userId)
                SkinSyncItemStateFromUI()
                RecentRemember(username)
                AvatarSave()
                if SkinState.Input then SkinState.Input.Text = username end
                SkinStatus("Скин применён: " .. username .. " • Source: " .. tostring(SkinState.SourceKind), Color3.fromRGB(180, 230, 190))
            else
                SkinStatus("Не удалось создать скин: " .. tostring(err), Color3.fromRGB(255, 170, 170))
            end
        end)
    end

    SkinState.CharacterConnection = Connect(LocalPlayer.CharacterAdded, function(character)
        SkinClearEvadeDirect()
        SkinDestroyProxy()

        local oldHidden = SkinState.HiddenCharacter
        if oldHidden and oldHidden ~= character then
            SkinHideCharacter(oldHidden, false)
        end

        SkinState.SourceCharacter = nil
        SkinState.SourceRoot = nil
        SkinState.SourceAnimators = {}

        local wantsModifiers = SkinState.Headless
            or SkinState.Korblox
            or SkinState.DeleteHair
            or SkinState.DeleteAccessories
            or SkinState.DeleteAllAccessories
            or SkinState.DeleteArmsFP
            or (SkinState.SkinColorName and SkinState.SkinColorName ~= "Default")
            or SkinHasCustomItems()

        if not SkinState.TargetUserId and not wantsModifiers then
            return
        end

        task.spawn(function()
            for _, delayTime in ipairs({0.20, 0.45, 0.80, 1.20, 1.75}) do
                task.wait(delayTime)
                if not Alive or LocalPlayer.Character ~= character then return end

                if not SkinState.TargetUserId and not SkinHasCustomItems() and SkinLooksLikeEvade() and not (SkinState.SkinColorName and SkinState.SkinColorName ~= "Default") then
                    local rig = SkinResolveSourceCharacter(character, true)
                    if rig then
                        SkinState.IsEvade = true
                        SkinApplyEvadeDirectModifiers(rig)
                        SkinWatchEvadeDirectRig(rig)
                        SkinStatus("Модификаторы повторно применены к визуальному ригу Evade.", Color3.fromRGB(180, 230, 190))
                        return
                    end
                end

                local targetId = SkinState.TargetUserId or LocalPlayer.UserId
                local okBuild = SkinBuildProxy(targetId, SkinState.ApplyToken)
                if okBuild then
                    if SkinState.TargetUserId then
                        SkinStatus("Скин повторно применён после респавна: " .. SkinState.TargetUsername, Color3.fromRGB(180, 230, 190))
                    else
                        SkinStatus("Модификаторы повторно применены после респавна.", Color3.fromRGB(180, 230, 190))
                    end
                    return
                end
            end
            SkinStatus("Не удалось повторно применить внешний вид после респавна.", Color3.fromRGB(255, 190, 150))
        end)
    end)

    for index = 1, 30 do SkinState.ItemIds[index] = "" end

    SkinState.RefreshModifierButton(SkinState.HeadlessButton, SkinState.Headless, "Headless")
    SkinState.RefreshModifierButton(SkinState.KorbloxButton, SkinState.Korblox, "Korblox")
    SkinState.RefreshModifierButton(SkinState.DeleteHairButton, SkinState.DeleteHair, "Delete hair")
    SkinState.RefreshModifierButton(SkinState.DeleteArmsFPButton, SkinState.DeleteArmsFP, "Delete arms in First Person")
    SkinState.RefreshModifierButton(SkinState.DeleteAccessoriesButton, SkinState.DeleteAccessories, "Delete accessories")
    SkinState.RefreshModifierButton(SkinState.DeleteAllAccessoriesButton, SkinState.DeleteAllAccessories, "Delete all accessories")

    Connect(SkinState.Input.FocusLost, function()
        -- An empty field after loading a saved skin must not wipe that skin.
        if SkinState.ActiveSnapshot and SkinTrim(SkinState.Input.Text) == "" then return end
        SkinApplyUsername(SkinState.Input.Text)
    end)
    if SkinState.ApplyUsernameButton then
        Connect(SkinState.ApplyUsernameButton.MouseButton1Click, function()
            SkinApplyUsername(SkinState.Input and SkinState.Input.Text or "")
        end)
    end
    if SkinState.ResetButton then
        Connect(SkinState.ResetButton.MouseButton1Click, function()
            SkinResetAll()
        end)
    end

    SkinState.RebuildCurrentSkin = function()
        -- Modifiers can be used on the player's current avatar even when no
        -- Skinchanger username has been entered. When no modifier is active
        -- and there is no target username, restore the original character
        -- instead of keeping an unnecessary proxy around.
        local hasCustomItems = SkinHasCustomItems()

        if not SkinState.TargetUserId
            and not SkinState.Headless
            and not SkinState.Korblox
            and not SkinState.DeleteHair
            and not SkinState.DeleteAccessories
            and not SkinState.DeleteAllAccessories
            and not SkinState.DeleteArmsFP
            and (SkinState.SkinColorName == nil or SkinState.SkinColorName == "Default")
            and not hasCustomItems then
            SkinRestoreOriginal()
            return
        end

        if not SkinState.TargetUserId and not hasCustomItems and (SkinState.SkinColorName == nil or SkinState.SkinColorName == "Default") and SkinLooksLikeEvade() then
            SkinState.ApplyToken += 1
            SkinDestroyProxy()
            local rig = SkinResolveSourceCharacter(LocalPlayer.Character, true)
            if rig then
                SkinState.IsEvade = true
                SkinApplyEvadeDirectModifiers(rig)
                SkinWatchEvadeDirectRig(rig)
                SkinStatus("Модификаторы применены к визуальному ригу Evade.", Color3.fromRGB(180, 230, 190))
            end
            return
        end

        SkinClearEvadeDirect()
        SkinState.ApplyToken += 1
        local token = SkinState.ApplyToken
        local targetId = SkinState.TargetUserId or LocalPlayer.UserId
        local targetName = SkinState.TargetUserId and SkinState.TargetUsername or LocalPlayer.Name

        task.spawn(function()
            SkinStatus("Применяю модификаторы...")
            local okBuild, err = SkinBuildProxy(targetId, token)
            if token ~= SkinState.ApplyToken then return end
            if okBuild then
                if SkinState.TargetUserId then
                    SkinStatus("Готово: " .. targetName .. " • source: " .. tostring(SkinState.SourceKind) .. " • items: " .. tostring(#SkinCollectItemIds()), Color3.fromRGB(180, 230, 190))
                else
                    SkinStatus("Модификаторы применены • source: " .. tostring(SkinState.SourceKind) .. " • items: " .. tostring(#SkinCollectItemIds()), Color3.fromRGB(180, 230, 190))
                end
            else
                SkinStatus("Не удалось обновить модификаторы: " .. tostring(err), Color3.fromRGB(255, 170, 170))
            end
        end)
    end

    if SkinState.HeadlessButton then
        Connect(SkinState.HeadlessButton.MouseButton1Click, function()
            SkinState.Headless = not SkinState.Headless
            SkinState.RefreshModifierButton(SkinState.HeadlessButton, SkinState.Headless, "Headless")
            SkinState.RebuildCurrentSkin()
        end)
    end

    if SkinState.KorbloxButton then
        Connect(SkinState.KorbloxButton.MouseButton1Click, function()
